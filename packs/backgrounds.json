                    },
                    {
                        "id":  "bg-noble-0004-0000-4000-8000-000000000004",
                        "name":  "Noble",
                        "type":  "background",
                        "data":  {
                                     "identifier":  "noble",
                                     "description":  "Born to a privileged house, you gain proficiency in History and Persuasion, plus one gaming set and one extra language. You start with fine clothes, a signet ring, a pedigree scroll and a purse of gold. Your feature, Position of Privilege, ensures nobles treat you as a peer and you can easily obtain audiences and basic hospitality among high society.",
