                    {
                        "id":  "bg-soldier-0003-0000-4000-8000-000000000003",
                        "name":  "Soldier",
                        "type":  "background",
                        "data":  {
                                     "identifier":  "soldier",
                                     "description":  "Trained for service, you gain proficiency in Athletics and Intimidation, plus one gaming set and land vehicles. You carry a rank badge, a keepsake taken from a defeated foe, a game set, plain clothes and a small purse of gold. Your Military Rank feature lets you call on allied soldiers for shelter, simple aid and access to military camps.",
