                    {
                        "id":  "bg-criminal-0003-0000-4000-8000-000000000003",
                        "name":  "Criminal",
                        "type":  "background",
                        "data":  {
                                     "identifier":  "criminal",
                                     "description":  "You grew up in an illicit crew, gaining proficiency in Deception and Stealth plus thieves\u0027 tools and one gaming set of your choice. You start with a pry bar, dark common garb, and a coin purse. Feature: Criminal Contact â€” you know a reliable underworld go-between who can discreetly pass messages and arrange minor illicit dealings for you.",
