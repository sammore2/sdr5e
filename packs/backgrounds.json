                    },
                    {
                        "id":  "bg-guildartisan-0002-0000-4000-8000-000000000002",
                        "name":  "Guild Artisan",
                        "type":  "background",
                        "data":  {
                                     "identifier":  "guild-artisan",
                                     "description":  "Trained as a guild craftsperson and trader, you gain proficiency in Insight and Persuasion, plus one set of artisan\u0027s tools and one extra language. You begin with your tools, a guild introduction letter, traveler\u0027s clothes and a modest coin purse. Your feature, Guild Membership, lets you claim lodging, meeting halls and basic aid from your guild and allied guildhalls.",
