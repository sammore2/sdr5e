                    {
                        "id":  "bg-folkhero-0001-0000-4000-8000-000000000001",
                        "name":  "Folk Hero",
                        "type":  "background",
                        "data":  {
                                     "identifier":  "folk-hero",
                                     "description":  "Raised among working villagers, you gain proficiency in Animal Handling and Survival, plus one artisan\u0027s tool and land vehicles. You start with artisan tools, a shovel, an iron pot, common clothes and a small purse of coins. Your feature, Rustic Hospitality, means ordinary folk will offer you food, rest and hiding from authorities when it does not endanger them.",
                                     "weight":  0,
                                     "quantity":  1,
                                     "rarity":  "common",
                                     "isBindOnEquip":  false,
