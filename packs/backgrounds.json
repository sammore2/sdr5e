                    {
                        "id":  "bg-entertainer-0004-0000-4000-8000-000000000004",
                        "name":  "Entertainer",
                        "type":  "background",
                        "data":  {
                                     "identifier":  "entertainer",
                                     "description":  "You earn applause on stage, gaining proficiency in Acrobatics and Performance plus a disguise kit and one musical instrument of your choice. You start with an instrument, a stage costume, a common outfit, and a coin purse. Feature: By Popular Demand â€” where your talent is known, venues offer you free lodging and meals in exchange for nightly performances.",
