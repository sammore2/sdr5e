                    {
                        "id":  "bg-outlander-0001-0000-4000-8000-000000000001",
                        "name":  "Outlander",
                        "type":  "background",
                        "data":  {
                                     "identifier":  "outlander",
                                     "description":  "Raised in the wilds, you gain proficiency in Athletics and Survival, plus one musical instrument and one additional language. You start with a walking staff, a hunting snare, a beast trophy, travel garments and a small purse of gold. Your Wanderer feature lets you reliably locate fresh food and water for your party while traveling in the wilderness.",
                                     "weight":  0,
