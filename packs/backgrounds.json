                    {
                        "id":  "bg-hermit-0003-0000-4000-8000-000000000003",
                        "name":  "Hermit",
                        "type":  "background",
                        "data":  {
                                     "identifier":  "hermit",
                                     "description":  "After years of secluded contemplation, you gain proficiency in Medicine and Religion, plus an herbalism kit and one extra language. You carry a scroll case of studies, a winter blanket, common clothes, an herbalism kit and a few coins. Your feature, Discovery, means you hold a unique secret or revelation that could reshape the world once fully uncovered.",
                                     "weight":  0,
                                     "quantity":  1,
