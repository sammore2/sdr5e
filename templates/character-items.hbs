                                            {{else}}<i class="fas fa-plus"></i>{{/if}}
                                        </div>
                                        <span class="slot-label">{{localize 'THE-CODEX.Inventory.EquipSlots.mainHand'}}</span>
                                    </div>
                                </div>

                                {{!-- ARTE CENTRAL --}}
                                <div class="doll-center-art">
                                    <div class="art-frame-v4 clickable" data-action="editInventoryArt" data-tooltip="{{localize 'THE-CODEX.UI.EditImage'}}">
                                        {{#if system.details.inventoryArt}}
                                        <img src="{{system.details.inventoryArt}}" class="char-inventory-art">
                                        {{else}}
                                        <img src="{{actorImg}}" class="char-inventory-art fallback">
                                        {{/if}}
                                        <div class="art-overlay-v4">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    </div>
                                </div>

                                {{!-- COLUNA DIREITA --}}
                                <div class="doll-column right">
                                    {{!-- Neck --}}
                                    <div class="doll-slot-wrapper slot-neck">
                                        <div class="doll-slot" data-slot="neck" draggable="true" data-tooltip="{{equipped.neck.uuid}}" 
                                            {{#if equipped.neck}}data-action="openItem" data-item-id="{{equipped.neck.id}}"
                                            {{else}}data-action="createItem" data-item-type="item"{{/if}}>
                                            {{#if equipped.neck}}<img src="{{equipped.neck.img}}"><i class="fas fa-times unequip-btn" data-action="unequipItem" data-slot="neck"></i>
                                            {{else}}<i class="fas fa-plus"></i>{{/if}}
                                        </div>
                                        <span class="slot-label">{{localize 'THE-CODEX.Inventory.EquipSlots.neck'}}</span>
