                                        <div class="doll-slot" data-slot="ring2" draggable="true" data-tooltip="{{equipped.ring2.uuid}}" 
                                            {{#if equipped.ring2}}data-action="openItem" data-item-id="{{equipped.ring2.id}}"
                                            {{else}}data-action="createItem" data-item-type="item"{{/if}}>
                                            {{#if equipped.ring2}}<img src="{{equipped.ring2.img}}"><i class="fas fa-times unequip-btn" data-action="unequipItem" data-slot="ring2"></i>
                                            {{else}}<i class="fas fa-plus"></i>{{/if}}
                                        </div>
                                        <span class="slot-label">{{localize 'THE-CODEX.Inventory.EquipSlots.ring2'}}</span>
                                    </div>

                                    {{!-- Feet --}}
                                    <div class="doll-slot-wrapper slot-feet">
                                        <div class="doll-slot" data-slot="feet" draggable="true" data-tooltip="{{equipped.feet.uuid}}" 
                                            {{#if equipped.feet}}data-action="openItem" data-item-id="{{equipped.feet.id}}"
                                            {{else}}data-action="createItem" data-item-type="armor"{{/if}}>
                                            {{#if equipped.feet}}<img src="{{equipped.feet.img}}"><i class="fas fa-times unequip-btn" data-action="unequipItem" data-slot="feet"></i>
                                            {{else}}<i class="fas fa-plus"></i>{{/if}}
                                        </div>
                                        <span class="slot-label">{{localize 'THE-CODEX.Inventory.EquipSlots.feet'}}</span>
