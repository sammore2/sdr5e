                                            {{else}}data-action="createItem" data-item-type="item"{{/if}}>
                                            {{#if equipped.ring1}}<img src="{{equipped.ring1.img}}"><i class="fas fa-times unequip-btn" data-action="unequipItem" data-slot="ring1"></i>
                                            {{else}}<i class="fas fa-plus"></i>{{/if}}
                                        </div>
                                        <span class="slot-label">{{localize 'THE-CODEX.Inventory.EquipSlots.ring1'}}</span>
