                    <div class="inventory-right-column">
                            <div class="backpack-container papiro-bg">
                                <div class="backpack-header-v13">
                                    <h3 class="box-title">{{localize 'THE-CODEX.Inventory.Backpack'}}</h3>
                                    <div class="backpack-controls">
                                        <i class="fas fa-sword" data-action="createItem" data-item-type="weapon"
                                            title="{{localize 'THE-CODEX.Inventory.Create.Weapon'}}"></i>
                                        <i class="fas fa-shield-alt" data-action="createItem" data-item-type="armor"
                                            title="{{localize 'THE-CODEX.Inventory.Create.Armor'}}"></i>
                                        <i class="fas fa-sack" data-action="createItem" data-item-type="item"
                                            title="{{localize 'THE-CODEX.Inventory.Create.Item'}}"></i>
                                    </div>
                                </div>

                                <div class="backpack-grid-codex">
                                    {{#each backpackItems as |item|}}
                                    <div class="backpack-slot codex-rarity-{{item.system.rarity}}"
                                        data-tooltip="{{item.uuid}}" data-item-id="{{item.id}}" data-type="Item"
                                        draggable="true" data-action="openItem">
                                        <img src="{{item.img}}" class="slot-img" style="pointer-events: none;">

                                        <div class="slot-quantity-badge">{{item.system.quantity}}</div>

                                        {{#if item.system.equipped}}
                                        <div class="equipped-badge"><i class="fas fa-check"></i></div>
                                        {{/if}}

                                        {{#if item.system.charges.max}}
                                        <div class="charges-badge">{{item.system.charges.value}} /
                                            {{item.system.charges.max}}</div>
                                        {{/if}}

                                        <div class="slot-actions">
                                            {{#if (or item.system.consumable item.system.charges.max (eq
                                            item.system.category 'potion') (eq item.system.category 'scroll'))}}
                                            <i class="fas {{#if (eq item.system.category 'potion')}}fa-flask{{else if (eq item.system.category 'scroll')}}fa-scroll{{else}}fa-hand-sparkles{{/if}} item-use-btn"
                                                data-action="useItem" data-item-id="{{item.id}}"
                                                title="{{localize 'THE-CODEX.UI.UseItem'}}"></i>
                                            {{/if}}

                                            {{!-- Apenas itens que podem ser equipados --}}
                                            {{#if (or (eq item.system.category 'gear') (eq item.system.category
                                            'wondrous') (eq item.system.category 'wand') (eq item.type 'weapon') (eq
                                            item.type 'armor'))}}
                                            <i class="fas fa-tshirt item-equip-btn" data-action="toggleEquip"
                                                data-item-id="{{item.id}}"
                                                title="{{localize 'THE-CODEX.UI.Equip'}}"></i>
                                            {{/if}}

                                            <i class="fas fa-trash item-delete-btn" data-action="deleteItem"
                                                data-item-id="{{item.id}}"
                                                title="{{localize 'THE-CODEX.UI.Delete'}}"></i>
                                        </div>
                                    </div>
                                    {{/each}}
                                </div>
                            </div>

                            {{!-- Bolsa do Tesouro - Relocada para a lateral --}}
                            <div class="currency-panel-v13 papiro-bg">
                                <h3 class="box-title"><i class="fas fa-coins"></i> {{localize
                                    'THE-CODEX.Sheet.Treasure'}}</h3>
                                <div class="currency-grid-v13">
                                    <div class="coin-group platinum" title="{{localize 'THE-CODEX.Currency.Platinum'}}">
                                        <i class="fas fa-coins"></i>
                                        <input type="number" name="system.details.pp.value" value="{{system.details.pp.value}}"
                                            min="0" data-dtype="Number" onclick="event.stopPropagation()">
                                    </div>
                                    <div class="coin-group gold" title="{{localize 'THE-CODEX.Currency.Gold'}}">
                                        <i class="fas fa-coins"></i>
                                        <input type="number" name="system.details.gp.value" value="{{system.details.gp.value}}"
                                            min="0" data-dtype="Number" onclick="event.stopPropagation()">
                                    </div>
                                    <div class="coin-group silver" title="{{localize 'THE-CODEX.Currency.Silver'}}">
                                        <i class="fas fa-coins"></i>
                                        <input type="number" name="system.details.sp.value" value="{{system.details.sp.value}}"
                                            min="0" data-dtype="Number" onclick="event.stopPropagation()">
                                    </div>
                                    <div class="coin-group copper" title="{{localize 'THE-CODEX.Currency.Copper'}}">
                                        <i class="fas fa-coins"></i>
                                        <input type="number" name="system.details.cp.value" value="{{system.details.cp.value}}"
                                            min="0" data-dtype="Number" onclick="event.stopPropagation()">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>