<div class="form-group-row">
  <div class="form-group">
    <label>{{localize "THE-CODEX.UI.Damage"}}</label>
    <input type="text" name="system.damage.formula" value="{{system.damage.formula}}" placeholder="1d8" />
  </div>
  <div class="form-group">
    <label>{{localize "THE-CODEX.UI.DamageType"}}</label>
    <select name="system.damage.type">
      <option value="">{{localize "THE-CODEX.Sheet.None"}}</option>
      {{selectOptions config.damageTypes selected=system.damage.type localize=true}}
    </select>
  </div>
</div>
<div class="form-group-row">
  <div class="form-group">
    <label>{{localize "THE-CODEX.UI.WeaponGroup"}}</label>
    <select name="system.weaponGroup">
      {{selectOptions config.weaponGroups selected=system.weaponGroup localize=true}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "THE-CODEX.UI.RangeType"}}</label>
    <select name="system.rangeType">
      {{selectOptions config.weaponRanges selected=system.rangeType localize=true}}
    </select>
  </div>
</div>



<div class="form-group">
  <label>{{localize "THE-CODEX.UI.Slot"}}</label>
  <select name="system.primarySlot">
    {{selectOptions config.equipmentSlots selected=system.primarySlot localize=true}}
  </select>
</div>

<div class="form-group">
  <label>{{localize "THE-CODEX.UI.Type"}}</label>
  <select name="system.handlingType">
    {{selectOptions config.handlingTypes selected=system.handlingType localize=true}}
  </select>
</div>

<div class="form-group">
  <label>{{localize "THE-CODEX.UI.AttackBonus"}}</label>
  <input type="number" name="system.attackBonus" value="{{system.attackBonus}}" min="0" />
</div>

<div class="form-group-row"
  style="margin-bottom: 20px; background: rgba(255, 215, 0, 0.05); border-radius: 4px; padding: 5px;">
  <label
    style="display:flex; align-items:center; gap:5px; cursor:pointer; font-weight: bold; color: var(--codex-gold-bright);">
    <input type="checkbox" name="system.magical" {{checked system.magical}} />
    <i class="fas fa-sparkles"></i> {{localize "THE-CODEX.UI.Magical"}}
  </label>
</div>

{{!-- Automação Mágica e Gatilhos (Visível se Mágico ou se for Categoria de Conjuração) --}}
{{#if system.magical}}
<h3 class="form-header"><i class="fas fa-battery-full"></i> {{localize "THE-CODEX.UI.ChargesTitle"}}</h3>
<div class="form-group-row" style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom: 15px;">
  <div class="form-group"><label>{{localize "THE-CODEX.UI.CurrentCharges"}}</label><input type="number"
      name="system.charges.value" value="{{system.charges.value}}" min="0" /></div>
  <div class="form-group"><label>{{localize "THE-CODEX.UI.MaxCharges"}}</label><input type="number"
      name="system.charges.max" value="{{system.charges.max}}" min="0" /></div>
</div>

<h3 class="form-header"><i class="fas fa-wand-magic-sparkles"></i> {{localize "THE-CODEX.ActivationTriggers.Header"}}
</h3>
<div class="sub-section-v13 papiro-bg"
  style="border: 1px solid var(--codex-gold-muted); padding: 10px; margin-top: 5px; margin-bottom: 20px;">
  <p class="hint" style="font-size: 0.75rem; color: #7a6a4a; margin-bottom: 8px; font-style: italic;">
    {{localize "THE-CODEX.SpecialActions.CraftingHint"}}
  </p>

  <div class="form-group-row">
    <div class="form-group">
      <label>{{localize "THE-CODEX.ActivationTriggers.Header"}}</label>
      <select name="system.activationTrigger">
        {{selectOptions config.activationTriggers selected=system.activationTrigger localize=true}}
      </select>
    </div>
    <div class="form-group flex2">
      <label>{{localize "THE-CODEX.Spell.Linked"}}</label>
      <div class="spell-recipe-drop-zone papiro-bg"
        style="border: 1px dashed rgba(66, 135, 245, 0.4); padding: 2px 6px; border-radius: 4px; display: flex; align-items: center; gap: 8px; height: 26px; box-sizing: border-box;">
        <img src="{{system.linkedSpellImg}}" width="20" height="20"
          style="border: 1px solid #4287f5; border-radius: 2px;" />
        <div style="flex: 1; overflow: hidden; display: flex; align-items: center;">
          <input type="text" name="system.linkedSpellUuid" value="{{system.linkedSpellUuid}}"
            placeholder="{{localize 'THE-CODEX.UI.Placehold'}}" readonly
            style="background: transparent; border: none; font-size: 0.75rem; color: #eee; text-overflow: ellipsis; width: 100%; padding: 0; margin: 0; height: 100%; box-shadow: none;" />
        </div>
        {{#if system.linkedSpellUuid}}
        <i class="fas fa-times delete-spell-recipe" style="cursor: pointer; color: #8b0000; font-size: 0.8rem;"
          title="Remover Magia" data-action="removeSpellRecipe" data-target="system.linkedSpellUuid"></i>
        {{else}}
        <i class="fas fa-search open-spell-picker" style="cursor: pointer; color: #4287f5; font-size: 0.8rem;"
          title="Buscar no Compêndio" data-action="openSpellPicker" data-target="system.linkedSpellUuid"></i>
        {{/if}}
      </div>
    </div>
  </div>

  <div class="form-group-row" style="margin-top: 10px;">
    <div class="form-group flex2">
      <label>{{localize "THE-CODEX.Action.MutationType"}}</label>
      <select name="system.mutationType">
        {{selectOptions config.mutationTypes selected=system.mutationType localize=true}}
      </select>
    </div>
  </div>

  {{#if (eq system.mutationType "damage")}}
  <div class="form-group-row"
    style="background: rgba(239, 68, 68, 0.05); padding: 5px; border-radius: 4px; margin-top:5px;">
    <div class="form-group"><label>{{localize "THE-CODEX.Combat.Damage"}}</label><input type="text"
        name="system.magicDamage.formula" value="{{system.magicDamage.formula}}" placeholder="1d6" /></div>
    <div class="form-group">
      <label>{{localize "THE-CODEX.UI.Type"}}</label>
      <select name="system.magicDamage.type">
        {{selectOptions config.damageTypes selected=system.magicDamage.type localize=true}}
      </select>
    </div>
  </div>
  {{/if}}

  {{#if (eq system.mutationType "heal")}}
  <div class="form-group-row"
    style="background: rgba(34, 197, 94, 0.05); padding: 5px; border-radius: 4px; margin-top:5px;">
    <div class="form-group"><label>{{localize "THE-CODEX.Combat.Heal"}}</label><input type="text"
        name="system.healing.formula" value="{{system.healing.formula}}" placeholder="1d8+4" /></div>
  </div>
  {{/if}}
</div>
{{/if}}

<h3 class="form-header">{{localize "THE-CODEX.UI.Properties"}}</h3>
<div class="properties-grid-v13">
  {{#each config.weaponProperties as |label id|}}
  <label class="property-tag-v13">
    <input type="checkbox" name="system.properties" value="{{id}}" {{#if (contains ../system.properties
      id)}}checked{{/if}}>
    <span>{{localize label}}</span>
  </label>
  {{/each}}
</div>

<h3 class="form-header">{{localize "THE-CODEX.UI.Economy"}}</h3>
<div class="form-group-row">
  <div class="form-group">
    <label>{{localize "THE-CODEX.UI.Rarity"}}</label>
    <select name="system.rarity">
      {{selectOptions config.rarity selected=system.rarity localize=true}}
    </select>
  </div>
  <div class="form-group" style="display:flex; align-items:flex-end;">
    <label style="display:flex; align-items:center; gap:5px; cursor:pointer;">
      <input type="checkbox" name="system.isBindOnEquip" {{checked system.isBindOnEquip}} />
      {{localize "THE-CODEX.UI.BindOnEquip"}}
    </label>
  </div>
</div>
<div class="form-group-row">
  <div class="form-group">
    <label>{{localize "THE-CODEX.UI.Weight"}} (kg)</label>
    <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1" />
  </div>
</div>
<div class="form-group-row" style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px;">
  <div class="form-group"><label>{{localize "THE-CODEX.UI.Gold"}}</label><input type="number" name="system.price.gp"
      value="{{system.price.gp}}" min="0" /></div>
  <div class="form-group"><label>{{localize "THE-CODEX.UI.Silver"}}</label><input type="number" name="system.price.sp"
      value="{{system.price.sp}}" min="0" /></div>
  <div class="form-group"><label>{{localize "THE-CODEX.UI.Copper"}}</label><input type="number" name="system.price.cp"
      value="{{system.price.cp}}" min="0" /></div>
</div>

{{!-- {{localize "THE-CODEX.UI.BonusCombatAttributes"}} (Para armas mágicas) --}}
<h3 class="form-header">{{localize "THE-CODEX.UI.CombatBonuses"}}</h3>
<div class="automation-grid-v13" style="grid-template-columns: 1fr 1fr; gap: 10px; align-items: start;">
  {{!-- 1. Bloco de Atributos --}}
  <div class="automation-section papiro-bg">
    <label class="section-title"><i class="fas fa-brain"></i> {{localize "THE-CODEX.UI.Abilities"}}</label>
    <div class="bonuses-grid-v13" style="grid-template-columns: repeat(3, 1fr); gap: 5px;">
      <div class="bonus-item"><label>{{localize "THE-CODEX.Abilities.str"}}</label><input type="number"
          name="system.bonuses.abilities.str" value="{{system.bonuses.abilities.str}}" placeholder="0" /></div>
      <div class="bonus-item"><label>{{localize "THE-CODEX.Abilities.dex"}}</label><input type="number"
          name="system.bonuses.abilities.dex" value="{{system.bonuses.abilities.dex}}" placeholder="0" /></div>
      <div class="bonus-item"><label>{{localize "THE-CODEX.Abilities.con"}}</label><input type="number"
          name="system.bonuses.abilities.con" value="{{system.bonuses.abilities.con}}" placeholder="0" /></div>
      <div class="bonus-item"><label>{{localize "THE-CODEX.Abilities.int"}}</label><input type="number"
          name="system.bonuses.abilities.int" value="{{system.bonuses.abilities.int}}" placeholder="0" /></div>
      <div class="bonus-item"><label>{{localize "THE-CODEX.Abilities.wis"}}</label><input type="number"
          name="system.bonuses.abilities.wis" value="{{system.bonuses.abilities.wis}}" placeholder="0" /></div>
      <div class="bonus-item"><label>{{localize "THE-CODEX.Abilities.cha"}}</label><input type="number"
          name="system.bonuses.abilities.cha" value="{{system.bonuses.abilities.cha}}" placeholder="0" /></div>
    </div>
  </div>
  {{!-- 2. Bloco de Combate --}}
  <div class="automation-section papiro-bg">
    <label class="section-title"><i class="fas fa-swords"></i> {{localize "THE-CODEX.Sheet.Saves"}}</label>
    <div class="bonuses-grid-v13" style="grid-template-columns: 1fr 1fr 1fr; gap: 5px;">
      <div class="bonus-item" title="{{localize 'THE-CODEX.Abilities.str'}}"><label>{{localize
          "THE-CODEX.Abilities.str"}}
          (S)</label><input type="number" name="system.bonuses.saves.str" value="{{system.bonuses.saves.str}}"
          placeholder="0" /></div>
      <div class="bonus-item" title="{{localize 'THE-CODEX.Abilities.dex'}}"><label>{{localize
          "THE-CODEX.Abilities.dex"}}
          (S)</label><input type="number" name="system.bonuses.saves.dex" value="{{system.bonuses.saves.dex}}"
          placeholder="0" /></div>
      <div class="bonus-item" title="{{localize 'THE-CODEX.Abilities.con'}}"><label>{{localize
          "THE-CODEX.Abilities.con"}}
          (S)</label><input type="number" name="system.bonuses.saves.con" value="{{system.bonuses.saves.con}}"
          placeholder="0" /></div>
      <div class="bonus-item" title="{{localize 'THE-CODEX.Abilities.int'}}"><label>{{localize
          "THE-CODEX.Abilities.int"}}
          (S)</label><input type="number" name="system.bonuses.saves.int" value="{{system.bonuses.saves.int}}"
          placeholder="0" /></div>
      <div class="bonus-item" title="{{localize 'THE-CODEX.Abilities.wis'}}"><label>{{localize
          "THE-CODEX.Abilities.wis"}}
          (S)</label><input type="number" name="system.bonuses.saves.wis" value="{{system.bonuses.saves.wis}}"
          placeholder="0" /></div>
      <div class="bonus-item" title="{{localize 'THE-CODEX.Abilities.cha'}}"><label>{{localize
          "THE-CODEX.Abilities.cha"}}
          (S)</label><input type="number" name="system.bonuses.saves.cha" value="{{system.bonuses.saves.cha}}"
          placeholder="0" /></div>
      <div class="bonus-item"><label>{{localize "THE-CODEX.UI.DefenseShort"}}</label><input type="number"
          name="system.bonuses.da" value="{{system.bonuses.da}}" placeholder="0" /></div>
      <div class="bonus-item"><label>{{localize "THE-CODEX.UI.SpellDCShort"}}</label><input type="number"
          name="system.bonuses.spellDC" value="{{system.bonuses.spellDC}}" placeholder="0" /></div>
    </div>
  </div>
</div>


<style>
  .properties-grid-v13 {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 5px;
    background: rgba(0, 0, 0, 0.1);
    padding: 8px;
    border-radius: 4px;
  }

  .property-tag-v13 {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.85em;
    padding: 2px 5px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .property-tag-v13:hover {
    background: rgba(255, 255, 255, 0.05);
  }
</style>