<div class="effects-tab papiro-bg" style="padding: 10px;">
    <div class="section-header-v13" style="margin-bottom: 15px;">
        <label class="section-title"><i class="fas fa-wand-sparkles"></i> {{localize "THE-CODEX.UI.ActiveEffects"}}</label>
        <button type="button" class="icon-button-v13" data-action="createEffect" title="{{localize 'THE-CODEX.UI.AddEffect'}}">
            <i class="fas fa-plus"></i>
        </button>
    </div>

    <ul class="effects-list-v13" style="list-style: none; padding: 0; margin: 0;">
        {{#each effects as |effect|}}
        <li class="effect-row-v13" data-effect-id="{{effect.id}}" 
            style="display: flex; align-items: center; gap: 10px; background: rgba(0,0,0,0.1); margin-bottom: 5px; padding: 5px 10px; border-radius: 4px; border: 1px solid rgba(212,175,55,0.2);">
            <img class="effect-img" src="{{effect.img}}" width="32" height="32" style="border: 1px solid var(--codex-gold-muted); border-radius: 3px;" />
            
            <div class="effect-name" style="flex: 1; font-weight: bold; color: var(--codex-gold);">
                {{effect.name}}
                {{#if effect.disabled}}<span style="font-size: 0.7rem; opacity: 0.5; font-style: italic;">(Desativado)</span>{{/if}}
            </div>

            <div class="effect-actions" style="display: flex; gap: 5px;">
                <button type="button" class="icon-button-v13" data-action="toggleEffect" title="{{#if effect.disabled}}Ativar{{else}}Desativar{{/if}}">
                    <i class="fas {{#if effect.disabled}}fa-check{{else}}fa-times{{/if}}"></i>
                </button>
                <button type="button" class="icon-button-v13" data-action="editEffect" title="Editar">
                    <i class="fas fa-edit"></i>
                </button>
                <button type="button" class="icon-button-v13 inv-delete" data-action="deleteEffect" title="Excluir">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </li>
        {{else}}
        <li class="hint" style="text-align: center; padding: 20px; opacity: 0.6; font-style: italic;">
            {{localize "THE-CODEX.UI.NoEffects"}}
        </li>
        {{/each}}
    </ul>
</div>
