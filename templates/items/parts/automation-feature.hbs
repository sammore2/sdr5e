<div class="automation-grid-v13 papiro-bg">
    {{!-- 1. GATILHOS E ENTREGA --}}
    <div class="automation-section papiro-bg" style="border-bottom: 1px solid var(--codex-gold-muted); padding-bottom: 15px;">
        <label class="section-title"><i class="fas fa-bolt"></i> Gatilhos de Combate {{#if system.activationTrigger}}<span class="badge" style="background: var(--codex-gold); color: #000; font-size: 0.6rem; padding: 1px 4px; border-radius: 3px; margin-left: 5px;">{{system.activationTrigger}}</span>{{/if}}</label>
        <div class="form-group-row">
            <div class="form-group">
                <label>Gatilho (Trigger)</label>
                <select name="system.activationTrigger">
                    {{selectOptions config.activationTriggers selected=system.activationTrigger localize=true}}
                </select>
            </div>
            <div class="form-group flex2">
                <label>Entrega (Delivery)</label>
                <select name="system.delivery">
                    {{selectOptions config.spellDelivery selected=system.delivery localize=true}}
                </select>
            </div>
        </div>
        <div class="form-group-row" style="margin-top: 10px;">
            <div class="form-group">
                <label>Alcance (Range)</label>
                <div class="input-with-units">
                    <input type="number" name="system.range.value" value="{{system.range.value}}" placeholder="0" />
                    <select name="system.range.units">
                        {{selectOptions config.rangeUnits selected=system.range.units localize=true}}
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label>Duração</label>
                <div class="input-with-units">
                    <input type="number" name="system.duration.value" value="{{system.duration.value}}" placeholder="0" />
                    <select name="system.duration.units">
                        {{selectOptions config.durationUnits selected=system.duration.units localize=true}}
                    </select>
                </div>
            </div>
        </div>
    </div>

    {{!-- 2. MOTOR DE MUTAÇÕES (CODEX FLOW) - NOVA UI SIMPLIFICADA --}}
    <div class="automation-section papiro-bg" style="border: 2px solid var(--codex-gold); background: rgba(204, 164, 96, 0.05); margin-top: 15px; border-radius: 8px; padding: 12px;">
        <div class="section-header-v13">
            <label class="section-title" style="color: var(--codex-gold); font-weight: bold; text-shadow: 1px 1px 2px #000;">
                <i class="fas fa-microchip"></i> MOTOR DE MUTAÇÕES DINÂMICAS
            </label>
            <button type="button" class="codex-btn-v13" data-action="addFlowMutation" style="height: 24px; padding: 0 10px; font-size: 0.7rem;">
                <i class="fas fa-plus"></i> ADICIONAR REGRA
            </button>
        </div>
        <p class="hint" style="font-size: 0.7rem; color: var(--codex-gold-muted); margin-bottom: 12px; font-style: italic;">
            Configure bônus que mudam automaticamente com o nível ou condições.
        </p>

        <div class="flow-mutations-list">
            {{#each system.flowMutations as |mut idx|}}
            <div class="mutation-box" data-index="{{idx}}" style="background: rgba(0,0,0,0.3); border: 1px solid var(--codex-gold-muted); border-radius: 5px; padding: 10px; margin-bottom: 10px; position: relative;">
                <button type="button" class="icon-button-v13 inv-delete" data-action="deleteFlowMutation" style="position: absolute; top: 5px; right: 5px;" title="Remover">
                    <i class="fas fa-trash"></i>
                </button>
                
                {{!-- Linha 1: Alvo e Valor Base --}}
                <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 8px;">
                    <div style="flex: 1;">
                        <label style="font-size: 0.65rem; color: var(--codex-gold); text-transform: uppercase;">Afetar Atributo/Rolagem</label>
                        <select name="system.flowMutations.{{idx}}.target" style="width: 100%; height: 26px;">
                            {{selectOptions @root.config.mutationTargets selected=mut.target localize=true}}
                        </select>
                    </div>
                    <div style="flex: 1;">
                        <label style="font-size: 0.65rem; color: var(--codex-gold); text-transform: uppercase;">Valor Base (Ex: 1d6, 2)</label>
                        <input type="text" name="system.flowMutations.{{idx}}.value" value="{{mut.value}}" placeholder="0" style="width: 100%; height: 26px; text-align: center; font-weight: bold; color: var(--codex-gold);" />
                    </div>
                </div>

                {{!-- Linha 2: Escalonamento (UX Friendly) --}}
                <div style="display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 8px; border-top: 1px solid rgba(212,175,55,0.1); padding-top: 8px;">
                    <div>
                        <label style="font-size: 0.6rem; opacity: 0.7;">Escalonar Por</label>
                        <select name="system.flowMutations.{{idx}}.scaling.mode" style="width: 100%; height: 22px; font-size: 0.7rem;">
                            <option value="none">Fixo (Não Escala)</option>
                            <option value="classFreq" {{#if (eq mut.scaling.mode "classFreq")}}selected{{/if}}>Nível da Classe</option>
                            <option value="levelFreq" {{#if (eq mut.scaling.mode "levelFreq")}}selected{{/if}}>Nível Total</option>
                        </select>
                    </div>
                    {{#if (ne mut.scaling.mode "none")}}
                    <div>
                        <label style="font-size: 0.6rem; opacity: 0.7;">A cada X Níveis</label>
                        <input type="number" name="system.flowMutations.{{idx}}.scaling.frequency" value="{{mut.scaling.frequency}}" placeholder="1" style="width: 100%; height: 22px; text-align: center;" />
                    </div>
                    <div>
                        <label style="font-size: 0.6rem; opacity: 0.7;">Aumento</label>
                        <input type="text" name="system.flowMutations.{{idx}}.scaling.formula" value="{{mut.scaling.formula}}" placeholder="+1d6" style="width: 100%; height: 22px; text-align: center; color: var(--codex-gold);" />
                    </div>
                    {{/if}}
                </div>
            </div>
            {{else}}
            <div style="text-align: center; padding: 20px; border: 1px dashed var(--codex-gold-muted); opacity: 0.5;">
                <i class="fas fa-ghost fa-2x" style="margin-bottom: 10px; display: block;"></i>
                Nenhuma automação dinâmica configurada.
            </div>
            {{/each}}
        </div>
    </div>

    {{!-- 3. AÇÕES ESPECIAIS E CRAFTING --}}
    <div class="automation-section papiro-bg" style="margin-top: 15px; border-top: 1px dashed var(--codex-gold-muted); padding-top: 15px;">
         <label class="section-title"><i class="fas fa-hammer"></i> Lógicas de Crafting e Ações Especiais</label>
         <div class="form-group-row">
            <div class="form-group flex2">
                <label>Lógica de Execução</label>
                <select name="system.specialAction">
                    {{selectOptions config.specialActions selected=system.specialAction localize=true}}
                </select>
            </div>
            {{#if (and (ne system.specialAction "none") (ne system.specialAction ""))}}
            <button type="button" class="codex-btn-v13 craft-execute-btn" data-action="executeSpecialAction" style="align-self: flex-end; margin-bottom: 2px;">
                <i class="fas fa-magic"></i> Testar Execução
            </button>
            {{/if}}
        </div>
        
        {{#if (and (ne system.specialAction "none") (ne system.specialAction ""))}}
        <div class="sub-section-v13" style="background:rgba(215,174,72,0.05); border: 1px dashed var(--codex-gold-muted); margin-top:5px; padding: 10px; border-radius: 4px;">
            <label class="sub-title"><i class="fas fa-coins"></i> Custos e Vínculos</label>
            <div class="form-group-row">
                <div class="form-group">
                    <label>Preço (gp)</label>
                    <input type="number" name="system.craftingCost.gpCost" value="{{system.craftingCost.gpCost}}" min="0" />
                </div>
                <div class="form-group flex2">
                    <label>Item Consumível</label>
                    <input type="text" name="system.craftingCost.requiredItem" value="{{system.craftingCost.requiredItem}}" placeholder="Ex: Papiro" />
                </div>
            </div>
        </div>
        {{/if}}
    </div>

    {{!-- 4. FLAGS AVANÇADAS --}}
    <div class="automation-section papiro-bg" style="margin-top: 15px; background: rgba(0,0,0,0.1); padding: 10px; border-radius: 4px;">
        <label class="section-title"><i class="fas fa-gears"></i> Parâmetros Técnicos Avançados</label>
        <div class="checkbox-group row" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;">
            <label><input type="checkbox" name="system.meta.isMetamagic" {{checked system.meta.isMetamagic}} /> {{localize 'THE-CODEX.FeatureAutomation.IsMetamagic'}}</label>
            <label><input type="checkbox" name="system.bonuses.crit.modifiesCrit" {{checked system.bonuses.crit.modifiesCrit}} /> {{localize 'THE-CODEX.FeatureAutomation.ModifiesCrit'}}</label>
            <label><input type="checkbox" name="system.flags.isTWF" {{checked system.flags.isTWF}} /> Combate com Duas Armas (TWF)</label>
            <label><input type="checkbox" name="system.flags.isFinesse" {{checked system.flags.isFinesse}} /> Atributo Mental para Armas (Brawl)</label>
        </div>
    </div>
</div>
