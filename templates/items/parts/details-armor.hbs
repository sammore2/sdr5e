<div class="form-group-row">
  <div class="form-group">
    <label>{{localize "THE-CODEX.UI.BonusAC"}}</label>
    <input type="number" name="system.acValue" value="{{system.acValue}}" min="0" {{#if (eq system.armorType "none")}}disabled{{/if}}/>
  </div>
  <div class="form-group">
    <label>{{localize "THE-CODEX.UI.ArmorType"}}</label>
    <select name="system.armorType">
      {{selectOptions config.armorTypes selected=system.armorType localize=true}}
    </select>
  </div>
</div>

<div class="form-group">
  <label>{{localize "THE-CODEX.UI.EquipSlot"}}</label>
  <select name="system.primarySlot">
    {{selectOptions config.equipmentSlots selected=system.primarySlot localize=true}}
  </select>
</div>

<h3 class="form-header">{{localize "THE-CODEX.UI.Economy"}}</h3>
<div class="form-group-row">
  <div class="form-group">
    <label>{{localize "THE-CODEX.UI.Rarity"}}</label>
    <select name="system.rarity">
      {{selectOptions config.rarity selected=system.rarity localize=true}}
    </select>
  </div>
  <div class="form-group" style="display:flex; align-items:flex-end;">
    <label style="display:flex; align-items:center; gap:5px; cursor:pointer;">
      <input type="checkbox" name="system.isBindOnEquip" {{#if system.isBindOnEquip}}checked{{/if}}/>
      {{localize "THE-CODEX.UI.BindOnEquip"}}
    </label>
  </div>
</div>
<div class="form-group-row">
  <div class="form-group">
    <label>{{localize "THE-CODEX.UI.WeightKg"}}</label>
    <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1"/>
  </div>
</div>
<div class="form-group-row" style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px;">
  <div class="form-group"><label>{{localize "THE-CODEX.UI.GoldAbbr"}}</label><input type="number" name="system.price.gp" value="{{system.price.gp}}" min="0"/></div>
  <div class="form-group"><label>{{localize "THE-CODEX.UI.SilverAbbr"}}</label><input type="number" name="system.price.sp" value="{{system.price.sp}}" min="0"/></div>
  <div class="form-group"><label>{{localize "THE-CODEX.UI.CopperAbbr"}}</label><input type="number" name="system.price.cp" value="{{system.price.cp}}" min="0"/></div>
</div>

{{!-- {{localize "THE-CODEX.UI.BonusCombatAttributes"}} (Para armaduras mágicas) --}}
<h3 class="form-header">{{localize "THE-CODEX.UI.BonusCombatAttributes"}}</h3>
<div class="automation-grid-v13" style="grid-template-columns: 1fr 1fr; gap: 10px;">
    {{!-- 1. Bloco de Atributos --}}
    <div class="automation-section papiro-bg">
        <label class="section-title"><i class="fas fa-brain"></i> {{localize "THE-CODEX.Sheet.Abilities"}}</label>
        <div class="bonuses-grid-v13" style="grid-template-columns: repeat(3, 1fr); gap: 5px;">
            <div class="bonus-item"><label>{{localize "THE-CODEX.Abilities.str"}}</label><input type="number" name="system.bonuses.abilities.str" value="{{system.bonuses.abilities.str}}" placeholder="0"/></div>
            <div class="bonus-item"><label>{{localize "THE-CODEX.Abilities.dex"}}</label><input type="number" name="system.bonuses.abilities.dex" value="{{system.bonuses.abilities.dex}}" placeholder="0"/></div>
            <div class="bonus-item"><label>{{localize "THE-CODEX.Abilities.con"}}</label><input type="number" name="system.bonuses.abilities.con" value="{{system.bonuses.abilities.con}}" placeholder="0"/></div>
            <div class="bonus-item"><label>{{localize "THE-CODEX.Abilities.int"}}</label><input type="number" name="system.bonuses.abilities.int" value="{{system.bonuses.abilities.int}}" placeholder="0"/></div>
            <div class="bonus-item"><label>{{localize "THE-CODEX.Abilities.wis"}}</label><input type="number" name="system.bonuses.abilities.wis" value="{{system.bonuses.abilities.wis}}" placeholder="0"/></div>
            <div class="bonus-item"><label>{{localize "THE-CODEX.Abilities.cha"}}</label><input type="number" name="system.bonuses.abilities.cha" value="{{system.bonuses.abilities.cha}}" placeholder="0"/></div>
        </div>
    </div>
    {{!-- 2. Bloco de Combate --}}
    <div class="automation-section papiro-bg">
        <label class="section-title"><i class="fas fa-swords"></i> {{localize "THE-CODEX.FeatureFields.CombatSaves"}}</label>
        <div class="bonuses-grid-v13" style="grid-template-columns: 1fr 1fr 1fr; gap: 5px;">
            <div class="bonus-item" title="{{localize "THE-CODEX.FeatureFields.SaveStr"}}"><label>{{localize "THE-CODEX.FeatureFields.SaveStr"}}</label><input type="number" name="system.bonuses.saves.str" value="{{system.bonuses.saves.str}}" placeholder="0"/></div>
            <div class="bonus-item" title="{{localize "THE-CODEX.FeatureFields.SaveDex"}}"><label>{{localize "THE-CODEX.FeatureFields.SaveDex"}}</label><input type="number" name="system.bonuses.saves.dex" value="{{system.bonuses.saves.dex}}" placeholder="0"/></div>
            <div class="bonus-item" title="{{localize "THE-CODEX.FeatureFields.SaveCon"}}"><label>{{localize "THE-CODEX.FeatureFields.SaveCon"}}</label><input type="number" name="system.bonuses.saves.con" value="{{system.bonuses.saves.con}}" placeholder="0"/></div>
            <div class="bonus-item" title="{{localize "THE-CODEX.FeatureFields.SaveInt"}}"><label>{{localize "THE-CODEX.FeatureFields.SaveInt"}}</label><input type="number" name="system.bonuses.saves.int" value="{{system.bonuses.saves.int}}" placeholder="0"/></div>
            <div class="bonus-item" title="{{localize "THE-CODEX.FeatureFields.SaveWis"}}"><label>{{localize "THE-CODEX.FeatureFields.SaveWis"}}</label><input type="number" name="system.bonuses.saves.wis" value="{{system.bonuses.saves.wis}}" placeholder="0"/></div>
            <div class="bonus-item" title="{{localize "THE-CODEX.FeatureFields.SaveCha"}}"><label>{{localize "THE-CODEX.FeatureFields.SaveCha"}}</label><input type="number" name="system.bonuses.saves.cha" value="{{system.bonuses.saves.cha}}" placeholder="0"/></div>
            <div class="bonus-item"><label>{{localize "THE-CODEX.UI.DefenseActive"}}</label><input type="number" name="system.bonuses.da" value="{{system.bonuses.da}}" placeholder="0"/></div>
            <div class="bonus-item"><label>{{localize "THE-CODEX.UI.SpellDCBonus"}}</label><input type="number" name="system.bonuses.spellDC" value="{{system.bonuses.spellDC}}" placeholder="0"/></div>
        </div>
    </div>
</div>
