{{!-- d:\modules\system\the-codex-modern\templates\items\parts\details-spell.hbs --}}
<div class="form-group-row">
  <div class="form-group">
    <label>{{localize 'THE-CODEX.SpellFields.School'}}</label>
    <select name="system.school">
      {{selectOptions config.spellSchools selected=system.school localize=true}}
    </select>
  </div>

  <div class="form-group">
    <label>{{localize 'THE-CODEX.Spell.Type'}}</label>
    <select name="system.spellType">
      <option value="arcane" {{#if (eq system.spellType "arcane" )}}selected{{/if}}>{{localize
        'THE-CODEX.Spell.Arcane'}}</option>
      <option value="divine" {{#if (eq system.spellType "divine" )}}selected{{/if}}>{{localize
        'THE-CODEX.Spell.Divine'}}</option>
    </select>
  </div>

  <div class="form-group">
    <div class="checkbox-group row">
      <label><input type="checkbox" name="system.ritual" {{checked system.ritual}} /> {{localize
        'THE-CODEX.SpellFields.Ritual'}}</label>
      <label><input type="checkbox" name="system.concentration" {{checked system.concentration}} /> {{localize
        'THE-CODEX.SpellFields.Concentration'}}</label>
    </div>
  </div>
</div>

<div class="form-group-row">
  <div class="form-group flex3">
    <label>{{localize 'THE-CODEX.Spell.Domains'}}</label>
    <input type="text" name="system.domains" value="{{system.domains}}" placeholder="{{localize 'THE-CODEX.UI.Placeholders.Domains'}}" />
  </div>
</div>

<div class="form-group-row">
  <div class="form-group">
    <label>{{localize 'THE-CODEX.SpellFields.Range'}}</label>
    <div class="input-with-units">
      <input type="number" name="system.range.value" value="{{system.range.value}}" />
      <select name="system.range.units">
        {{selectOptions config.rangeUnits selected=system.range.units localize=true}}
      </select>
    </div>
  </div>
  <div class="form-group">
    <label>{{localize 'THE-CODEX.SpellFields.Duration'}}</label>
    <div class="input-with-units">
      <input type="number" name="system.duration.value" value="{{system.duration.value}}" />
      <select name="system.duration.units">
        {{selectOptions config.durationUnits selected=system.duration.units localize=true}}
      </select>
    </div>
  </div>
</div>

<div class="form-group-row">
  <div class="form-group">
    <label>{{localize 'THE-CODEX.SpellFields.Components'}}</label>
    <div class="checkbox-group row">
      <label><input type="checkbox" name="system.components.v" {{checked system.components.v}} /> V</label>
      <label><input type="checkbox" name="system.components.s" {{checked system.components.s}} /> S</label>
      <label><input type="checkbox" name="system.components.m" {{checked system.components.m}} /> M</label>
    </div>
  </div>
  {{#if system.components.m}}
  <div class="form-group flex3">
    <label>{{localize 'THE-CODEX.SpellFields.Material'}}</label>
    <input type="text" name="system.components.material" value="{{system.components.material}}"
      placeholder="Custo/Material..." />
  </div>
  {{/if}}
</div>

<div class="stats-papiro-grid">
  <div class="stat-badge highlight" data-tooltip="{{system.spellDCBreakdown}}">
    <label>{{localize 'THE-CODEX.SpellFields.DC'}}</label>
    <span class="val">{{system.spellDC}}</span>
  </div>
</div>

{{!-- Vínculos de Classe (Agnóstico) --}}
<div class="class-mapping-section papiro-bg"
    style="margin-top: 15px; border-top: 1px solid rgba(212,175,55,0.2); padding-top: 10px;">
    <label class="section-title"><i class="fas fa-link"></i> {{localize
        'THE-CODEX.FeatureFields.ClassMapping'}}</label>
    <p class="hint" style="font-size: 0.7rem; margin-bottom: 8px;">{{localize
        'THE-CODEX.FeatureFields.ClassMappingHint'}}</p>

    <div class="class-mapping-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 5px;">
        {{#each spellClasses as |cls|}}
        <div class="class-mapping-item"
            style="display: flex; align-items: center; justify-content: space-between; background: rgba(0,0,0,0.1); padding: 4px 8px; border-radius: 3px;">
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; flex: 1;">
                <input type="checkbox" data-action="toggleClassMapping" data-class-id="{{cls.id}}" {{checked
                    cls.checked}} />
                <span
                    style="font-size: 0.85rem; {{#if cls.checked}}color: var(--codex-gold); font-weight: bold;{{/if}}">{{cls.label}}</span>
            </label>
            {{#if cls.checked}}
            <div class="mapping-circle" style="display: flex; align-items: center; gap: 4px;">
                <span style="font-size: 0.65rem; opacity: 0.7;">CIRC:</span>
                <input type="number" data-action="changeMappingLevel" data-class-id="{{cls.id}}"
                    value="{{cls.level}}"
                    style="width: 35px; height: 18px; font-size: 0.75rem; text-align: center;" />
            </div>
            {{/if}}
        </div>
        {{/each}}
    </div>
</div>