<div class="form-group-row">
    <div class="form-group">
        <label>{{localize "THE-CODEX.HP"}}</label>
        <input type="number" name="system.hitDice" value="{{system.hitDice}}" data-dtype="Number" />
    </div>
    <div class="form-group">
        <label>{{localize "THE-CODEX.Sheet.Level"}}</label>
        <input type="number" name="system.levels" value="{{system.levels}}" data-dtype="Number" />
    </div>
</div>

<div class="form-group prof-config-v13">
    <h3 class="prof-section-title">{{localize "THE-CODEX.UI.WeaponProficiencies"}}</h3>
    <div class="weapon-prof-grid">
        {{#each @root.config.weaponGroups as |label w|}}
        <div class="prof-item">
            <label>{{localize label}}</label>
            <input type="checkbox" name="system.weaponProficiencies" value="{{w}}" 
                {{#if (or (contains ../system.weaponProficiencies w) 
                         (and (contains "dagger quarterstaff light-crossbow sling dart unarmed" w) (contains ../system.weaponProficiencies "simple"))
                         (and (contains "shortsword blades axes hams spears bows crossbows firearms monastic" w) (contains ../system.weaponProficiencies "martial"))
                         (and (eq w "simple") (contains ../system.weaponProficiencies "simple"))
                         (and (eq w "martial") (contains ../system.weaponProficiencies "martial"))
                    )}}checked{{/if}}>
        </div>
        {{/each}}
    </div>

    <h3 class="prof-section-title">{{localize "THE-CODEX.UI.ArmorProficiencies"}}</h3>
    <div class="armor-prof-grid">
        {{#each @root.config.armorTypes as |label a|}}
        <div class="prof-item">
            <label>{{localize label}}</label>
            <input type="checkbox" name="system.armorProficiencies" value="{{a}}" 
                {{#if (contains ../system.armorProficiencies a)}}checked{{/if}}>
        </div>
        {{/each}}
    </div>
</div>

<div class="form-group">
    <label>{{localize "THE-CODEX.Sheet.PrimaryAbilities"}}</label>
    <div class="checkbox-grid">
        {{#each config.abilities as |name key|}}
        <div class="checkbox-item">
            <label>{{localize name}}</label>
            <input type="checkbox" name="system.primaryAbilities" value="{{key}}" {{#if (contains ../system.primaryAbilities key)}}checked{{/if}} />
        </div>
        {{/each}}
    </div>
</div>

<div class="form-group">
    <label>{{localize "THE-CODEX.UI.TrainedSaves"}}</label>
    <div class="checkbox-grid">
        {{#each config.abilities as |name key|}}
        <div class="checkbox-item">
            <label>{{localize name}}</label>
            <input type="checkbox" name="system.savingThrows" value="{{key}}" {{#if (contains ../system.savingThrows key)}}checked{{/if}} />
        </div>
        {{/each}}
    </div>
</div>

<div class="spellcasting-config papiro-bg" style="margin-top: 10px; padding: 15px; border: 1px solid #7a6a4a;">
    <h3 class="form-header"><i class="fas fa-magic"></i> {{localize "THE-CODEX.Sheet.Spellcasting"}}</h3>

    <div class="form-group-row">
        <div class="form-group">
            <label>{{localize "THE-CODEX.Sheet.ProgressionRate"}}</label>
            <select name="system.category">
                <option value="martial" {{#if (eq system.category "martial" )}}selected{{/if}}>{{localize "THE-CODEX.Sheet.ProgRate.None"}}</option>
                <option value="invoker" {{#if (eq system.category "invoker" )}}selected{{/if}}>{{localize "THE-CODEX.Sheet.CasterTypeLabel.Invocation"}}</option>
                <option value="half" {{#if (eq system.category "half" )}}selected{{/if}}>{{localize "THE-CODEX.Sheet.ProgRate.Half"}}</option>
                <option value="caster" {{#if (eq system.category "caster" )}}selected{{/if}}>{{localize "THE-CODEX.Sheet.ProgRate.Full"}}</option>
            </select>
        </div>
        {{#unless (eq system.category "martial")}}
        <div class="form-group">
            <label>{{localize "THE-CODEX.Sheet.CastingAttribute"}}</label>
            <select name="system.spellcastingAbility">
                {{selectOptions config.abilities selected=system.spellcastingAbility localize=true}}
            </select>
        </div>
        <div class="form-group">
            <label>{{localize "THE-CODEX.UI.BonusSpells"}}</label>
            <input type="checkbox" name="system.hasBonusSlots" {{checked system.hasBonusSlots}} />
            <p class="hint">{{localize "THE-CODEX.UI.BonusByAttribute"}}</p>
        </div>
        {{/unless}}
    </div>

    {{#unless (eq system.category "martial")}}
    <div class="form-group-row" style="margin-top: 10px; border-top: 1px hide #444; padding-top: 10px;">
        <div class="form-group">
            <label>{{localize "THE-CODEX.UI.Architecture"}}</label>
            <select name="system.architecture">
                <option value="vancian" {{#if (eq system.architecture "vancian" )}}selected{{/if}}>{{localize "THE-CODEX.UI.ArchVancian"}}</option>
                <option value="pact" {{#if (eq system.architecture "pact" )}}selected{{/if}}>{{localize "THE-CODEX.UI.ArchPact"}}</option>
                <option value="point" {{#if (eq system.architecture "point" )}}selected{{/if}}>{{localize "THE-CODEX.UI.ArchPoint"}}</option>
                <option value="bond" {{#if (eq system.architecture "bond" )}}selected{{/if}}>{{localize "THE-CODEX.UI.ArchBond"}}</option>
            </select>
        </div>
    </div>

    <div class="form-group-row" style="margin-top: 10px; border-top: 1px dotted #7a6a4a; padding-top: 10px;">
        <div class="form-group">
            <label>{{localize "THE-CODEX.UI.ResourceName"}}</label>
            <input type="text" name="system.classResourceLabel" value="{{system.classResourceLabel}}" placeholder="{{localize "THE-CODEX.UI.ResourcePlaceholder"}}" />
        </div>
        <div class="form-group">
            <label>{{localize "THE-CODEX.UI.ResourceReset"}}</label>
            <select name="system.classResourceReset">
                <option value="long" {{#if (eq system.classResourceReset "long" )}}selected{{/if}}>{{localize "THE-CODEX.UI.ResetLong"}}</option>
                <option value="short" {{#if (eq system.classResourceReset "short" )}}selected{{/if}}>{{localize "THE-CODEX.UI.ResetShort"}}</option>
                <option value="none" {{#if (eq system.classResourceReset "none" )}}selected{{/if}}>{{localize "THE-CODEX.UI.ResetNone"}}</option>
            </select>
        </div>
    </div>

    <div class="form-group-row" style="margin-top: 10px; border-top: 1px dotted #7a6a4a; padding-top: 10px;">
        <div class="form-group">
            <label>{{localize "THE-CODEX.UI.SpellLearning"}}</label>
            <select name="system.spellLearning">
                <option value="known" {{#if (eq system.spellLearning "known" )}}selected{{/if}}>{{localize "THE-CODEX.UI.SpellLearningLabel.Known"}}</option>
                <option value="prepared" {{#if (eq system.spellLearning "prepared" )}}selected{{/if}}>{{localize "THE-CODEX.UI.SpellLearningLabel.Prepared"}}</option>
                <option value="spellbook" {{#if (eq system.spellLearning "spellbook" )}}selected{{/if}}>{{localize "THE-CODEX.UI.SpellLearningLabel.Spellbook"}}</option>
            </select>
        </div>
        {{#if (eq system.category "invoker")}}
        <div class="form-group" style="max-width: 80px;">
            <label>Dado Inv.</label>
            <select name="system.invocationDie">
                <option value="d4" {{#if (eq system.invocationDie "d4" )}}selected{{/if}}>d4</option>
                <option value="d6" {{#if (eq system.invocationDie "d6" )}}selected{{/if}}>d6</option>
                <option value="d8" {{#if (eq system.invocationDie "d8" )}}selected{{/if}}>d8</option>
                <option value="d10" {{#if (eq system.invocationDie "d10" )}}selected{{/if}}>d10</option>
            </select>
        </div>
        {{/if}}
    </div>
    {{/unless}}

    {{#unless (eq system.category "martial")}}
    <div class="spell-table-editor" style="margin-top:15px;">
        <label>{{localize "THE-CODEX.Sheet.Spellcasting"}} ({{localize "THE-CODEX.Combat.Circle"}} 0-9)</label>
        <div class="spell-progression-container" style="overflow-x: auto;">
            <table class="spell-progression-table inv-table">
                <thead>
                    <tr>
                        <th class="lvl-col">{{localize "THE-CODEX.Sheet.Level"}}</th>
                        {{#each (range 0 9) as |circle|}}
                        <th class="text-center">{{circle}}°</th>
                        {{/each}}
                    </tr>
                </thead>
                <tbody>
                    {{#each progLevels as |lvl|}}
                    <tr>
                        <td class="lvl-col text-center"><strong>{{lvl}}</strong></td>
                        {{#each (range 0 9) as |circle|}}
                        <td class="cell-slot">
                            <input type="number" name="system.progression.spellcasting.{{lvl}}.{{circle}}"
                                value="{{lookup (lookup @root.effectiveProgression (concat lvl "")) (concat circle "")}}"
                                placeholder="0"
                                style="width: 100%; background: transparent; border: none; color: #eee; text-align: center; padding: 2px;" />
                        </td>
                        {{/each}}
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    {{/unless}}
</div>

{{!-- Sistema de Advancements (Progressão) --}}
<div style="margin-top: 15px;">
    <h3 class="form-header"><i class="fas fa-arrow-up"></i> {{localize "THE-CODEX.Sheet.Features"}}</h3>
    {{> "codex-item-details-advancement" this}}
</div>