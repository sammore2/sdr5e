<div class="item-immunities-panel">
    <h3 class="form-header">{{localize "THE-CODEX.UI.TraitsImmunities"}}</h3>
    
    <div class="form-group">
        <label>{{localize "THE-CODEX.UI.MagicResistance"}}</label>
        <input type="number" name="system.bonuses.rm" value="{{system.bonuses.rm}}" placeholder="0 = Nenhuma, 1 = Padrão"/>
        <p class="hint">{{localize "THE-CODEX.UI.MagicResistanceHint"}}</p>
    </div>

    <h3 class="form-sub-header"><i class="fas fa-shield-heart color-red"></i> {{localize "THE-CODEX.UI.DamageImmunities"}}</h3>
    <div class="trait-selection-grid">
        {{#each config.damageTypes as |label id|}}
        <label class="checkbox-pill">
            <input type="checkbox" name="system.bonuses.traits.di" value="{{id}}" {{checked (includes ../system.bonuses.traits.di id)}}>
            <span>{{localize label}}</span>
        </label>
        {{/each}}
    </div>

    <h3 class="form-sub-header"><i class="fas fa-shield color-blue"></i> {{localize "THE-CODEX.UI.DamageResistances"}}</h3>
    <div class="trait-selection-grid">
        {{#each config.damageTypes as |label id|}}
        <label class="checkbox-pill">
            <input type="checkbox" name="system.bonuses.traits.dr" value="{{id}}" {{checked (includes ../system.bonuses.traits.dr id)}}>
            <span>{{localize label}}</span>
        </label>
        {{/each}}
    </div>

    <h3 class="form-sub-header"><i class="fas fa-skull color-orange"></i> {{localize "THE-CODEX.UI.DamageVulnerabilities"}}</h3>
    <div class="trait-selection-grid">
        {{#each config.damageTypes as |label id|}}
        <label class="checkbox-pill">
            <input type="checkbox" name="system.bonuses.traits.dv" value="{{id}}" {{checked (includes ../system.bonuses.traits.dv id)}}>
            <span>{{localize label}}</span>
        </label>
        {{/each}}
    </div>

    <h3 class="form-sub-header"><i class="fas fa-biohazard color-yellow"></i> {{localize "THE-CODEX.UI.ConditionImmunities"}}</h3>
    <div class="trait-selection-grid">
        {{#each config.conditions as |label id|}}
        <label class="checkbox-pill">
            <input type="checkbox" name="system.bonuses.traits.ci" value="{{id}}" {{checked (includes ../system.bonuses.traits.ci id)}}>
            <span>{{localize label}}</span>
        </label>
        {{/each}}
    </div>
</div>
