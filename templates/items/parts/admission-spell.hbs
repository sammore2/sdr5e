<div class="section-header">{{localize 'THE-CODEX.Spell.ClassMapping'}}</div>
<div class="class-mapping-grid">
  {{#each spellClasses as |cls|}}
  <div class="class-map-item {{#if cls.checked}}is-active{{else}}is-inactive{{/if}}">
    <div class="class-header">
      <label class="class-name">
        <input type="checkbox" data-action="toggleClassMapping" data-class-id="{{cls.id}}" {{checked cls.checked}}/>
        {{cls.label}}
      </label>
    </div>
    
    <div class="circle-selector {{#unless cls.checked}}disabled{{/unless}}">
      {{#if cls.checked}}
        <input type="number" name="system.requirements.classMapping.{{cls.index}}.circle" value="{{cls.circle}}" min="0" max="9"/>
      {{else}}
        ---
      {{/if}}
    </div>
  </div>
  {{/each}}
</div>
