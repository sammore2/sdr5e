{{!-- systems/the-codex-modern/templates/items/parts/feature-bonuses.hbs --}}
<div class="feature-bonuses-panel papiro-bg">
    <h3 class="form-header"><i class="fas fa-plus-circle"></i> {{localize "TYPES.Wizard.Steps.ReviewPowers"}}
    </h3>

    <div class="automation-section papiro-bg">
        <label class="section-title"><i class="fas fa-brain"></i> {{localize
            'THE-CODEX.FeatureFields.AbilityBonuses'}}</label>
        <div class="bonuses-grid-v13" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.Abilities.str'}}</label>
                <input type="number" name="system.bonuses.abilities.str" value="{{system.bonuses.abilities.str}}"
                    placeholder="0" />
            </div>
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.Abilities.dex'}}</label>
                <input type="number" name="system.bonuses.abilities.dex" value="{{system.bonuses.abilities.dex}}"
                    placeholder="0" />
            </div>
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.Abilities.con'}}</label>
                <input type="number" name="system.bonuses.abilities.con" value="{{system.bonuses.abilities.con}}"
                    placeholder="0" />
            </div>
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.Abilities.int'}}</label>
                <input type="number" name="system.bonuses.abilities.int" value="{{system.bonuses.abilities.int}}"
                    placeholder="0" />
            </div>
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.Abilities.wis'}}</label>
                <input type="number" name="system.bonuses.abilities.wis" value="{{system.bonuses.abilities.wis}}"
                    placeholder="0" />
            </div>
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.Abilities.cha'}}</label>
                <input type="number" name="system.bonuses.abilities.cha" value="{{system.bonuses.abilities.cha}}"
                    placeholder="0" />
            </div>
        </div>
    </div>

    <div class="automation-section papiro-bg" style="margin-top: 20px;">
        <label class="section-title"><i class="fas fa-swords"></i> {{localize
            'THE-CODEX.FeatureFields.CombatBonuses'}}</label>
        <div class="bonuses-grid-v13" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.FeatureFields.AtkMelee'}}</label>
                <input type="number" name="system.bonuses.attack.melee" value="{{system.bonuses.attack.melee}}"
                    placeholder="0" />
            </div>
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.FeatureFields.AtkRanged'}}</label>
                <input type="number" name="system.bonuses.attack.ranged" value="{{system.bonuses.attack.ranged}}"
                    placeholder="0" />
            </div>
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.FeatureFields.DamageAll'}}</label>
                <input type="number" name="system.bonuses.damage.all" value="{{system.bonuses.damage.all}}"
                    placeholder="0" />
            </div>
            <div class="bonus-item flex2">
                <label>{{localize 'THE-CODEX.FeatureFields.DamageBonusFormula'}}</label>
                <input type="text" name="system.bonuses.damage.formula" value="{{system.bonuses.damage.formula}}"
                    placeholder="Ex: 1d6, @itemClassLeveld6" />
            </div>
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.FeatureFields.Defense'}}</label>
                <input type="number" name="system.bonuses.da" value="{{system.bonuses.da}}" placeholder="0" />
            </div>
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.FeatureFields.InitiativeBonus'}}</label>
                <input type="number" name="system.bonuses.initiative" value="{{system.bonuses.initiative}}"
                    placeholder="0" />
            </div>
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.FeatureFields.SpeedBonus'}}</label>
                <input type="number" name="system.bonuses.speed" value="{{system.bonuses.speed}}" placeholder="0" />
            </div>
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.FeatureFields.HPBonus'}}</label>
                <input type="number" name="system.bonuses.hp" value="{{system.bonuses.hp}}" placeholder="0" />
            </div>
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.FeatureFields.SpellDCBonus'}}</label>
                <input type="number" name="system.bonuses.spellDC" value="{{system.bonuses.spellDC}}" placeholder="0" />
            </div>
            <div class="bonus-item">
                <label>{{localize 'THE-CODEX.FeatureFields.GlobalSave'}}</label>
                <input type="number" name="system.bonuses.saves.all" value="{{system.bonuses.saves.all}}"
                    placeholder="0" />
            </div>
        </div>
    </div>

    <div class="automation-section papiro-bg" style="margin-top: 20px;">
        <label class="section-title"><i class="fas fa-graduation-cap"></i> {{localize
            'THE-CODEX.FeatureFields.SkillBonuses'}}</label>

        <div class="form-group">
            <label>{{localize 'THE-CODEX.FeatureFields.TrainedSkill'}}</label>
            <select name="system.bonuses.trainedSkill" style="width: 100%;">
                <option value="">-- {{localize 'THE-CODEX.FeatureFields.NoTrainedSkill'}} --</option>
                {{#each config.skills as |skillData k|}}
                <option value="{{k}}" {{#if (eq k ../system.bonuses.trainedSkill)}}selected{{/if}}>{{localize
                    skillData.label}}</option>
                {{/each}}
            </select>
        </div>

        <div class="checkbox-group-v13"
            style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 15px;">
            <label class="checkbox-label">
                <input type="checkbox" name="system.flags.isFinesse" {{checked system.flags.isFinesse}} />
                <span>{{localize 'THE-CODEX.FeatureFields.Finesse'}}</span>
            </label>
            <label class="checkbox-label">
                <input type="checkbox" name="system.flags.isTWF" {{checked system.flags.isTWF}} />
                <span>{{localize 'THE-CODEX.FeatureFields.TWF'}}</span>
            </label>
            <label class="checkbox-label">
                <input type="checkbox" name="system.meta.isMetamagic" {{checked system.meta.isMetamagic}} />
                <span>{{localize 'THE-CODEX.FeatureAutomation.IsMetamagic'}}</span>
            </label>
        </div>
    </div>
</div>