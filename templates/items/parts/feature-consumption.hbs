{{!-- systems/the-codex-modern/templates/items/parts/feature-consumption.hbs --}}
<div class="feature-consumption-panel papiro-bg">
    <h3 class="form-header"><i class="fas fa-battery-half"></i> {{localize "THE-CODEX.Action.ConsumptionHeader"}}</h3>
    
    <div class="form-section" style="margin-bottom: 20px; border-bottom: 1px solid rgba(0,0,0,0.1); padding-bottom: 15px;">
        <label class="section-title">Limites de Uso (Cargas)</label>
        <div class="form-group-row">
            <div class="form-group">
                <label>{{localize "THE-CODEX.ActionFields.UsesValue"}}</label>
                <input type="number" name="system.uses.value" value="{{system.uses.value}}" min="0"/>
            </div>
            <div class="form-group">
                <label>{{localize "THE-CODEX.ActionFields.UsesMax"}}</label>
                <input type="text" name="system.uses.max" value="{{system.uses.max}}" placeholder="0 ou @classes.warrior.level"/>
            </div>
            <div class="form-group">
                <label>{{localize "THE-CODEX.ActionFields.Recovery"}}</label>
                <select name="system.uses.recovery">
                    {{selectOptions config.recoveryTypes selected=system.uses.recovery localize=true}}
                </select>
            </div>
        </div>
    </div>

    <div class="form-section">
        <label class="section-title">Custo de Recurso (Energia)</label>
        <div class="form-group-row">
            <div class="form-group" style="flex: 2;">
                <label>Gastar de:</label>
                <select name="system.uses.type">
                    {{selectOptions config.recoveryAmountTypes selected=system.uses.type localize=true}}
                </select>
            </div>
            <div class="form-group" style="flex: 1;">
                <label>Qtd:</label>
                <input type="number" name="system.uses.amount" value="{{system.uses.amount}}" min="0" style="text-align: center;" />
            </div>
        </div>
        <p class="hint" style="font-size: 0.75rem; margin-top: 10px; opacity: 0.8;">Define qual energia este talento consome do personagem ao ser ativado.</p>
    </div>
</div>
