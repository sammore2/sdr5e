<div class="sdrn-item-root">

  <div class="sdrn-item-header">
    <button type="button" class="sdrn-item-icon-lg" data-action="pick-icon" title="Click to set a custom icon image">
      {{#if imgUrl}}<img src="{{imgUrl}}" alt="" />{{else}}{{icon}}{{/if}}
    </button>
    <div class="sdrn-item-header-main">
      <input type="text" class="sdrn-name-input sdrn-item-name-input" name="name" value="{{name}}" placeholder="Item Name" />
      <div class="sdrn-item-header-row">
        <label>Rarity</label>
        <input type="text" name="sd:rarity" value="{{rarity}}" />
        <label>Weight</label>
        <input type="number" name="sd:weight" value="{{weight}}" step="0.1" /> <span class="sdrn-empty">lb</span>
        <label>Price</label>
        <input type="number" name="sd:price.gp" value="{{priceGp}}" /> <span class="sdrn-empty">gp</span>
        {{#if hasQuantity}}
        <label>Qty</label>
        <input type="number" name="sd:quantity" value="{{quantity}}" />
        {{/if}}
      </div>
    </div>
  </div>

  <nav class="sdrn-item-tabs">
    <button type="button" class="sdrn-item-tab-btn active" data-action="item-tab" data-tab="description">Description</button>
    <button type="button" class="sdrn-item-tab-btn" data-action="item-tab" data-tab="details">Details</button>
  </nav>

  <div data-item-tab-content="description" class="sdrn-item-tab-panel">
    <div class="sdrn-item-section">
      <div class="sdrn-item-section-title">Description</div>
      <textarea name="sd:description" rows="8" placeholder="No description yet.">{{description}}</textarea>
    </div>
    <div class="sdrn-item-tags">
      {{#each tags}}<span class="sdrn-tag sdrn-item-tag">{{this}}</span>{{/each}}
    </div>
  </div>

  <div data-item-tab-content="details" class="sdrn-item-tab-panel" style="display:none">
    <div class="sdrn-item-fields">
      {{#each fields}}
      <div class="sdrn-item-field sdrn-item-field-{{type}}">
        <label>{{label}}</label>
        {{#if isTextarea}}
        <textarea name="sd:{{key}}" rows="3">{{value}}</textarea>
        {{else if isBoolean}}
        <input type="checkbox" name="sd:{{key}}" {{#if value}}checked{{/if}} />
        {{else if isNumber}}
        <input type="number" name="sd:{{key}}" value="{{value}}" />
        {{else if isSelect}}
        <select name="sd:{{key}}">
          {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
        {{else}}
        <input type="text" name="sd:{{key}}" value="{{value}}" />
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>

</div>
