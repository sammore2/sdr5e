<div class="codex-reaction-content papiro-box">
    <div class="prompt-header" style="text-align: center; margin-bottom: 15px; border-bottom: 1px solid rgba(0, 240, 255, 0.3); padding-bottom: 10px;">
        <i class="fas fa-bolt-lightning" style="color: #00f0ff; font-size: 1.5em;"></i>
        <h3 style="margin: 5px 0; color: #fff;">Gatilho de Reação!</h3>
        <p style="font-size: 0.9em; color: #aaa;"><strong>{{attacker.name}}</strong> está prestes a acertar <strong>{{target.name}}</strong>.</p>
    </div>

    <div class="reactions-list" style="display: flex; flex-direction: column; gap: 8px;">
        {{#each reactions}}
        <button class="reaction-btn codex-button variant" data-uuid="{{this.uuid}}" style="display: flex; justify-content: space-between; align-items: center; padding: 10px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <img src="{{this.img}}" width="32" height="32" style="border: 1px solid #444; border-radius: 4px;">
                <span style="font-weight: bold;">{{this.name}}</span>
            </div>
            <i class="fas fa-chevron-right" style="opacity: 0.5;"></i>
        </button>
        {{/each}}
    </div>

    <button class="skip-btn codex-button" style="margin-top: 15px; background: rgba(255, 0, 0, 0.1); border-color: rgba(255, 0, 0, 0.3); color: #f87171;">
        <i class="fas fa-times"></i> Ignorar e Receber o Golpe
    </button>
</div>
