<section class="step-feats">
    <h3 class="step-title">{{localize 'TYPES.Wizard.LevelUpWizard.Step4.Title'}}</h3>
    <p class="description">{{localize 'TYPES.Wizard.LevelUpWizard.Step4.Description'}}</p>
    
    {{#each advancements}}
    <div class="feats-browser box-decorative" style="margin-bottom: 20px;">
        <div class="browser-header">
            <span>{{localize 'TYPES.Wizard.LevelUpWizard.Step4.PoolHeader' title=title}} 
                <strong style="color:{{#if isComplete}}#44ff44{{else}}#ff9900{{/if}};">
                    ({{current}} / {{count}})
                </strong>
            </span>
            <span>{{localize 'TYPES.Wizard.LevelUpWizard.Step4.Requirements'}}</span>
            <span>{{localize 'TYPES.Wizard.LevelUpWizard.Step4.SelectShort'}}</span>
        </div>
        
        <div class="items-list">
            {{#if isSubclass}}
                <div class="subclass-selector-area">
                    {{#if isComplete}}
                        <div class="selected-subclass-preview box-decorative">
                            {{#each items}}{{#if selected}}
                                <img src="{{img}}" width="48" height="48">
                                <div>
                                    <span class="subclass-name">{{name}}</span>
                                    <p class="subclass-summary">{{{system.description}}}</p>
                                </div>
                            {{/if}}{{/each}}
                        </div>
                    {{/if}}
                    <button type="button" class="btn-open-path-picker" data-advancement="{{id}}">
                        <i class="fas fa-scroll-old"></i> 
                        {{#if isComplete}}{{localize 'THE-CODEX.Wizard.Steps.ChangePath'}}{{else}}{{localize 'THE-CODEX.Wizard.Steps.ChoosePath'}}{{/if}}
                    </button>
                </div>
            {{else}}
                {{#each items}}
                <div class="item-row {{#if selected}}selected{{/if}} {{#if isLocked}}locked{{/if}}" data-tooltip="{{uuid}}">
                    <img src="{{img}}" class="item-img" />
                    <div class="item-info">
                        <span class="name">
                            {{name}}
                            {{#if isLocked}}
                                <span class="locked-badge" style="color:#ff4d4d; font-size:0.8em; margin-left:8px;" data-tooltip="{{localize 'THE-CODEX.Wizard.Steps.LockedLevel' level=lockedReason}}">
                                    <i class="fas fa-lock"></i> {{lockedReason}}
                                </span>
                            {{/if}}
                        </span>
                        <span class="req-text">
                            {{#if system.requirements.text}}
                                {{system.requirements.text}}
                            {{else if (eq (typeof system.requirements) "string")}}
                                {{system.requirements}}
                            {{/if}}
                        </span>
                        {{#if system.description}}
                            <div class="item-summary" style="font-size: 0.8em; opacity: 0.8; margin-top: 4px; max-height: 4.8em; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;">
                                {{{system.description}}}
                            </div>
                        {{/if}}
                    </div>
                    <input type="checkbox" class="feat-toggle" 
                           data-uuid="{{uuid}}" 
                           data-advancement="{{../id}}"
                           {{#if selected}}checked{{/if}}
                           {{#if isLocked}}disabled{{/if}}>
                </div>
                {{else}}
                <p class="empty-notice">{{localize 'TYPES.Wizard.LevelUpWizard.Step4.EmptyNotice'}}</p>
                {{/each}}
            {{/if}}
        </div>
    </div>
    {{else}}
        <p class="empty-notice">{{localize 'TYPES.Wizard.LevelUpWizard.Step4.EmptyNotice'}}</p>
    {{/each}}
</section>
