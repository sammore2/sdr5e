<section class="step-spells">
    <h3 class="step-title">{{localize 'TYPES.Wizard.LevelUpWizard.Step5.Title'}}</h3>
    
    {{#if isSpellcaster}}
        <div class="known-counter box-decorative">
            <span>{{localize 'TYPES.Wizard.LevelUpWizard.Step5.KnownSpells'}}</span>
            <strong style="color: {{#if isOverLimit}}#ff4444{{else}}#d4af37{{/if}};">
                {{changes.selectedSpells.length}} / {{maxSpells}}
            </strong>
        </div>

        <div class="spell-search-container">
            <input type="text" class="spell-search-input" placeholder="Buscar magia pelo nome..." id="spell-search-input" autocomplete="off" />
        </div>

        <div class="spells-browser box-decorative">
            <div class="items-list">
                {{#each spells}}
                <div class="circle-group-header" style="background:linear-gradient(90deg, rgba(212,175,55,0.2) 0%, rgba(0,0,0,0) 100%); border-left:4px solid #d4af37; padding:10px 15px; margin:20px 0 10px 0; font-family:'Cinzel', serif; color:#d4af37; font-weight:bold; letter-spacing:1.5px; display:flex !important; align-items:center; gap:10px; text-transform:uppercase; font-size:1.1em; text-shadow: 1px 1px 2px #000;">
                    <i class="fas fa-sun"></i>
                    {{label}}
                </div>
                
                <div class="spells-grid">
                    {{#each items}}
                    <label class="item-row {{#if selected}}selected{{/if}}" data-tooltip="{{uuid}}">
                        <img src="{{img}}" class="item-img" />
                        <div class="item-info">
                            <span class="name">{{name}}</span>
                        </div>
                        <input type="checkbox" class="spell-toggle" data-uuid="{{uuid}}" {{#if selected}}checked{{/if}}>
                    </label>
                    {{/each}}
                </div>
                {{else}}
                <p class="empty-notice">{{localize 'TYPES.Wizard.LevelUpWizard.Step5.EmptyCircleNotice' circle=maxCircle}}</p>
                {{/each}}
            </div>
        </div>
    {{else}}
        <div class="no-caster-notice box-decorative">
            <i class="fas fa-hand-sparkles"></i>
            <p>{{localize 'TYPES.Wizard.LevelUpWizard.Step5.NotCasterNotice'}}</p>
        </div>
    {{/if}}
</section>

<script>
(function() {
    const searchInput = document.getElementById('spell-search-input');
    if (!searchInput) return;
    
    searchInput.addEventListener('input', function(e) {
        const query = e.target.value.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        
        // Filtrar cards de magia
        document.querySelectorAll('.step-spells .item-row').forEach(row => {
            const nameSpan = row.querySelector('.name');
            if (!nameSpan) return;
            const name = nameSpan.textContent.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
            
            if (name.includes(query)) {
                row.style.setProperty('display', 'flex', 'important');
            } else {
                row.style.setProperty('display', 'none', 'important');
            }
        });

        // Esconder cabeçalhos de círculo que não possuem itens visíveis
        document.querySelectorAll('.step-spells .items-list > .circle-group-header').forEach(header => {
            const grid = header.nextElementSibling;
            if (grid && grid.classList.contains('spells-grid')) {
                const visibleItems = Array.from(grid.children).some(child => child.style.display !== 'none');
                if (visibleItems) {
                    header.style.setProperty('display', 'flex', 'important');
                } else {
                    header.style.setProperty('display', 'none', 'important');
                }
            }
        });
    });
})();
</script>
