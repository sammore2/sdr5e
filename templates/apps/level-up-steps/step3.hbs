<section class="step-skills">
    <div class="step-header" style="margin-bottom:15px;">
        <h3 class="step-title" style="font-family:'Cinzel', serif; color:#d4af37; border-bottom:1px solid rgba(212,175,55,0.3); padding-bottom:8px;">
            <i class="fas fa-graduation-cap"></i> {{localize 'TYPES.Wizard.LevelUpWizard.Step3.Title'}}
        </h3>
        <p style="font-size:0.8rem; color:#aaa; margin-top:5px;">
            {{localize 'TYPES.Wizard.LevelUpWizard.Step3.Description'}}
        </p>
    </div>

    {{!-- Tracker de Proficiências Disponíveis --}}
    <div class="points-tracker box-decorative" style="display:flex; justify-content:space-between; align-items:center; padding:10px; background:rgba(0,0,0,0.4); border:1px solid #7a6a4a; border-radius:4px; margin-bottom:15px;">
        <span class="points-label" style="font-family:'Cinzel', serif; color:#d4af37;">{{localize 'TYPES.Wizard.LevelUpWizard.Step3.PointsLabel'}}</span>
        <span class="points-value" style="font-size:1.2rem; font-weight:bold; color:{{#if (lt maxSkills 0)}}#ff4444{{else}}{{#if (eq maxSkills 0)}}#888{{else}}#fff{{/if}}{{/if}};">
            {{maxSkills}}
        </span>
    </div>

    {{!-- Lista de Perícias Moderna --}}
    <div class="skills-list-container" style="max-height:350px; overflow-y:auto; padding-right:5px;">
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px;">
            {{#each skillDefinitions as |skill|}}
                <div class="skill-row-modern {{#if skill.isUpgraded}}is-upgraded{{/if}} {{#if (gt skill.current 0)}}is-proficient{{/if}}" 
                     style="display:flex; align-items:center; gap:12px; padding:10px; background:rgba(0,0,0,0.2); border:1px solid rgba(122,106,74,0.3); border-radius:5px; border-left: 4px solid {{#if skill.isUpgraded}}#d4af37{{else}}{{#if (eq skill.current 2)}}#c1a064{{else}}{{#if (eq skill.current 1)}}#7a6a4a{{else}}rgba(122,106,74,0.3){{/if}}{{/if}}{{/if}};">
                    
                    {{!-- Controles de Alocação de Rank --}}
                    <div class="skill-controls" style="display:flex; align-items:center; gap:8px;">
                        {{!-- Botão de menos --}}
                        <button type="button" class="skill-minus" data-skill="{{skill.key}}" 
                                {{#unless skill.allocated}}disabled style="opacity:0.3; cursor:not-allowed;"{{/unless}}
                                style="width:22px; height:22px; border-radius:50%; border:1px solid #7a6a4a; 
                                       background:transparent; color:#d4af37; cursor:pointer; display:flex; 
                                       align-items:center; justify-content:center; font-size:0.8rem;">
                            <i class="fas fa-minus"></i>
                        </button>

                        {{!-- Ícone do Rank Atual/Futuro --}}
                        <div class="skill-rank-display" style="width:24px; height:24px; display:flex; align-items:center; justify-content:center; position:relative;" title="{{skill.totalLabel}}">
                            <i class="{{skill.totalIcon}}" style="color:{{#if skill.isUpgraded}}#d4af37{{else}}{{#if (gt skill.current 0)}}#c1a064{{else}}#666{{/if}}{{/if}}; font-size: 1.1rem;"></i>
                            {{#if skill.allocated}}
                                <span style="position:absolute; top:-5px; right:-5px; background:#d4af37; color:#111; font-size:0.55rem; font-weight:bold; border-radius:50%; width:12px; height:12px; display:flex; align-items:center; justify-content:center;">+{{skill.allocated}}</span>
                            {{/if}}
                        </div>

                        {{!-- Botão de mais --}}
                        <button type="button" class="skill-plus" data-skill="{{skill.key}}" 
                                {{#if (or (eq ../maxSkills 0) (eq skill.total 2))}}disabled style="opacity:0.3; cursor:not-allowed;"{{/if}}
                                style="width:22px; height:22px; border-radius:50%; border:1px solid #7a6a4a; 
                                       background:transparent; color:#d4af37; cursor:pointer; display:flex; 
                                       align-items:center; justify-content:center; font-size:0.8rem;">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>

                    <div class="skill-info" style="flex:1;">
                        <div class="skill-name" style="font-size:0.9rem; font-weight:bold; color:{{#if (or (gt skill.current 0) skill.allocated)}}#fff{{else}}#bbb{{/if}};">
                            {{localize skill.label}}
                        </div>
                        <div style="font-size:0.65rem; color:#aaa; margin-top:2px;">
                            {{#if skill.isUpgraded}}
                                <span style="color:#888;">{{skill.currentLabel}}</span> 
                                <i class="fas fa-long-arrow-alt-right" style="color:#d4af37; margin:0 3px;"></i> 
                                <span style="color:#d4af37; font-weight:bold;">{{skill.totalLabel}}</span>
                            {{else}}
                                <span>{{skill.currentLabel}}</span>
                            {{/if}}
                        </div>
                    </div>
                </div>
            {{/each}}
        </div>
    </div>
</section>
