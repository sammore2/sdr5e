<section class="step-languages">
    <h3 class="step-title">{{localize 'TYPES.Wizard.LevelUpWizard.Step6.Title'}}</h3>
    
    <p class="step-instruction">
        {{localize 'TYPES.Wizard.LevelUpWizard.Step6.Instruction'}}
        {{localize 'TYPES.Wizard.LevelUpWizard.Step6.CountLabel' current=selectedLanguagesCount max=maxLanguages}}
    </p>

    <div class="item-selection-grid papiro-bg">
        <div class="item-list-container">
            <ul class="scrollable-item-list">
                {{#each availableLanguages as |lang|}}
                <li class="item-entry {{#if lang.selected}}selected{{/if}}">
                    <label class="item-label">
                        <input type="checkbox" 
                               class="lang-toggle" 
                               data-uuid="{{lang.uuid}}" 
                               {{#if lang.selected}}checked{{/if}}>
                        <img src="{{lang.img}}" width="32" height="32" />
                        <span class="item-name">{{lang.name}}</span>
                    </label>
                </li>
                {{/each}}
            </ul>
        </div>
    </div>

    <div class="step-footer-hint">
        <i class="fas fa-info-circle"></i>
        <span>{{localize 'TYPES.Wizard.LevelUpWizard.Step6.FooterHint'}}</span>
    </div>
</section>
