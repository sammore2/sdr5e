<section class="step-abilities">
    <div class="step-header" style="text-align:center; margin-bottom:20px; border-bottom:1px solid #7a6a4a; padding-bottom:15px;">
        <h3 style="font-family:'Cinzel', serif; color:#d4af37; font-size:1.8rem; margin:0;">
            <i class="fas fa-dumbbell"></i> {{localize 'TYPES.Wizard.LevelUpWizard.Step2.Title'}}
        </h3>
        <p style="font-size:0.9rem; color:#888; margin-top:5px;">{{localize 'TYPES.Wizard.LevelUpWizard.Step2.Description'}}</p>
    </div>
    
    {{#if showAbilityBoost}}
        <div class="ability-selection-grid" style="display:grid; grid-template-columns: 1fr 1fr; gap:15px;">
            {{#each abilities as |label key|}}
            {{#with (lookup ../abilityValues key) as |abl|}}
            <label class="ability-card-v13 {{#if (eq ../../changes.abilityIncrease key)}}active-selection{{/if}}" 
                   style="display:flex; flex-direction:column; background:rgba(0,0,0,0.4); border:1px solid #7a6a4a; border-radius:8px; padding:15px; cursor:pointer; transition:all 0.2s; position:relative; overflow:hidden;">
                
                <input type="radio" name="abilityBoost" value="{{key}}" {{#if (eq ../../changes.abilityIncrease key)}}checked{{/if}} style="display:none;">
                
                <div class="card-header" style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(122,106,74,0.3); padding-bottom:8px; margin-bottom:8px;">
                    <span style="font-family:'Cinzel', serif; color:#d4af37; font-size:1.1rem; font-weight:bold;">{{localize label}}</span>
                    <span style="font-size:0.8rem; background:rgba(212,175,55,0.1); color:#d4af37; padding:2px 8px; border-radius:4px; border:1px solid rgba(212,175,55,0.3);">{{localize 'TYPES.Wizard.LevelUpWizard.Step2.Current'}} {{abl.value}}</span>
                </div>

                <div class="card-body" style="display:flex; justify-content:center; align-items:center; flex:1;">
                    <div style="text-align:center;">
                        <span style="font-size:1.4rem; color:#fff; font-family:'MedievalSharp', cursive;">{{abl.value}}</span>
                        <i class="fas fa-long-arrow-alt-right" style="margin:0 10px; color:#d4af37;"></i>
                        <span style="font-size:1.8rem; color:#4a8a4a; font-family:'MedievalSharp', cursive; text-shadow:0 0 8px rgba(74,138,74,0.5);">{{add abl.value 1}}</span>
                    </div>
                </div>

                <div class="card-footer" style="text-align:center; font-size:0.75rem; color:#888; margin-top:8px;">
                    {{localize 'TYPES.Wizard.LevelUpWizard.Step2.FooterHint'}}
                </div>

                {{!-- Efeito de seleção --}}
                {{#if (eq ../../changes.abilityIncrease key)}}
                <div class="selection-overlay" style="position:absolute; inset:0; border:2px solid #d4af37; box-shadow:inset 0 0 15px rgba(212,175,55,0.3); pointer-events:none;"></div>
                <div style="position:absolute; top:5px; right:5px; color:#d4af37;"><i class="fas fa-check-circle"></i></div>
                {{/if}}
            </label>
            {{/with}}
            {{/each}}
        </div>
    {{else}}
        <div class="no-boost-notice box-decorative" style="background:rgba(0,0,0,0.5); padding:30px; text-align:center; border:1px solid #7a6a4a; border-radius:8px;">
            <i class="fas fa-info-circle" style="font-size:2rem; color:#d4af37; margin-bottom:15px;"></i>
            <p style="font-family:'Cinzel', serif; color:#fff;">{{localize 'TYPES.Wizard.LevelUpWizard.Step2.NoBoostTitle'}}</p>
            <p style="font-size:0.8rem; color:#888;">{{localize 'TYPES.Wizard.LevelUpWizard.Step2.NoBoostDesc'}}</p>
        </div>
    {{/if}}
</section>
