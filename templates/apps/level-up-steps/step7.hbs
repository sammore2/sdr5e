<section class="step-review">
    <h3 class="step-title">{{localize 'TYPES.Wizard.LevelUpWizard.Step7.Title'}}</h3>
    
    <div class="review-log box-decorative">
        <h4>{{localize 'TYPES.Wizard.LevelUpWizard.Step7.SummaryHeader'}}</h4>
        <ul class="changes-list">
            <li><i class="fas fa-chevron-right"></i> {{localize 'TYPES.Wizard.LevelUpWizard.Step7.LevelLabel'}} <strong>{{actor.system.details.level}} <i class="fas fa-arrow-right"></i> {{changes.level}}</strong></li>
            
            <li><i class="fas fa-chevron-right"></i> {{localize 'TYPES.Wizard.LevelUpWizard.Step7.HPGain'}} <strong>+{{add changes.hpRoll changes.hpBonus}}</strong> ({{changes.hpRoll}} {{localize 'TYPES.Wizard.LevelUpWizard.Step7.DieSuffix'}} + {{changes.hpBonus}} {{localize 'TYPES.Wizard.LevelUpWizard.Step7.ConSuffix'}})</li>

            {{#if changes.abilityIncrease}}
                <li><i class="fas fa-chevron-right"></i> {{localize 'TYPES.Wizard.LevelUpWizard.Step7.AbilityLabel'}} <strong>+1 em {{changes.abilityIncrease}}</strong></li>
            {{/if}}

            {{#if (typeof changes.allocatedSkills "object")}}
                <li><i class="fas fa-chevron-right"></i> {{localize 'TYPES.Wizard.LevelUpWizard.Step7.SkillsLabel'}}
                    <ul>
                        {{#each changes.allocatedSkills as |ranks key|}}
                            {{#if ranks}}
                            <li>{{lookup ../skillLabels key}}: +{{ranks}}</li>
                            {{/if}}
                        {{/each}}
                    </ul>
                </li>
            {{/if}}

            {{#if changes.selectedFeats.length}}
                <li><i class="fas fa-chevron-right"></i> {{localize 'TYPES.Wizard.LevelUpWizard.Step7.FeatsLabel'}} 
                    <div style="display:flex; flex-wrap:wrap; gap:5px; margin-top:5px;">
                        {{#each changes.selectedFeats}}
                        <div class="adv-item-pill" style="display:flex; align-items:center; gap:5px; font-size:0.75rem; background:rgba(212,175,55,0.1); border:1px solid #d4af37; border-radius:15px; padding:1px 8px; color:#dec8a0;">
                            <span>{{this.name}}</span>
                        </div>
                        {{/each}}
                    </div>
                </li>
            {{/if}}

            {{#if changes.selectedSpells.length}}
                <li><i class="fas fa-chevron-right"></i> {{localize 'TYPES.Wizard.LevelUpWizard.Step7.SpellsLabel'}} 
                    <div style="display:flex; flex-wrap:wrap; gap:5px; margin-top:5px;">
                        {{#each changes.selectedSpells}}
                        <div class="adv-item-pill" style="display:flex; align-items:center; gap:5px; font-size:0.75rem; background:rgba(100,50,150,0.2); border:1px solid #8060b0; border-radius:15px; padding:1px 8px; color:#c8a0f0;">
                            <span>{{this.name}}</span>
                        </div>
                        {{/each}}
                    </div>
                </li>
            {{/if}}

            {{#if changes.selectedLanguages.length}}
                <li><i class="fas fa-chevron-right"></i> {{localize 'TYPES.Wizard.LevelUpWizard.Step7.LanguagesLabel'}} 
                    {{#each changes.selectedLanguages}}{{this.name}}{{#unless @last}}, {{/unless}}{{/each}}
                </li>
            {{/if}}

            {{#if autoFeatures.length}}
                <li><i class="fas fa-magic"></i> {{localize 'TYPES.Wizard.LevelUpWizard.Step7.AutoGainsLabel'}}
                    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:8px;">
                        {{#each autoFeatures as |it|}}
                            <div class="adv-item-pill" style="display:flex; align-items:center; gap:6px; font-size:0.8rem; background:rgba(74,138,74,0.2); border:1px solid #4a8a4a; border-radius:15px; padding:2px 12px 2px 6px; color:#66bb6a;">
                                <img src="{{it.img}}" width="20" height="20" style="border:none; border-radius:50%; opacity:0.9;"/>
                                <span>{{it.name}}</span>
                            </div>
                        {{/each}}
                    </div>
                </li>
            {{/if}}
        </ul>
    </div>

    <div class="confirmation-notice">
        <i class="fas fa-exclamation-triangle"></i>
        <p>{{localize 'TYPES.Wizard.LevelUpWizard.Step7.ConfirmationNotice'}}</p>
    </div>
</section>
