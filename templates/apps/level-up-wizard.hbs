<div class="sdrn-wizard-root">
  <div class="sdrn-wizard-steps">
    {{#each _activeSteps}}
    <div class="sdrn-wizard-step-dot">{{this}}</div>
    {{/each}}
  </div>

  <div class="sdrn-wizard-body">
    {{#if _stepClass}}
    <h3>Which class levels up?</h3>
    <select name="w:classId">
      {{#each _classItems}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} (Level {{levels}})</option>{{/each}}
    </select>
    {{/if}}

    {{#if _stepHp}}
    <h3>{{_className}} — Level {{_currentClassLevel}} → {{_nextClassLevel}}</h3>
    <p class="sdrn-wizard-hint">Hit Die: {{_die}}. Average result (SRD alternative to rolling): +{{_hpGain}} HP.</p>
    <div class="sdrn-bio-field"><label>HP Gained</label><input type="number" value="{{_hpGain}}" disabled /></div>
    {{/if}}

    {{#if _stepAsi}}
    <h3>Ability Score Improvement</h3>
    <p class="sdrn-wizard-hint">Level {{_nextClassLevel}}: increase one score by 2, or two scores by 1 each (max 20) — or take a Feat instead.</p>
    <label><input type="radio" name="w:asiMode" value="scores" {{#if _asiModeScores}}checked{{/if}} /> Ability scores</label>
    <label><input type="radio" name="w:asiMode" value="feat" {{#if _asiModeFeat}}checked{{/if}} /> Feat</label>

    {{#if _asiModeScores}}
    <div class="sdrn-bio-field">
      <label>+1 (or +2 if second is blank)</label>
      <select name="w:asiFirst">
        <option value="">—</option>
        {{#each _abilities}}<option value="{{key}}" {{#if atCap}}disabled{{/if}}>{{label}} ({{value}})</option>{{/each}}
      </select>
    </div>
    <div class="sdrn-bio-field">
      <label>+1 (optional second score)</label>
      <select name="w:asiSecond">
        <option value="">—</option>
        {{#each _abilities}}<option value="{{key}}" {{#if atCap}}disabled{{/if}}>{{label}} ({{value}})</option>{{/each}}
      </select>
    </div>
    {{/if}}

    {{#if _asiModeFeat}}
    {{#if _featPicked}}
    <div class="sdrn-wizard-picked">
      <strong>{{_featName}}</strong> <span class="sdrn-wizard-hint">(from compendium)</span>
      <button type="button" class="sdrn-wizard-btn" data-action="wizard-clear-feat">Change</button>
    </div>
    {{else}}
    <div class="sdrn-bio-field"><label>Filter</label><input type="text" data-wizard-search="feat" value="{{_featQuery}}" placeholder="Type to filter, or pick below" /></div>
    {{#if _featResults}}
    <div class="sdrn-wizard-results">
      {{#each _featResults}}
      <button type="button" class="sdrn-wizard-result" data-action="wizard-pick-feat" data-id="{{id}}">
        <span>{{name}}</span> <small>{{sourceName}}</small>
      </button>
      {{/each}}
    </div>
    {{else}}
    <p class="sdrn-wizard-hint">No compendium feat packs found. Ask your GM to install a feat pack.</p>
    {{/if}}
    {{/if}}
    {{/if}}
    {{/if}}

    {{#if _stepSubclass}}
    <h3>Choose your Subclass</h3>
    {{#if _subclassPicked}}
    <div class="sdrn-wizard-picked">
      <strong>{{_subclassName}}</strong> <span class="sdrn-wizard-hint">(from compendium)</span>
      <button type="button" class="sdrn-wizard-btn" data-action="wizard-clear-subclass">Change</button>
    </div>
    {{else}}
    <div class="sdrn-bio-field"><label>Filter</label><input type="text" data-wizard-search="subclass" value="{{_subclassQuery}}" placeholder="Type to filter, or pick below" /></div>
    {{#if _subclassResults}}
    <div class="sdrn-wizard-results">
      {{#each _subclassResults}}
      <button type="button" class="sdrn-wizard-result" data-action="wizard-pick-subclass" data-id="{{id}}">
        <span>{{name}}</span> <small>{{sourceName}}</small>
      </button>
      {{/each}}
    </div>
    {{else}}
    <p class="sdrn-wizard-hint">No {{_className}} subclass packs found. Ask your GM to install a subclass pack.</p>
    {{/if}}
    {{/if}}
    {{/if}}

    {{#if _stepSpells}}
    <h3>New Spells</h3>
    {{#if _isKnownCaster}}
    <p class="sdrn-wizard-hint">Pick {{_newSpellsRequired}} new spell(s){{#if _newCantripsRequired}} and {{_newCantripsRequired}} new cantrip(s){{/if}} — picked so far: {{_spellLeveledCount}}/{{_newSpellsRequired}} spells, {{_spellCantripCount}}/{{_newCantripsRequired}} cantrips.</p>
    {{else}}
    <p class="sdrn-wizard-hint">{{_className}} prepares from its full spell list — add any spells you want available to prepare (optional, no fixed count).</p>
    {{/if}}
    <div class="sdrn-bio-field"><label>Filter</label><input type="text" data-wizard-search="spell" value="{{_spellQuery}}" placeholder="Type to filter" /></div>
    {{#if _spellPicksLeveled}}
    <div class="sdrn-wizard-results">
      {{#each _spellPicksLeveled}}
      <button type="button" class="sdrn-wizard-result sdrn-wizard-result-picked" data-action="wizard-toggle-spell" data-id="{{id}}">
        <span>✓ {{name}}</span> <small>Level {{data.spellLevel}}</small>
      </button>
      {{/each}}
    </div>
    {{/if}}
    {{#if _spellPicksCantrips}}
    <div class="sdrn-wizard-results">
      {{#each _spellPicksCantrips}}
      <button type="button" class="sdrn-wizard-result sdrn-wizard-result-picked" data-action="wizard-toggle-spell" data-id="{{id}}">
        <span>✓ {{name}}</span> <small>Cantrip</small>
      </button>
      {{/each}}
    </div>
    {{/if}}
    {{#if _spellResults}}
    <div class="sdrn-wizard-results">
      {{#each _spellResults}}
      <button type="button" class="sdrn-wizard-result" data-action="wizard-toggle-spell" data-id="{{id}}">
        <span>{{name}}</span> <small>{{#if data.spellLevel}}Level {{data.spellLevel}}{{else}}Cantrip{{/if}}</small>
      </button>
      {{/each}}
    </div>
    {{else}}
    <p class="sdrn-wizard-hint">No more matching spells found for {{_className}}.</p>
    {{/if}}
    {{/if}}

    {{#if _stepReview}}
    <h3>Review</h3>
    <div class="sdrn-wizard-review">
      <div><strong>{{_className}}</strong> — Level {{_currentClassLevel}} → {{_nextClassLevel}} (Total {{_nextTotalLevel}})</div>
      <div>HP: +{{_hpGain}}</div>
      {{#if _subclassName}}<div>Subclass: {{_subclassName}}</div>{{/if}}
      {{#if _featName}}<div>Feat: {{_featName}}</div>{{/if}}
      {{#if _spellLeveledCount}}<div>New spells: {{_spellLeveledCount}}</div>{{/if}}
      {{#if _spellCantripCount}}<div>New cantrips: {{_spellCantripCount}}</div>{{/if}}
    </div>
    {{/if}}
  </div>

  <div class="sdrn-wizard-nav">
    {{#unless _isFirst}}<button type="button" class="sdrn-wizard-btn" data-action="wizard-back">Back</button>{{/unless}}
    {{#unless _isLast}}<button type="button" class="sdrn-wizard-btn sdrn-wizard-btn-primary" data-action="wizard-next">Next</button>{{/unless}}
    {{#if _isLast}}<button type="button" class="sdrn-wizard-btn sdrn-wizard-btn-primary" data-action="wizard-finish" {{#unless _canFinish}}disabled{{/unless}}>Finish</button>{{/if}}
  </div>
</div>
