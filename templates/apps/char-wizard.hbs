<div class="the-codex wizard-runico char-wizard window-app {{classes}}" style="display:flex; flex-direction:column; height:100%; overflow:hidden; background: linear-gradient(rgba(0,0,0,0.85), rgba(0,0,0,0.85)), url('systems/the-codex-modern/assets/ui/papyrus-clean-bg.png') center/cover no-repeat; color: #eee; position:relative;">
    {{!-- Header: Progresso --}}
    <header class="wizard-header" style="padding:15px; background:rgba(0,0,0,0.7); border-bottom:2px solid #d4af37; box-shadow: 0 4px 10px rgba(0,0,0,0.5); z-index: 10;">
        <h2 class="wizard-title" style="margin:0; font-family:'Cinzel', serif; color:#d4af37; text-align:center; font-size:1.4rem; letter-spacing:2px; text-shadow:0 0 8px rgba(212,175,55,0.4);">
            <i class="fas fa-scroll-old"></i> {{localize 'TYPES.Wizard.Title'}}
        </h2>
        <nav class="wizard-stepper" style="display:flex; justify-content:center; gap:25px; margin-top:15px;">
            {{#each steps as |s idx|}}
            <div class="step-indicator {{#if (eq ../currentStep s.id)}}active{{/if}} {{#if s.done}}complete{{/if}}" 
                 style="display:flex; flex-direction:column; align-items:center; transition:all 0.4s; transform:{{#if (eq ../currentStep s.id)}}scale(1.1){{else}}scale(1){{/if}}; opacity:{{#if (eq ../currentStep s.id)}}1{{else}}0.4{{/if}};">
                <div class="step-num" style="width:28px; height:28px; border-radius:50%; border:2px solid {{#if s.done}}#4a8a4a{{else}}#d4af37{{/if}}; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:0.9rem; background:{{#if s.done}}#2a5a2a{{else}}rgba(0,0,0,0.5){{/if}}; box-shadow:{{#if (eq ../currentStep s.id)}}0 0 10px #d4af37{{else}}none{{/if}};">
                    {{#if s.done}}<i class="fas fa-check" style="color:white;"></i>{{else}}{{add idx 1}}{{/if}}
                </div>
                <span class="step-label" style="font-size:0.65rem; text-transform:uppercase; margin-top:6px; font-family:'Cinzel', serif; color:{{#if (eq ../currentStep s.id)}}#d4af37{{else}}#bbb{{/if}};">{{s.label}}</span>
            </div>
            {{/each}}
        </nav>
    </header>

    {{!-- Corpo: Conteúdo do Passo --}}
    <main class="wizard-container" data-scroll style="flex:1; overflow-y:auto; padding:25px; position:relative; background:rgba(0,0,0,0.3);">
        <div class="wizard-content" style="max-width:800px; margin:0 auto;">
            {{#if (eq currentStep "identity")}}
                {{> "codex-char-identity"}}
            {{else if (eq currentStep "race")}}
                 {{> "codex-char-race"}}
            {{else if (eq currentStep "class")}}
                 {{> "codex-char-class"}}
            {{else if (eq currentStep "abilities")}}
                 {{> "codex-char-abilities"}}
            {{else if (eq currentStep "skills")}}
                 {{> "codex-char-skills"}}
            {{else if (eq currentStep "languages")}}
                 {{> "codex-char-languages"}}
            {{else if (eq currentStep "spells")}}
                 {{> "codex-char-spells"}}
            {{else if (eq currentStep "review")}}
                 {{> "codex-char-review"}}
            {{/if}}
        </div>
    </main>

    {{!-- Footer: Navegação --}}
    <footer class="wizard-footer" style="padding:15px 30px; background:rgba(0,0,0,0.8); border-top:2px solid #d4af37; display:flex; justify-content:space-between; align-items:center; box-shadow:0 -4px 10px rgba(0,0,0,0.5);">
        <button type="button" class="wizard-btn prev" data-action="prevStep" {{#if isFirstStep}}disabled{{/if}} style="padding:8px 20px; font-family:'Cinzel', serif; font-size:0.9rem; border-radius:4px; transition:all 0.2s;">
            <i class="fas fa-arrow-left"></i> {{localize 'THE-CODEX.Sheet.Back'}}
        </button>
        
        <div class="wizard-status" style="font-size:0.85rem; font-style:italic; color:#d4af37; text-shadow:0 0 5px rgba(212,175,55,0.3);">
            {{#if (eq currentStep "abilities")}}
                {{#if rollMode}}
                    <span style="color:#4a8a4a; font-weight:bold;"><i class="fas fa-dice"></i> {{localize 'THE-CODEX.Wizard.RollMode'}}</span>
                {{else}}
                    {{localize 'THE-CODEX.Wizard.PointsRemaining' points=pointsRemaining}}
                {{/if}}
            {{else if (eq currentStep "skills")}}
                {{localize 'THE-CODEX.Wizard.SkillPointsRemaining' points=skillPointsRemaining}}
            {{else if (eq currentStep "spells")}}
                {{localize 'THE-CODEX.Wizard.SpellPointsRemaining' points=spellPointsRemaining}}
            {{else}}
                {{statusMessage}}
            {{/if}}
        </div>

        {{#if isLastStep}}
        <button type="button" class="wizard-btn finish highlight" data-action="finish" style="padding:10px 30px; font-family:'Cinzel', serif; font-size:1.1rem; background: linear-gradient(to bottom, #d4af37, #b8860b); color:#1a1a1a !important; font-weight:bold; border-radius:4px; box-shadow:0 0 15px rgba(212,175,55,0.4); border:1px solid #7a6a4a;">
            <i class="fas fa-check-double"></i> {{localize 'THE-CODEX.Wizard.Finish'}}
        </button>
        {{else}}
        <button type="button" class="wizard-btn next highlight" data-action="nextStep" {{#unless canGoNext}}disabled{{/unless}} style="padding:8px 25px; font-family:'Cinzel', serif; font-size:1rem; border-radius:4px; transition:all 0.2s;">
            {{localize 'THE-CODEX.Sheet.Next'}} <i class="fas fa-arrow-right"></i>
        </button>
        {{/if}}
    </footer>
</div>
