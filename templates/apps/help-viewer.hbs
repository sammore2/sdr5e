<div class="help-viewer-shell {{#if isMasterHub}}is-hub{{/if}}">
    {{#if isMasterHub}}
    {{!-- MASTER HUB: Lista de Manuais do Sistema --}}
    <div class="help-hub-container scrollable">
        <header class="hub-header">
            <div class="hub-logo">
                <img src="systems/the-codex-modern/assets/images/logo_codex_gold.png" alt="Codex Logo">
            </div>
            <div class="hub-subtitle">
                <span>BIBLIOTECA MESTRE DO CODEX</span>
            </div>
        </header>

        <div class="hub-grid">
            {{#each documents as |doc|}}
            <div class="hub-card" data-action="openDocument" data-doc-id="{{doc._id}}">
                <div class="card-content">
                    <h3 class="card-title">{{doc.name}}</h3>
                    <p class="card-desc">{{doc.description}}</p>
                </div>
                <div class="card-footer-glow"></div>
            </div>
            {{/each}}
        </div>
    </div>

    {{else}}
    {{!-- WIKI VIEW: Sidebar + Content --}}
    <aside class="help-sidebar">
        <header class="sidebar-header">
            <div class="sidebar-top">
                <a data-action="goHome" title="Voltar à Biblioteca Mestre"><i class="fas fa-home-alt"></i></a>
                <div class="search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Procurar Páginas..." data-action="searchPages" spellcheck="false">
                </div>
            </div>
        </header>

        <nav class="help-sidebar-nav scrollable">
            {{#each pages as |page|}}
            <div class="nav-item {{#if page.active}}active{{/if}}" data-action="viewPage" data-page-id="{{page.id}}">
                <i class="fas {{page.icon}}"></i>
                <span>{{page.name}}</span>
            </div>
            {{/each}}
        </nav>

        {{#if isGM}}
        <footer class="sidebar-footer">
            <button type="button" data-action="createPage">
                <i class="fas fa-plus-circle"></i> Adicionar Página
            </button>
        </footer>
        {{/if}}
    </aside>

    <main class="help-main">
        <header class="content-header">
            <div class="breadcrumb">
                <a data-action="goHome">{{document.name}}</a>
                {{#unless isIndex}}
                <i class="fas fa-chevron-right"></i>
                <span class="active">{{activePage.name}}</span>
                {{/unless}}
            </div>
        </header>

        <div class="help-content-area scrollable">
            {{#if isIndex}}
            {{!-- DOCUMENT INDEX: Custom HTML Hub + Library Grid --}}
            <div class="library-index">
                {{#if hubHtml}}
                <div class="custom-hub-content">
                    {{{hubHtml}}}
                </div>
                {{else}}
                <h1 class="index-title">{{document.name}}</h1>
                {{/if}}
                
                <div class="library-grid">
                    {{#each pages as |page|}}
                    <div class="library-item" data-action="viewPage" data-page-id="{{page.id}}">
                        <div class="book-cover">
                            <i class="fas {{page.icon}}"></i>
                            <div class="glow-bar"></div>
                        </div>
                        <span class="book-title">{{page.name}}</span>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{else}}
            {{!-- ARTICLE VIEW --}}
            <article class="help-article">
                <header class="article-title">
                    <h1>{{activePage.name}}</h1>
                </header>
                <div class="article-body">
                    {{{contentHtml}}}
                </div>
            </article>
            {{/if}}
        </div>
    </main>
    {{/if}}
</div>
