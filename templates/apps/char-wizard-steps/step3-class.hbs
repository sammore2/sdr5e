<div class="char-wizard-step step-class">
    <div class="step-header">
        <h3><i class="fas fa-fist-raised"></i> {{localize 'THE-CODEX.Wizard.Steps.ClassTitle'}}</h3>
        <p>{{localize 'THE-CODEX.Wizard.Steps.ClassIntro'}}</p>
    </div>

    <div class="class-selector grid-3-col"
        style="display:grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 20px;">
        {{#each classes as |cls|}}
        <div class="card papiro-box class-card {{#if (eq ../data.classUuid cls.uuid)}}active{{/if}}"
            data-action="selectClass" data-uuid="{{cls.uuid}}" data-tooltip="{{cls.uuid}}"
            style="cursor:pointer; padding:10px; display:flex; gap:10px; align-items:center; border:1px solid #7a6a4a; border-radius:4px; background:rgba(0,0,0,0.2);">
            <img src="{{cls.img}}" width="40" height="40" style="border:none; border-radius:2px;" />
            <div class="class-info" style="display:flex; flex-direction:column;">
                <strong style="color:#d4af37; font-family:'Cinzel', serif; font-size:0.9rem;">{{cls.name}}</strong>
                <span style="font-size:0.75rem; color:#888;">HD {{cls.system.hitDice}}</span>
            </div>
        </div>
        {{/each}}
    </div>

    {{#if selectedClass}}
    <div class="selected-details papiro-box decorative-border"
        style="padding:15px; border:2px solid #d4af37; background:rgba(0,0,0,0.3); border-radius:6px;">

        {{!-- Cabeçalho com imagem --}}
        <div class="header-with-img" style="display:flex; gap:15px; margin-bottom:12px;">
            <img src="{{selectedClass.img}}" width="64" height="64" style="border:2px solid #7a6a4a; padding:2px;" />
            <div style="flex:1;">
                <h4
                    style="margin:0 0 6px; border-bottom:1px solid #7a6a4a; color:#dec8a0; font-family:'Cinzel', serif;">
                    {{selectedClass.name}}</h4>

                {{!-- Badges de Progressão --}}
                <div style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:6px;">
                    <span
                        style="background:rgba(0,0,0,0.4); border:1px solid #555; border-radius:10px; padding:2px 8px; font-size:0.72rem; color:#bbb;">
                        HD <strong style="color:#d4af37;">{{selectedClass.system.hitDice}}</strong>
                    </span>

                    <div class="save-badges" style="display:flex; gap:6px;">
                        {{#each selectedClass.system.progression.proficientSaves as |saveId|}}
                        <span
                            style="background:rgba(0,0,0,0.4); border:1px solid #555; border-radius:10px; padding:2px 8px; font-size:0.72rem; color:#bbb;">
                            {{localize 'THE-CODEX.Wizard.Steps.SaveAbbr'}} <strong
                                style="color:#d4af37; text-transform: uppercase;">{{saveId}}</strong>
                        </span>
                        {{/each}}
                    </div>

                    <span
                        style="background:rgba(0,0,0,0.4); border:1px solid #555; border-radius:10px; padding:2px 8px; font-size:0.72rem; color:#bbb;">
                        {{localize 'THE-CODEX.Wizard.Steps.Skills'}} <strong
                            style="color:#d4af37;">{{selectedClass.system.skills.count}} + INT</strong>
                    </span>
                    {{#if selectedClass.system.isSpellcaster}}
                    <span
                        style="background:rgba(100,50,150,0.3); border:1px solid #8060b0; border-radius:10px; padding:2px 8px; font-size:0.72rem; color:#c8a0f0;">
                        <i class="fas fa-magic"></i> {{localize 'THE-CODEX.Wizard.Steps.Caster'}}
                        ({{selectedClass.system.spellcastingAbility}})
                    </span>
                    {{/if}}
                </div>
            </div>
        </div>

        {{!-- Tabela de Progressão (gerada pelo compilador como HTML) --}}
        {{#if selectedClass.system.description}}
        <div class="class-table-wrapper class-table-scroll" data-scroll
            style="margin-bottom:12px; max-height:180px; overflow-y:auto; border:1px solid rgba(122,106,74,0.4); border-radius:4px; padding:8px; background:rgba(0,0,0,0.2); font-size:0.8rem;">
            {{{selectedClass.system.description}}}
        </div>
        {{/if}}

        {{!-- Advancements da Classe --}}
        <div class="advancements-section" style="border-top:1px solid rgba(212,175,55,0.3); padding-top:10px;">
            <h5 style="margin:0 0 10px; color:#d4af37;"><i class="fas fa-star"></i> {{localize
                'THE-CODEX.Wizard.Steps.Level1Gains'}}</h5>
            <div class="adv-list" style="display:flex; flex-direction:column; gap:5px;">
                {{#each classAdvancements as |adv idx|}}
                <div class="adv-row {{adv.type}}"
                    style="display:flex; align-items:center; gap:10px; padding:8px; background:rgba(0,0,0,0.2); border-left:3px solid {{#if (eq adv.type 'grant')}}#4a8a4a{{else}}#8a7a4a{{/if}}; border-radius:0 4px 4px 0;">
                    <i class="fas {{#if (eq adv.type 'grant')}}fa-check-circle{{else if (eq adv.type 'choice')}}fa-question-circle{{else}}fa-bolt{{/if}}"
                        style="color:{{#if (eq adv.type 'grant')}}#66bb6a{{else if (eq adv.type 'choice')}}#ffca28{{else}}#4fc3f7{{/if}};"></i>
                    <div style="flex:1;">
                        <span style="font-weight:bold; font-size:0.85rem;">{{adv.title}}</span>
                        {{#if (eq adv.type 'grant')}}
                        <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:5px;">
                            {{#each adv.items as |it|}}
                            <div class="adv-item-pill" data-tooltip="{{it.uuid}}"
                                style="display:flex; align-items:center; gap:5px; font-size:0.75rem; background:rgba(0,0,0,0.4); border:1px solid #7a6a4a; border-radius:15px; padding:2px 10px 2px 4px; color:#ddd; cursor: help; transition: all 0.2s;">
                                <img src="{{it.img}}" width="18" height="18" style="border:none; border-radius:50%;" />
                                <span>{{it.name}}</span>
                            </div>
                            {{/each}}
                        </div>
                        {{else if adv.selected}}
                        <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:5px;">
                            <div class="adv-item-pill" data-tooltip="{{adv.selected.uuid}}"
                                style="display:flex; align-items:center; gap:5px; font-size:0.75rem; background:rgba(0,0,0,0.4); border:1px solid #7a6a4a; border-radius:15px; padding:2px 10px 2px 4px; color:#ddd; cursor: help; transition: all 0.2s;">
                                <img src="{{adv.selected.img}}" width="18" height="18"
                                    style="border:none; border-radius:50%;" />
                                <span>{{adv.selected.name}}</span>
                            </div>
                        </div>
                        {{/if}}
                    </div>
                    {{#if (eq adv.type "choice")}}
                    <button type="button" class="codex-button small resolve-btn" data-action="resolveAdvancement"
                        data-idx="{{idx}}" data-origin="class" style="padding:4px 8px; font-size:0.75rem;">
                        {{#if adv.selected}}{{localize 'THE-CODEX.Wizard.Steps.Change'}}
                        {{adv.selected.name}}{{else}}{{localize 'THE-CODEX.Wizard.Steps.Choose'}}{{/if}}
                    </button>
                    {{/if}}
                </div>
                {{/each}}
            </div>
        </div>
        {{/if}}
    </div>