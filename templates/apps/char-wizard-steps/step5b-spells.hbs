<div class="char-wizard-step step-spells">
    <div class="header-section">
        <h2 class="runic-header">{{localize 'THE-CODEX.Wizard.Steps.SpellsTitle'}}</h2>
        <p>{{localize 'THE-CODEX.Wizard.Steps.SpellsIntro'}}</p>
        
        <div class="spell-pools" style="display:flex; gap:20px; margin: 15px 0; padding:10px; background:rgba(0,0,0,0.2); border:1px solid #7a6a4a; border-radius:4px;">
            <div class="pool-badge c0" style="flex:1; text-align:center;">
                <span class="label" style="display:block; font-size:0.8rem; color:#888;">{{localize 'THE-CODEX.Wizard.Steps.CantripsPool'}}</span>
                <span class="value" style="font-size:1.2rem; font-family:'Cinzel', serif; color:#d4af37;">
                    {{#if spellPools.infinite0}}∞ / ∞{{else}}{{spellPools.c0}} / {{spellPools.max0}}{{/if}}
                </span>
            </div>
            <div class="pool-badge c1" style="flex:1; text-align:center;">
                <span class="label" style="display:block; font-size:0.8rem; color:#888;">{{localize 'THE-CODEX.Wizard.Steps.Circle1Pool'}}</span>
                <span class="value" style="font-size:1.2rem; font-family:'Cinzel', serif; color:#d4af37;">
                    {{#if spellPools.infinite1}}∞ / ∞{{else}}{{spellPools.c1}} / {{spellPools.max1}}{{/if}}
                </span>
            </div>
        </div>
    </div>

    <div class="spells-scroll-area" data-scroll style="max-height:500px; overflow-y:auto; padding-right:10px;">
        {{#if level0Spells.length}}
        <h3 class="section-title" style="border-bottom:1px solid #7a6a4a; margin: 15px 0 10px 0; font-family:'Cinzel', serif; color:#dec8a0;">{{localize 'THE-CODEX.Wizard.Steps.CantripsKnown'}}</h3>
        <div class="spells-grid" style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
            {{#each level0Spells}}
            <div class="spell-card papiro-box {{#if selected}}selected{{/if}}" 
                 style="position:relative; display:flex; align-items:center; gap:10px; padding:8px; background:{{#if selected}}rgba(212,175,55,0.15){{else}}rgba(0,0,0,0.3){{/if}}; border:1px solid {{#if selected}}#d4af37{{else}}rgba(122,106,74,0.4){{/if}}; border-radius:4px; cursor:pointer;"
                 data-action="toggleSpell" data-uuid="{{uuid}}" data-tooltip="{{uuid}}">
                <img src="{{img}}" width="36" height="36" style="border-radius:2px; border:1px solid #7a6a4a;"/>
                <div class="spell-info" style="overflow:hidden;">
                    <span class="spell-name" style="display:block; font-size:0.9rem; white-space:nowrap; text-overflow:ellipsis; overflow:hidden;">{{name}}</span>
                </div>
                {{#if selected}}
                <div style="position:absolute; top:-5px; right:-5px; background:#d4af37; color:#000; width:16px; height:16px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.6rem; border:1px solid #000;">
                    <i class="fas fa-check"></i>
                </div>
                {{/if}}
            </div>
            {{/each}}
        </div>
        {{/if}}

        {{#if level1Spells.length}}
        <h3 class="section-title" style="border-bottom:1px solid #7a6a4a; margin: 25px 0 10px 0; font-family:'Cinzel', serif; color:#dec8a0;">{{localize 'THE-CODEX.Wizard.Steps.Circle1Spells'}}</h3>
        <div class="spells-grid" style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
            {{#each level1Spells}}
            <div class="spell-card papiro-box {{#if selected}}selected{{/if}}" 
                 style="position:relative; display:flex; align-items:center; gap:10px; padding:8px; background:{{#if selected}}rgba(212,175,55,0.15){{else}}rgba(0,0,0,0.3){{/if}}; border:1px solid {{#if selected}}#d4af37{{else}}rgba(122,106,74,0.4){{/if}}; border-radius:4px; cursor:pointer;"
                 data-action="toggleSpell" data-uuid="{{uuid}}" data-tooltip="{{uuid}}">
                <img src="{{img}}" width="36" height="36" style="border-radius:2px; border:1px solid #7a6a4a;"/>
                <div class="spell-info" style="overflow:hidden;">
                    <span class="spell-name" style="display:block; font-size:0.9rem; white-space:nowrap; text-overflow:ellipsis; overflow:hidden;">{{name}}</span>
                </div>
                {{#if selected}}
                <div style="position:absolute; top:-5px; right:-5px; background:#d4af37; color:#000; width:16px; height:16px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.6rem; border:1px solid #000;">
                    <i class="fas fa-check"></i>
                </div>
                {{/if}}
            </div>
            {{/each}}
        </div>
        {{/if}}
        
        {{#unless availableSpells.length}}
        <div style="text-align:center; padding:40px; color:#666;">
            <i class="fas fa-magic" style="font-size:3rem; display:block; margin-bottom:10px; opacity:0.3;"></i>
            {{localize 'THE-CODEX.Wizard.Steps.NoSpells'}}
        </div>
        {{/unless}}
    </div>
</div>
