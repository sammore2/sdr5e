<div class="char-wizard-step step-skills">
    <div class="step-header">
        <h3><i class="fas fa-book-open"></i> {{localize 'THE-CODEX.Wizard.Steps.SkillsTitle'}}</h3>
        <p>{{localize 'THE-CODEX.Wizard.Steps.SkillsIntro'}}</p>
    </div>

    <div class="skills-container papiro-box decorative-border" style="padding:15px; background:rgba(0,0,0,0.3); border:2px solid #7a6a4a; border-radius:6px;">

        {{!-- Header com contador Moderno --}}
        <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:15px; padding-bottom:10px; border-bottom:1px solid rgba(122,106,74,0.5);">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <span style="font-family:'Cinzel', serif; font-size:1rem; color:#d4af37;">{{localize 'THE-CODEX.Wizard.Steps.Skills'}}</span>
                    <span style="font-size:1.4rem; font-weight:bold; margin-left:8px; color:{{#if (lte skillPointsRemaining 0)}}#e57373{{else}}#ffffff{{/if}};">{{skillPointsRemaining}}</span>
                </div>
            </div>
            <div style="font-size:0.7rem; color:#888; text-transform:uppercase; letter-spacing:0.5px; opacity:0.8;">
                <i class="fas fa-info-circle"></i> {{localize 'THE-CODEX.Wizard.SkillInfo' bonus=proficiencyBonus}}
            </div>
        </div>

        {{!-- Grid de Perícias Unificada (18 Itens) --}}
        <div class="skills-grid-scroll" data-scroll style="display:grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap:10px; max-height:450px; overflow-y:auto; padding-right:8px;">
            {{#each processedSkills as |obj key|}}
            <div class="skill-row" style="display:flex; align-items:center; gap:12px; padding:10px;
                        background:{{#if (lookup ../data.skills key)}}rgba(212,175,55,0.15){{else}}rgba(0,0,0,0.2){{/if}};
                        border:2px solid {{#if (lookup ../data.skills key)}}#d4af37{{else}}rgba(122,106,74,0.3){{/if}};
                        border-radius:6px; transition: all 0.2s; position:relative;">

                {{!-- Modern Toggle Button --}}
                <button type="button" data-action="adjustSkill" data-key="{{key}}" data-delta="{{#if (lookup ../data.skills key)}}-1{{else}}1{{/if}}"
                        style="width:28px; height:28px; border:1px solid #7a6a4a; border-radius:50%; 
                               background:{{#if (lookup ../data.skills key)}}#d4af37{{else}}transparent{{/if}};
                               color:{{#if (lookup ../data.skills key)}}#111{{else}}#7a6a4a{{/if}}; 
                               display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0;">
                    {{#if (lookup ../data.skills key)}}<i class="fas fa-check"></i>{{else}}<i class="far fa-circle"></i>{{/if}}
                </button>

                {{!-- Nome e Atributo com Tratamento de Overflow --}}
                <div style="flex:1; min-width:0;" data-tooltip="{{localize obj.label}} ({{obj.ability}})">
                    <div style="font-size:0.9rem; font-weight:bold; color:{{#if (lookup ../data.skills key)}}#fff{{else}}#bbb{{/if}}; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        {{localize obj.label}}
                    </div>
                    <div style="font-size:0.65rem; color:#888; text-transform:uppercase; display:flex; align-items:center; gap:5px;">
                        <span>{{obj.ability}}</span>
                        {{#if obj.isClassSkill}}<span style="color:#d4af37; font-size:0.8rem;" title="{{localize 'THE-CODEX.Wizard.Steps.ClassSkill'}}">★</span>{{/if}}
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>
