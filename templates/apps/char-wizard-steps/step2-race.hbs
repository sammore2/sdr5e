<div class="char-wizard-step step-race">
    <div class="step-header">
        <h3><i class="fas fa-venus-double"></i> {{localize 'THE-CODEX.Wizard.Steps.RaceTitle'}}</h3>
        <p>{{localize 'THE-CODEX.Wizard.Steps.RaceIntro'}}</p>
    </div>

    <div class="race-selector grid-3-col"
        style="display:grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 20px;">
        {{#each races as |race|}}
        <div class="card papiro-box race-card {{#if (eq ../data.raceUuid race.uuid)}}active{{/if}}"
            data-action="selectRace" data-uuid="{{race.uuid}}" data-tooltip="{{race.uuid}}"
            style="cursor:pointer; padding:10px; display:flex; gap:10px; align-items:center; border:1px solid #7a6a4a; border-radius:4px; background:rgba(0,0,0,0.2);">
            <img src="{{race.img}}" width="40" height="40" style="border:none; border-radius:2px;" />
            <div class="race-info" style="display:flex; flex-direction:column;">
                <strong style="color:#d4af37; font-family:'Cinzel', serif; font-size:0.9rem;">{{race.name}}</strong>
                <span style="font-size:0.75rem; color:#888;">{{race.system.size}} | {{race.system.speed}}m</span>
            </div>
        </div>
        {{/each}}
    </div>

    {{#if selectedRace}}
    <div class="selected-details papiro-box decorative-border"
        style="padding:15px; border:2px solid #d4af37; background:rgba(0,0,0,0.3); border-radius:6px; position:relative;">
        <div class="header-with-img" style="display:flex; gap:15px; margin-bottom:10px;">
            <img src="{{selectedRace.img}}" width="64" height="64" style="border:2px solid #7a6a4a; padding:2px;" />
            <div style="flex:1;">
                <h4 style="margin:0; color:#dec8a0; font-family:'Cinzel', serif; border-bottom:1px solid #7a6a4a;">
                    {{selectedRace.name}}</h4>
                <div style="font-size:0.85rem; margin-top:5px; color:#bbb;">{{{selectedRace.system.description}}}</div>
            </div>
        </div>

        {{!-- Advancements da Raça --}}
        <div class="advancements-section"
            style="margin-top:15px; border-top:1px solid rgba(212,175,55,0.3); padding-top:10px;">
            <h5 style="margin:0 0 10px; color:#d4af37;"><i class="fas fa-magic"></i> {{localize
                'THE-CODEX.Wizard.Steps.RaceTraits'}}</h5>
            <div class="adv-list" style="display:flex; flex-direction:column; gap:8px;">
                {{#each raceAdvancements as |adv idx|}}
                <div class="adv-row {{adv.type}}"
                    style="display:flex; flex-direction:column; gap:5px; padding:10px; background:rgba(0,0,0,0.2); border-left:3px solid {{#if (eq adv.type 'grant')}}#4a8a4a{{else}}#8a7a4a{{/if}}; border-radius:0 4px 4px 0;">
                    <div style="display:flex; align-items:center; gap:10px;">
                        <i class="fas {{#if (eq adv.type 'grant')}}fa-check-circle{{else}}fa-question-circle{{/if}}"
                            style="color:{{#if (eq adv.type 'grant')}}#66bb6a{{else}}#ffca28{{/if}};"></i>
                        <div style="flex:1;">
                            <span style="font-weight:bold; font-size:0.9rem; color:#f0e6c8;"
                                data-tooltip="{{adv.description}}">{{adv.title}}</span>
                            <div style="font-size:0.75rem; color:#999;">{{adv.category}}</div>
                        </div>
                        {{#if (eq adv.type "choice")}}
                        <button type="button" class="codex-button small resolve-btn" data-action="resolveAdvancement"
                            data-idx="{{idx}}" data-origin="race" style="padding:4px 8px; font-size:0.75rem;">
                            {{#if adv.selected}}{{localize 'THE-CODEX.Wizard.Steps.Change'}}
                            {{adv.selected.name}}{{else}}{{localize 'THE-CODEX.Wizard.Steps.Choose'}}{{/if}}
                        </button>
                        {{/if}}
                    </div>

                    {{#if adv.items}}
                    <div class="adv-items-list"
                        style="display:flex; flex-wrap:wrap; gap:6px; margin-top:5px; padding-left:26px;">
                        {{#each adv.items as |it|}}
                        <div class="adv-item-pill" data-tooltip="{{it.uuid}}"
                            style="display:flex; align-items:center; gap:5px; background:rgba(212,175,55,0.1); border:1px solid rgba(212,175,55,0.3); border-radius:4px; padding:2px 8px; font-size:0.75rem; color:#eee; cursor: help;">
                            <img src="{{it.img}}" width="16" height="16" style="border:none;" />
                            <span>{{it.name}}</span>
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}
                    {{#if adv.selected}}
                    <div class="adv-items-list"
                        style="display:flex; flex-wrap:wrap; gap:6px; margin-top:5px; padding-left:26px;">
                        <div class="adv-item-pill" data-tooltip="{{adv.selected.uuid}}"
                            style="display:flex; align-items:center; gap:5px; background:rgba(212,175,55,0.1); border:1px solid rgba(212,175,55,0.3); border-radius:4px; padding:2px 8px; font-size:0.75rem; color:#eee; cursor: help;">
                            <img src="{{adv.selected.img}}" width="16" height="16" style="border:none;" />
                            <span>{{adv.selected.name}}</span>
                        </div>
                    </div>
                    {{/if}}
                </div>
                {{/each}}
            </div>
        </div>
    </div>
    {{/if}}
</div>