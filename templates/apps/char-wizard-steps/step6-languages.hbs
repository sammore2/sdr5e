    <h3 class="step-title" style="font-family:'Cinzel', serif; color:#d4af37; border-bottom:1px solid rgba(212,175,55,0.3); padding-bottom:10px; margin-bottom:10px;">
        <i class="fas fa-language"></i> {{localize 'THE-CODEX.Wizard.Steps.LanguagesTitle'}}
    </h3>
    
    <div class="instruction-box papiro-bg" style="padding:15px; border:1px solid #7a6a4a; border-radius:4px; background:rgba(0,0,0,0.4); font-size:0.95rem; line-height:1.5;">
        <p>{{localize 'THE-CODEX.Wizard.Steps.LanguagesIntro' count=nonFreeLanguagesCount max=maxLanguages}}</p>
    </div>

    <div class="languages-grid" style="display:grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap:12px; max-height:400px; overflow-y:auto; padding-right:10px;" data-scroll>
        {{#each availableLanguages as |lang|}}
        <div class="lang-option {{#if (includes ../data.selectedLanguages lang.uuid)}}selected{{/if}}" 
             data-action="toggleLanguage" 
             data-uuid="{{lang.uuid}}"
             style="display:flex; align-items:center; gap:12px; padding:10px; border:1px solid #555; border-radius:6px; cursor:pointer; background:rgba(0,0,0,0.2); transition:all 0.2s; border-left:4px solid {{#if (includes ../data.selectedLanguages lang.uuid)}}#d4af37{{else}}#555{{/if}};">
            
            <img src="{{lang.img}}" width="32" height="32" style="border-radius:3px; border:1px solid rgba(255,255,255,0.1);"/>
            
            <div style="flex:1;">
                <span style="font-size:0.9rem; font-weight:bold; color:{{#if (includes ../data.selectedLanguages lang.uuid)}}#d4af37{{else}}#eee{{/if}};">{{lang.name}}</span>
            </div>

            <div class="check-indicator">
                {{#if (includes ../data.selectedLanguages lang.uuid)}}
                    <i class="fas fa-check-circle" style="color:#d4af37;"></i>
                {{else}}
                    <i class="far fa-circle" style="color:#555;"></i>
                {{/if}}
            </div>
        </div>
        {{/each}}
    </div>

    <div class="step-footer-hint" style="font-size:0.8rem; color:#aaa; font-style:italic; margin-top:10px; display:flex; gap:8px; align-items:center;">
        <i class="fas fa-info-circle" style="color:#d4af37;"></i>
        <span>{{localize 'THE-CODEX.Wizard.Steps.LanguagesHint'}}</span>
    </div>
</section>

<style>
    .lang-option:hover {
        background: rgba(212,175,55,0.1) !important;
        border-color: #d4af37 !important;
    }
    .lang-option.selected {
        background: rgba(212,175,55,0.15) !important;
        box-shadow: 0 0 10px rgba(212,175,55,0.1);
    }
</style>
