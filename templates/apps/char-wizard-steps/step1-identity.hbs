<div class="char-wizard-step step-identity">
    <div class="intro-text">
        <p>{{localize 'THE-CODEX.Wizard.Steps.IdentityIntro'}}</p>
    </div>

    <div class="form-group papiro-box">
        <label><i class="fas fa-signature"></i> {{localize 'THE-CODEX.Wizard.Steps.NameLabel'}}</label>
        <input type="text" name="name" value="{{data.name}}" placeholder="{{localize 'THE-CODEX.Wizard.Steps.NamePlaceholder'}}" required/>
    </div>


    <div class="form-group papiro-box">
        <label><i class="fas fa-venus-mars"></i> {{localize 'THE-CODEX.Wizard.Steps.GenderLabel'}}</label>
        <input type="text" name="gender" value="{{data.gender}}" placeholder="{{localize 'THE-CODEX.Wizard.Steps.GenderPlaceholder'}}"/>
    </div>

    <div class="form-group papiro-box">
        <label><i class="fas fa-feather-pointed"></i> {{localize 'THE-CODEX.Wizard.Steps.BioLabel'}}</label>
        <textarea name="bio" rows="4" placeholder="{{localize 'THE-CODEX.Wizard.Steps.BioPlaceholder'}}">{{data.bio}}</textarea>
    </div>
</div>
