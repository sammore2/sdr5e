<div class="codex-talents-v3">
    {{!-- Coluna Esquerda: Habilidades de Raça --}}
    <aside class="talents-sidebar">
        <header class="sidebar-header">
            <span>{{localize 'THE-CODEX.Powers.RacialAbilities'}}</span>
            <button type="button" class="item-create-btn" data-action="createItem" data-item-type="feature" data-feat-type="racial">
                <i class="fas fa-plus"></i>
            </button>
        </header>
        <ul class="compact-feat-list">
            {{#each habilidades as |item|}}
            <li class="compact-feat feature-item {{#if (and (eq item.system.activationTrigger 'none') (not item.system.uses.max))}}passive-racial{{/if}}" data-item-id="{{item.id}}" data-tooltip="{{item.uuid}}">
                <img src="{{item.img}}" alt="{{item.name}}" data-action="openItem">
                <span class="feat-name-text" data-action="openItem">{{item.name}}</span>
                <div class="feat-controls">
                    {{#if (eq item.system.activationTrigger 'manual')}}
                    <i class="fas fa-power-off toggle-feat {{#if item.system.auraEffect.enabled}}active{{/if}}" 
                       data-action="useItem" data-item-id="{{item.id}}" title="Ativar/Desativar"></i>
                    {{/if}}
                    <i class="fas fa-edit inv-edit" data-action="openItem" title="Editar"></i>
                    <i class="fas fa-trash inv-delete" data-action="deleteItem" title="Excluir"></i>
                </div>
            </li>
            {{else}}
            <p class="placeholder-text" style="font-size: 0.6rem; opacity: 0.5;">{{localize 'THE-CODEX.Powers.EmptyRacial'}}</p>
            {{/each}}
        </ul>
    </aside>

    {{!-- Coluna Central: Árvore de Talentos de Classe --}}
    <main class="tree-main-track">
        {{#if talentTree.hasPath}}
            <div class="path-header-v3" data-tooltip="{{talentTree.uuid}}">
                <div class="path-title-row">
                    <h2 class="runic-header" style="font-size: 1.2rem; margin: 0;">
                        {{talentTree.name}} 
                        {{#if talentTree.currentTier}}
                            <span class="path-tier-badge">Tier {{talentTree.currentTier}}</span>
                        {{/if}}
                    </h2>
                    <i class="fas fa-trash inv-delete" data-action="deleteItem" data-item-id="{{talentTree.id}}" data-is-path="true" data-tooltip="{{localize 'THE-CODEX.Powers.ResetPath'}}" style="font-size: 0.8rem; margin-left: 10px; cursor: pointer; opacity: 0.5;"></i>
                </div>
                <div class="path-decoration"></div>
            </div>

            <div class="talent-tree-hierarchy">
                {{#each talentTree.tiers as |tier|}}
                    <div class="talent-node-wrapper">
                        <div class="talent-node-classic {{#if tier.active}}active{{else if tier.available}}available{{else}}locked{{/if}} {{#if tier.empty}}empty-slot{{/if}}" 
                             data-item-id="{{tier.id}}" 
                             data-identifier="{{tier.identifier}}"
                             data-uuid="{{tier.uuid}}"
                             {{#if tier.cost}}data-cost="{{tier.cost}}"{{/if}}
                             data-tooltip="{{#if tier.active}}{{tier.uuid}}{{else if tier.empty}}<strong>Tier Bloqueado</strong><br>Este caminho ainda não possui este talento definido.{{else}}<strong>{{tier.name}}</strong><br>Desbloqueia no Nível {{tier.level}}{{/if}}"
                             {{#if tier.active}}data-action="openItem"{{/if}}
                             {{#if tier.available}}data-action="purchaseTalent"{{/if}}>
                                
                                <div class="node-icon-square">
                                    <img src="{{tier.img}}" alt="{{tier.name}}" {{#if tier.empty}}style="opacity: 0.1;"{{/if}}>
                                </div>
                                <div class="node-label">
                                    <span class="tier-num">T{{add @index 1}}</span>
                                    <span class="feat-name">{{#if tier.empty}}Indisponível{{else}}{{tier.name}}{{/if}}</span>
                                </div>
                            </div>
                            <!-- Conector visual para o próximo node -->
                            <div class="node-connector"></div>
                    </div>
                {{/each}}
            </div>
        {{else}}
            <div class="no-path-warning" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 20px; text-align: center; color: var(--codex-gold-muted, #c1a064); background: rgba(0,0,0,0.2); border: 1px dashed var(--codex-gold-muted, #c1a064); border-radius: 8px;">
                <i class="fas fa-route" style="font-size: 2.5rem; margin-bottom: 15px; opacity: 0.5;"></i>
                <h3 style="font-family: 'Cinzel', serif; font-size: 1.2rem; color: var(--codex-gold, #d4af37); margin: 0 0 5px 0;">{{localize 'THE-CODEX.Powers.NoPath'}}</h3>
                <p style="font-size: 0.85rem; opacity: 0.8; margin: 0; max-width: 300px;">
                    {{#if (gte system.details.level 3)}}
                        {{localize 'THE-CODEX.Powers.NoPathLvl3'}}
                    {{else}}
                        {{localize 'THE-CODEX.Powers.NoPathLvl1'}}
                    {{/if}}
                </p>
            </div>
        {{/if}}
    </main>

    {{!-- Coluna Direita: Talentos Gerais (Build) --}}
    <aside class="talents-sidebar">
        <header class="sidebar-header">
            <span>{{localize 'THE-CODEX.Powers.ActiveCombat'}}</span>
            <button type="button" class="item-create-btn" data-action="createItem" data-item-type="feature" data-feat-type="general">
                <i class="fas fa-plus"></i>
            </button>
        </header>
        
        <div class="general-feats-grid">
            {{#each feats.active as |group groupKey|}}
                {{#if group.length}}
                    <div class="feat-category-mini">
                        <small class="category-label">{{localize (concat "THE-CODEX.FeatTypes." groupKey)}}</small>
                        <ul class="compact-feat-list">
                            {{#each group as |item|}}
                            <li class="compact-feat feature-item" data-item-id="{{item.id}}" data-tooltip="{{item.uuid}}">
                                <img src="{{item.img}}" alt="{{item.name}}" data-action="openItem">
                                <span class="feat-name-text" data-action="openItem">{{item.name}}</span>
                                <div class="feat-controls">
                                    {{#if (eq item.system.activationTrigger 'manual')}}
                                    <i class="fas fa-power-off toggle-feat {{#if item.system.auraEffect.enabled}}active{{/if}}" 
                                       data-action="useItem" data-item-id="{{item.id}}" title="Ativar/Desativar"></i>
                                    {{/if}}
                                </div>
                            </li>
                            {{/each}}
                        </ul>
                    </div>
                {{/if}}
            {{/each}}
        </div>

        {{#if (or passiveTraits feats.passive.length)}}
        <header class="sidebar-header" style="margin-top: 15px; border-top: 1px solid rgba(0,0,0,0.1); padding-top: 10px;">
            <span>{{localize 'THE-CODEX.Powers.PassiveTraits'}}</span>
        </header>
        <ul class="compact-feat-list">
            {{#each passiveTraits as |item|}}
            <li class="compact-feat feature-item passive" data-item-id="{{item.id}}" data-tooltip="{{item.uuid}}">
                <img src="{{item.img}}" alt="{{item.name}}" data-action="openItem" style="filter: grayscale(1); opacity: 0.7;">
                <span class="feat-name-text" data-action="openItem" style="font-style: italic; color: #999;">{{item.name}}</span>
            </li>
            {{/each}}
            {{#each feats.passive as |item|}}
            <li class="compact-feat feature-item passive" data-item-id="{{item.id}}" data-tooltip="{{item.uuid}}">
                <img src="{{item.img}}" alt="{{item.name}}" data-action="openItem" style="filter: grayscale(1); opacity: 0.7;">
                <span class="feat-name-text" data-action="openItem" style="font-style: italic; color: #999;">{{item.name}}</span>
            </li>
            {{/each}}
        </ul>
        {{/if}}
    </aside>
</div>
