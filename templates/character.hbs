<div class="{{cssClass}} the-codex codex-sheet-v2">
    <div class="the-codex-v13-root">

        {{!-- SIDEBAR (COLUMN 1 - 260px) --}}
        <aside class="sidebar-container-v13">

            {{!-- 1. Cabeçalho de Identidade (Topo) --}}
            <div class="sidebar-identity-v13 premium-header-v13">
                <input name="name" type="text" class="charname-hobbs" value="{{name}}"
                    placeholder="{{localize 'THE-CODEX.Sheet.Hero'}}" />
                <div class="char-identity-row-v13">
                    <div class="classes-container-v13" style="width: 100%; display: flex; justify-content: center;">
                        {{#each classes as |cls|}}
                        <div class="class-badge clickable" data-tooltip="{{cls.uuid}}" data-item-id="{{cls._id}}"
                            data-action="openItem">
                            <img src="{{cls.img}}" class="mini-icon-v13" />
                            <span>{{cls.name}} {{cls.system.levels}}</span>
                            <i class="fas fa-times delete-btn-v13" data-action="deleteItem"
                                data-item-id="{{cls._id}}"></i>
                        </div>
                        {{#unless @last}}<span class="sep-v13">/</span>{{/unless}}
                        {{else}}
                        <div class="class-badge empty clickable" data-step="class" data-action="openWizard">
                            <span>{{localize 'THE-CODEX.Sheet.AddClass'}}</span>
                        </div>
                        {{/each}}
                    </div>
                </div>

                <div class="char-identity-row-v13 sub-identity" style="margin-top: 5px;">
                    <div class="armor-badge armor-status {{#if system.attributes.armor.penalty}}penalty{{/if}}"
                        data-tooltip="{{#if system.attributes.armor.penalty}}{{localize 'THE-CODEX.Messages.ArmorPenaltyTooltip'}}{{else}}{{localize 'THE-CODEX.Inventory.ArmorTypes.header'}}{{/if}}"
                        data-category="{{system.attributes.armor.category}}">
                        <i
                            class="fas {{#if system.attributes.armor.penalty}}fa-triangle-exclamation{{else}}fa-shield-halved{{/if}}"></i>
                        <span>{{system.attributes.armor.categoryLabel}}</span>
                    </div>
                </div>
                <div class="player-name-row-v13">
                    <input name="system.details.player" type="text" value="{{system.details.player}}"
                        placeholder="{{localize 'THE-CODEX.Sheet.PlayerPrompt'}}" />
                </div>
            </div>

            {{!-- 2. Retrato + Escudo Sobreposto --}}
            <div class="portrait-module-v13">
                <div class="portrait-frame-v13">
                    <img class="profile-img-hobbs" src="{{actorImg}}" title="{{name}}" data-action="editImage"
                        data-field="img" data-edit="img" />
                </div>

                {{!-- Mini Efeitos Ativos (Agora sobre o retrato) --}}
                <div class="active-effects-tray">
                    {{#each activeEffects as |effect|}}
                    <div class="mini-effect-icon {{#if effect.disabled}}disabled{{/if}}" data-action="deleteEffect"
                        data-effect-id="{{effect.id}}"
                        data-tooltip="{{effect.name}} — {{#if effect.disabled}}Desativado{{else}}Ativo{{/if}} (clique para remover)">
                        <img src="{{effect.img}}" alt="{{effect.name}}">
                    </div>
                    {{/each}}
                </div>

                {{!-- Defesa (Escudo Sobreposto) --}}
                <div class="ac-shield-hobbs overlapping-shield-v13" data-tooltip="{{defenseTooltip}}">
                    <svg class="shield-svg" viewBox="0 0 100 120">
                        <path d="M50,5 L90,20 L90,60 C90,85 70,105 50,115 C30,105 10,85 10,60 L10,20 L50,5 Z"
                            fill="rgba(30,28,25,0.98)" stroke="#c1a064" stroke-width="4" />
                    </svg>
                    <div class="ac-content">
                        <label class="ac-label-v13">{{localize 'THE-CODEX.Sheet.Defense'}}</label>
                        <span class="ac-value">{{system.attributes.da.value}}</span>
                        <div class="ac-mod-inputs-v13">
                            <input type="number" name="system.attributes.da.magic"
                                value="{{system.attributes.da.magic}}" title="Extra" />
                            <span class="sep">/</span>
                            <input type="number" name="system.attributes.da.bonus"
                                value="{{system.attributes.da.bonus}}" title="Bônus" />
                        </div>
                    </div>
                </div>
            </div>



            <div class="sidebar-diamond-stats-v13">
                <div class="diamond-col-left">
                    <div class="diamond-stat-v13 rollable" data-action="rollInitiative"
                        title="{{localize 'THE-CODEX.Sheet.Initiative'}}">
                        <span class="stat-val">{{numberFormat system.attributes.initiative.total sign=true}}</span>
                        <label>{{localize 'THE-CODEX.Sheet.Initiative'}}</label>
                    </div>
                    <div class="strain-pips-side">
                        {{#each strainPips as |pip|}}
                        {{#if (lt pip.value 4)}}
                        <div class="strain-pip {{#if pip.active}}active{{/if}}" data-action="toggleStrain"
                            data-value="{{pip.value}}"></div>
                        {{/if}}
                        {{/each}}
                    </div>
                </div>

                <div class="diamond-center-shield"></div>

                <div class="diamond-col-right">
                    <div class="diamond-stat-v13" title="{{localize 'THE-CODEX.Sheet.ProfShort'}}">
                        <span class="stat-val">+{{system.attributes.prof.value}}</span>
                        <label>{{localize 'THE-CODEX.Sheet.ProficiencyAbbr'}}</label>
                    </div>
                    <div class="strain-pips-side">
                        {{#each strainPips as |pip|}}
                        {{#if (gte pip.value 4)}}
                        <div class="strain-pip {{#if pip.active}}active{{/if}}" data-action="toggleStrain"
                            data-value="{{pip.value}}"></div>
                        {{/if}}
                        {{/each}}
                    </div>
                </div>
            </div>


            {{!-- 4. Recursos (Mobilidade + HP + Hit Dice) --}}
            <div class="sidebar-resources-v13">
                {{!-- Novo Badge de Mobilidade --}}
                <div class="sidebar-mobility-v13">
                    <div class="mobility-label">
                        <i class="fas fa-wind"></i>
                        <span>{{localize 'THE-CODEX.Sheet.Speed'}}</span>
                    </div>
                    <input type="text" name="system.attributes.speed.value"
                        value="{{#if system.attributes.speed.value}}{{system.attributes.speed.value}}{{else}}9m{{/if}}" />
                </div>

                {{!-- HP Module --}}
                <div class="hp-module-v13">
                    <div class="hp-info-row">
                        <label>{{localize 'THE-CODEX.HP'}}</label>
                        <div class="hp-inputs">
                            <input type="number" name="system.resources.health.value"
                                value="{{system.resources.health.value}}" />
                            <span>/</span>
                            <span class="max">{{system.resources.health.max}}</span>
                        </div>
                    </div>
                    <div class="hp-track-v13">
                        <div class="hp-fill-v13 {{hpColorClass}}"
                            style="width: {{pct system.resources.health.value system.resources.health.max}}%;"></div>
                    </div>
                </div>

                {{!-- Primary Class Resource (Agnostic) --}}
                {{#if hasPrimaryResource}}
                <div
                    class="primary-resource-module-v13 {{system.resources.primary.label}} {{#if useBoxes}}paper-style{{/if}}">
                    <div class="res-info-row">
                        <label>{{system.resources.primary.label}}</label>
                        <div class="res-inputs">
                            <input type="number" name="system.resources.primary.value"
                                value="{{system.resources.primary.value}}" />
                            <span>/</span>
                            <span class="max">{{system.resources.primary.max}}</span>
                        </div>
                    </div>

                    {{#if useBoxes}}
                    <div class="resource-boxes">
                        {{#each primaryBoxes as |box|}}
                        <div class="resource-box {{#if box.filled}}filled{{/if}}" data-action="toggleResourceBox"
                            data-id="{{box.id}}"></div>
                        {{/each}}
                    </div>
                    {{else}}
                    <div class="res-track-v13">
                        <div class="res-fill-v13"
                            style="width: {{pct system.resources.primary.value system.resources.primary.max}}%;"></div>
                    </div>
                    {{/if}}
                </div>
                {{/if}}



                <div class="secondary-resource-row-v13">
                </div>
            </div>

            {{!-- 5. Sorte (Luck) --}}
            <div class="sidebar-luck-v13">
                <h3 class="luck-title">{{localize 'THE-CODEX.Resources.Luck'}}</h3>
                <div class="luck-pips-container">
                    {{#each luckPips as |pip|}}
                    <div class="luck-pip {{#if pip.active}}active{{/if}}" data-action="spendLuck" data-amount="1"
                        data-tooltip="{{localize 'THE-CODEX.Resources.SpendLuck'}} ({{pip.value}})">
                        <i class="fas fa-sun"></i>
                    </div>
                    {{/each}}
                </div>
            </div>

            {{!-- 6. Bússola de Ressonância (Base) --}}
            <div class="resonance-mini papiro-bg sidebar-alignment-v13">
                <h3 class="alignment-title">{{localize 'THE-CODEX.Sheet.Alignment'}}</h3>
                <div class="compass-svg-wrapper">
                    <svg width="110" height="110" viewBox="0 0 120 120" data-action="adjustAlignment" class="clickable">
                        <line x1="10" y1="60" x2="110" y2="60" stroke="#7a6a4a" stroke-width="1" opacity="0.5" />
                        <line x1="60" y1="10" x2="60" y2="110" stroke="#7a6a4a" stroke-width="1" opacity="0.5" />
                        <circle cx="60" cy="60" r="45" fill="none" stroke="#7a6a4a" stroke-dasharray="3,3"
                            opacity="0.3" />
                        <circle cx="60" cy="60" r="15" fill="none" stroke="#4a1a1a" opacity="0.5" />
                        <text x="60" y="8" text-anchor="middle" class="compass-label-v13">{{localize
                            'THE-CODEX.Sheet.Good'}}</text>
                        <text x="60" y="118" text-anchor="middle" class="compass-label-v13">{{localize
                            'THE-CODEX.Sheet.Evil'}}</text>
                        <text x="0" y="63" text-anchor="start" class="compass-label-v13">{{localize
                            'THE-CODEX.Sheet.Law'}}</text>
                        <text x="120" y="63" text-anchor="end" class="compass-label-v13">{{localize
                            'THE-CODEX.Sheet.Chaos'}}</text>
                        {{#if resonanceCompass}}
                        <circle cx="{{resonanceCompass.xSm}}" cy="{{resonanceCompass.ySm}}" r="5" fill="#ff0000"
                            filter="drop-shadow(0 0 4px #ff0000)" />
                        {{/if}}
                    </svg>
                </div>
            </div>

        </aside>

        {{!-- MAIN CONTENT (COLUMN 2) --}}
        <main class="main-content-container-v13">

            {{!-- Header (Atributos) --}}
            <header class="main-header-v13">
                <div id="codex-v13-header-root">
                    <div class="header-main-flex-v13">
                        <div class="header-left-empty-v13"></div>
                        <div class="attributes-flex-container">
                            {{#each system.abilities as |ability id|}}
                            <div class="ability-group-v13">
                                <div class="attribute-circle-v13 rollable {{#if ability.hasBonus}}bonus-active{{/if}}"
                                    data-ability="{{id}}" data-action="rollAbility" data-tooltip="{{ability.tooltip}}">
                                    <span class="label">{{lookup ../abilityLabels id}}</span>
                                    <div class="attribute-value-container">
                                        <input type="number" name="system.abilities.{{id}}.value"
                                            value="{{ability.value}}"
                                            class="attribute-value-center {{#if ability.hasBonus}}has-bonus-field{{/if}}"
                                            onclick="event.stopPropagation()">
                                        {{#if ability.hasBonus}}
                                        <span class="attribute-value-total"
                                            data-tooltip="{{localize 'THE-CODEX.Combat.Total'}}: {{ability.total}}">{{ability.total}}</span>
                                        {{/if}}
                                    </div>
                                    <span
                                        class="modifier-seal-bottom {{#if ability.isCapped}}is-capped{{/if}} {{#if ability.hasBonus}}has-bonus{{/if}}"
                                        data-tooltip="{{#if ability.isCapped}}{{localize 'THE-CODEX.Combat.ArmorCap'}}: {{ability.capReason}}{{/if}}">
                                        {{#if ability.isCapped}}
                                        {{numberFormat ability.displayModifier decimals=0 sign=true}}
                                        {{else}}
                                        {{numberFormat ability.modifier decimals=0 sign=true}}
                                        {{/if}}
                                    </span>
                                </div>

                                {{!-- ESCUDO DE SALVAGUARDA --}}
                                {{#with (lookup ../system.saves id) as |save|}}
                                <div class="save-indicator {{#if save.proficient}}proficient{{/if}} {{#if save.hasBonus}}has-bonus{{/if}}"
                                    data-action="onRollSave" data-id="{{id}}"
                                    data-tooltip="{{localize 'THE-CODEX.Combat.Save'}} {{localize (concat 'THE-CODEX.Abilities.' id)}} (+{{numberFormat save.total decimals=0 sign=true}}) | {{localize 'THE-CODEX.UI.ToggleProficiency'}} (Right Click)">
                                    <i class="fas fa-shield-halved"></i>
                                    <span class="save-total">{{numberFormat save.total decimals=0 sign=true}}</span>
                                </div>
                                {{/with}}
                            </div>
                            {{/each}}
                        </div>

                        <div class="level-rest-xp-cluster">
                            <div class="rest-icons-v13">
                                <i class="fas fa-hourglass-half rest-icon-btn short" data-action="shortRest"
                                    data-tooltip="{{localize 'THE-CODEX.Sheet.RestShortTooltip'}}"></i>
                                <i class="fas fa-campground rest-icon-btn long" data-action="longRest"
                                    data-tooltip="{{localize 'THE-CODEX.Sheet.RestLongTooltip'}}"></i>
                            </div>

                            <div class="level-xp-row">
                                <div class="total-level-badge-v13">
                                    <label>{{localize 'THE-CODEX.Sheet.Level'}}</label>
                                    <span class="level-value">{{system.details.level}}</span>
                                </div>

                                <div
                                    class="xp-bar-module {{#if (gte system.details.xp.value system.details.xp.max)}}level-up-glow{{/if}}">
                                    <div class="xp-inputs-row">
                                        <span class="xp-label {{#if (gte system.details.xp.value system.details.xp.max)}}clickable{{/if}}"
                                              data-action="levelUp">XP</span>
                                        <input type="number" name="system.details.xp.value"
                                            value="{{system.details.xp.value}}" class="xp-input-val" 
                                            step="1" />
                                        <span class="xp-sep">/</span>
                                        <span class="xp-max {{#if (gte system.details.xp.value system.details.xp.max)}}clickable{{/if}}"
                                              data-action="levelUp">{{system.details.xp.max}}</span>
                                    </div>
                                    <div class="xp-track-v13">
                                        <div class="xp-fill-v13"
                                            style="width: {{pct system.details.xp.value system.details.xp.max}}%;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            {{!-- Tabs --}}
            <nav class="sheet-tabs-v2" data-group="primary">
                <a class="item {{#if tabs.principal.active}}active{{/if}}" data-action="changeTab"
                    data-tab="principal"><i class="fas fa-scroll"></i> {{localize "THE-CODEX.Sheet.Principal"}}</a>
                <a class="item {{#if tabs.inventario.active}}active{{/if}}" data-action="changeTab"
                    data-tab="inventario"><i class="fas fa-backpack"></i> {{localize "THE-CODEX.Sheet.Inventory"}}</a>
                <a class="item {{#if tabs.poderes.active}}active{{/if}}" data-action="changeTab" data-tab="poderes"><i
                        class="fas fa-fire-alt"></i> {{localize "THE-CODEX.Sheet.Powers"}}</a>
                {{#if isSpellcaster}}
                <a class="item {{#if tabs.grimorio.active}}active{{/if}}" data-action="changeTab" data-tab="grimorio"><i
                        class="fas fa-book"></i> {{localize "THE-CODEX.Sheet.Grimoire"}}</a>
                {{/if}}
                <a class="item {{#if tabs.description.active}}active{{/if}}" data-action="changeTab"
                    data-tab="description"><i class="fas fa-feather-alt"></i> {{localize "THE-CODEX.Sheet.Bio"}}</a>
            </nav>

            {{!-- Tab Content --}}
            <section class="sheet-body-v13">

                {{!-- Principal --}}
                <div class="tab {{#if tabs.principal.active}}active{{/if}}" data-tab="principal" data-group="primary">
                    {{> "systems/the-codex-modern/templates/character-principal.hbs"}}
                </div> {{!-- Fim da tab principal --}}

                {{!-- ABA INVENTÁRIO COM PAPER DOLL (BLINDADO COM O SEU CSS) --}}
                <div class="tab {{#if tabs.inventario.active}}active{{/if}}" data-tab="inventario" data-group="primary">
                    {{> "systems/the-codex-modern/templates/character-items.hbs"}}
                </div>

                {{!-- Grimório --}}
                <div class="tab {{#if tabs.grimorio.active}}active{{/if}}" data-tab="grimorio" data-group="primary">
                    {{> "systems/the-codex-modern/templates/character-spells.hbs"}}
                </div>

                {{!-- Poderes --}}
                <div class="tab {{#if tabs.poderes.active}}active{{/if}}" data-tab="poderes" data-group="primary">
                    {{> "systems/the-codex-modern/templates/character-features.hbs"}}
                </div>

                {{!-- Descrição --}}
                <div class="tab {{#if tabs.description.active}}active{{/if}}" data-tab="description"
                    data-group="primary">
                    {{> "systems/the-codex-modern/templates/character-biography.hbs"}}
                </div>

            </section>
        </main>
    </div>
</div>