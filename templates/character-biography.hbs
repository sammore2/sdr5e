                    <div class="bio-layout-v13">
                        <div class="bio-main-col papiro-bg">
                            <div class="char-details-grid-v13">
                                <div class="detail-box-v13">
                                    <label>{{localize 'THE-CODEX.Bio.Age'}}</label>
                                    <input type="text" name="system.details.age" value="{{system.details.age}}"
                                        placeholder="25 anos" />
                                </div>
                                <div class="detail-box-v13">
                                    <label>{{localize 'THE-CODEX.Bio.Gender'}}</label>
                                    <input type="text" name="system.details.gender" value="{{system.details.gender}}"
                                        placeholder="Masculino" />
                                </div>
                                <div class="detail-box-v13">
                                    <label>{{localize 'THE-CODEX.Bio.Height'}}</label>
                                    <input type="text" name="system.details.height" value="{{system.details.height}}"
                                        placeholder="1,80m" />
                                </div>
                                <div class="detail-box-v13">
                                    <label>{{localize 'THE-CODEX.Bio.Weight'}}</label>
                                    <input type="text" name="system.details.weight" value="{{system.details.weight}}"
                                        placeholder="80kg" />
                                </div>
                                <div class="detail-box-v13">
                                    <label>{{localize 'THE-CODEX.Bio.Eyes'}}</label>
                                    <input type="text" name="system.details.eyes" value="{{system.details.eyes}}"
                                        placeholder="Castanhos" />
                                </div>
                                <div class="detail-box-v13">
                                    <label>{{localize 'THE-CODEX.Bio.Hair'}}</label>
                                    <input type="text" name="system.details.hair" value="{{system.details.hair}}"
                                        placeholder="Pretos" />
                                </div>
                                <div class="detail-box-v13">
                                    <label>{{localize 'THE-CODEX.Bio.Deity'}}</label>
                                    <input type="text" name="system.details.deity" value="{{system.details.deity}}"
                                        placeholder="Nenhuma" />
                                </div>
                            </div>

                            <h3 class="box-title">{{localize 'THE-CODEX.Sheet.Bio'}}</h3>
                            {{#if editable}}
                            <div class="editor-container-v13" style="min-height: 400px;">
                                <prose-mirror name="system.details.biography" data-document-u-u-i-d="{{actor.uuid}}"
                                    value="{{system.details.biography}}" toggled="true" collaborate="true"
                                    button="true">
                                    {{{enrichedBiography}}}
                                </prose-mirror>
                            </div>
                            {{else}}
                            <div class="bio-readonly">{{{enrichedBiography}}}</div>
                            {{/if}}
                        </div>

                        <aside class="bio-side-col papiro-bg">
                            <div class="inv-header">
                                <h3 class="box-title">{{localize 'THE-CODEX.Sheet.Languages'}}</h3>
                                <button type="button" class="item-create-btn" data-action="createItem"
                                    data-item-type="language"><i class="fas fa-plus"></i></button>
                            </div>
                            <div class="languages-list-v13">
                                {{#each languages as |item|}}
                                <div class="language-pill-v13 clickable" data-item-id="{{item.id}}"
                                    data-action="openItem">
                                    <img src="{{item.img}}" class="pill-icon" />
                                    <span class="pill-name">{{item.name}}</span>
                                    <i class="fas fa-times delete-pill-v13" data-action="deleteItem"
                                        data-item-id="{{item.id}}"></i>
                                </div>
                                {{else}}
                                <p class="placeholder-text">{{localize 'THE-CODEX.Powers.EmptyLanguages'}}</p>
                                {{/each}}
                            </div>
                            <p class="hint">{{localize 'THE-CODEX.Sheet.LanguagesHint'}}</p>
                        </aside>
                    </div>
