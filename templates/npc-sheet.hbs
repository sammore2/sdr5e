<div class="sdrn-root sdrn-npc-root">

  <!-- Dock Lateral de Abas Estilo Foundry V3 -->
  <nav class="sdrn-side-tabs sdrn-npc-side-tabs">
    <button type="button" class="sdrn-tab-btn active" data-action="tab" data-tab="actions" title="Actions &amp; Features">
      <i class="fas fa-list-ul"></i>
    </button>
    <button type="button" class="sdrn-tab-btn" data-action="tab" data-tab="details" title="Biography &amp; Lore">
      <i class="fas fa-scroll"></i>
    </button>
    <button type="button" class="sdrn-tab-btn" data-action="tab" data-tab="config" title="Monster Configuration">
      <i class="fas fa-cog"></i>
    </button>
  </nav>

  <div class="sdrn-body sdrn-npc-body">

    <!-- Top Grid: Hero Block (Retrato Circular + Identidade + Ribbon de Atributos) -->
    <header class="sdrn-npc-header-v3">

      <!-- Bloco de Retrato Circular com Badges de D20 e Escudo de CA -->
      <div class="sdrn-npc-token-container">
        <div class="sdrn-npc-token-frame">
          <button type="button" class="sdrn-npc-token-btn" data-action="pick-portrait" title="Click to change portrait">
            {{#if avatarUrl}}
            <img src="{{avatarUrl}}" alt="{{name}}" class="sdrn-npc-token-img" />
            {{else}}
            <div class="sdrn-npc-token-placeholder"><i class="fas fa-dragon"></i></div>
            {{/if}}
          </button>

          <!-- D20 Badge no Topo Direito do Anel -->
          <button type="button" class="sdrn-npc-d20-badge" data-action="roll-initiative" title="Roll Initiative ({{_initiative}})">
            <i class="fas fa-dice-d20 sdrn-d20-icon"></i>
            <span class="sdrn-d20-val">{{_initiative}}</span>
          </button>

          <!-- Escudo de CA no Canto Inferior Esquerdo do Anel -->
          <div class="sdrn-npc-ac-shield" title="Armor Class (Base: {{_acBase}} &bull; Total: {{_ac}})">
            <svg class="sdrn-ac-shield-svg" viewBox="0 0 36 42">
              <path d="M18,1 L34,7 C34,26 24,38 18,41 C12,38 2,26 2,7 Z" fill="#131418" stroke="#c99738" stroke-width="2.5" />
            </svg>
            <div class="sdrn-ac-shield-content">
              <span class="sdrn-ac-shield-lbl">AC</span>
              <input class="sdrn-ac-shield-num" type="number" name="sd:attributes.da.base" value="{{_acBase}}" title="Edit Base AC" />
            </div>
          </div>
        </div>

        <!-- Barra de Vida Integrada Logo Abaixo do Retrato Circular -->
        <div class="sdrn-npc-hp-module">
          <div class="sdrn-dark-bar sdrn-hp-bar">
            <div class="sdrn-dark-bar-fill sdrn-hp-fill" style="width:{{_health.pct}}%"></div>
            <div class="sdrn-dark-bar-text sdrn-hp-bar-text">
              <span class="sdrn-bar-lbl">HP</span>
              <input class="sdrn-bar-input sdrn-hp-cur" type="number" name="sd:resources.health.value" value="{{_health.value}}" title="Current HP" />
              <span class="sdrn-bar-sep">/</span>
              <input class="sdrn-bar-input sdrn-hp-max" type="number" name="sd:resources.health.max" value="{{_health.max}}" title="Max HP" />
            </div>
          </div>
          {{#if _health.temp}}
          <div class="sdrn-hp-tmp-badge" title="Temporary HP">
            <span class="sdrn-tmp-lbl">+TMP</span>
            <input class="sdrn-bar-input sdrn-tmp-input" type="number" name="sd:resources.health.temp" value="{{_health.temp}}" title="Temporary HP" />
          </div>
          {{/if}}
        </div>
      </div>

      <!-- Identidade e Ribbon Horizontal de Atributos -->
      <div class="sdrn-npc-header-main">

        <!-- Linha de Título, Tamanho, XP, Descanso e Medalhão de CR -->
        <div class="sdrn-npc-identity-row">
          <div class="sdrn-npc-name-block">
            <input type="text" class="sdrn-npc-name-input" name="name" value="{{name}}" placeholder="Creature Name" />
            <div class="sdrn-npc-meta-sub">
              <select class="sdrn-npc-size-select" name="sd:details.size" title="Size">
                {{#each _sizeOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              <span class="sdrn-meta-dot">&bull;</span>
              <input class="sdrn-npc-meta-field" type="text" name="sd:details.type" value="{{_type}}" placeholder="Type" title="Creature Type" />
              <span class="sdrn-meta-dot">&bull;</span>
              <input class="sdrn-npc-meta-field" type="text" name="sd:details.alignment" value="{{_alignment}}" placeholder="Alignment" title="Alignment" />
            </div>
          </div>

          <div class="sdrn-npc-top-badges">
            <div class="sdrn-npc-status-pill" title="Experience Points">
              <span class="sdrn-status-pill-lbl">XP</span>
              <span class="sdrn-status-pill-val">{{_xpValue}}</span>
            </div>
            <div class="sdrn-npc-status-pill" title="Proficiency Bonus">
              <span class="sdrn-status-pill-lbl">PROF</span>
              <span class="sdrn-status-pill-val">{{_prof}}</span>
            </div>

            <!-- Medalhão de CR Metálico com Borda Chanfrada -->
            <div class="sdrn-cr-badge-wrap" title="Challenge Rating">
              <span class="sdrn-cr-badge-label">CR</span>
              <div class="sdrn-cr-medallion-badge">
                <input class="sdrn-cr-badge-input" type="text" name="sd:details.cr" value="{{_cr}}" title="Edit CR" />
              </div>
            </div>
          </div>
        </div>

        <!-- Ribbon de 6 Atributos Estilo Foundry V3 -->
        <div class="sdrn-npc-abilities-ribbon">
          {{#each _abilities}}
          <div class="sdrn-ability-pill-card" title="{{label}}">
            <div class="sdrn-ability-pill-abbr">{{abbr}}</div>
            <button type="button" class="sdrn-ability-pill-mod" data-action="roll-ability" data-key="{{key}}" data-mode="test" title="Roll {{label}}">{{mod}}</button>
            <div class="sdrn-ability-pill-score-wrap">
              <input class="sdrn-ability-pill-score" type="number" name="sd:abilities.{{key}}.value" value="{{score}}" min="1" max="30" title="{{label}} Score" />
            </div>
            <!-- Botão de Salvaguarda Clicável Abaixo do Atributo -->
            <button type="button" class="sdrn-ability-pill-save {{#if saveProficient}}proficient{{/if}}" data-action="roll-save" data-key="{{key}}" title="Roll {{label}} Save ({{saveTotal}})">
              <span class="sdrn-save-pip {{#if saveProficient}}active{{/if}}"></span>
              <span class="sdrn-save-mod">{{saveTotal}}</span>
              <i class="fas fa-shield-alt sdrn-save-icon"></i>
            </button>
          </div>
          {{/each}}
        </div>

      </div>

    </header>

    <!-- Layout Central: Sidebar de Stats Rápidos à Esquerda + Conteúdo à Direita -->
    <div class="sdrn-npc-layout-grid">

      <!-- Sidebar Esquerda com Sentidos, Perícias, Saves, Traços e Deslocamento -->
      <aside class="sdrn-npc-stats-sidebar">

        <!-- Speed & Hit Dice -->
        <div class="sdrn-npc-stat-row-dual">
          <div class="sdrn-npc-stat-item" title="Speed">
            <span class="sdrn-stat-subhead"><i class="fas fa-running"></i> SPD</span>
            <span class="sdrn-stat-val">{{_speed}}</span>
          </div>
          <div class="sdrn-npc-stat-item" title="Hit Dice / Formula">
            <span class="sdrn-stat-subhead"><i class="fas fa-heartbeat"></i> HD</span>
            <input class="sdrn-stat-inline-input" type="text" name="sd:attributes.hp.formula" value="{{_hpFormula}}" placeholder="e.g. 2d8+4" />
          </div>
        </div>

        <!-- Saving Throws -->
        <div class="sdrn-npc-stat-group">
          <div class="sdrn-stat-group-header">
            <span class="sdrn-stat-subhead"><i class="fas fa-shield-alt"></i> SAVING THROWS</span>
            {{#if _availableSaves.length}}
            <select class="sdrn-npc-quick-select" data-action="add-save-prof" title="Add Save Proficiency">
              <option value="">+ Save</option>
              {{#each _availableSaves}}
              <option value="{{key}}">{{label}}</option>
              {{/each}}
            </select>
            {{/if}}
          </div>
          <div class="sdrn-skills-pill-list">
            {{#each _saves}}
            <div class="sdrn-skill-tag-pill">
              <button type="button" class="sdrn-skill-tag-btn" data-action="roll-save" data-key="{{key}}" title="Roll {{label}} Save ({{total}})">
                <span class="sdrn-skill-tag-name">{{label}}</span>
                <span class="sdrn-skill-tag-mod">{{total}}</span>
              </button>
              <button type="button" class="sdrn-tag-del-btn" data-action="remove-save-prof" data-key="{{key}}" title="Remove save proficiency">&times;</button>
            </div>
            {{else}}
            <span class="sdrn-empty-tag">No proficient saves</span>
            {{/each}}
          </div>
        </div>

        <!-- Perícias em Tags Pílula Escuras -->
        <div class="sdrn-npc-stat-group">
          <div class="sdrn-stat-group-header">
            <span class="sdrn-stat-subhead"><i class="fas fa-graduation-cap"></i> SKILLS</span>
            {{#if _availableSkills.length}}
            <select class="sdrn-npc-quick-select" data-action="add-skill-prof" title="Add Skill Proficiency">
              <option value="">+ Skill</option>
              {{#each _availableSkills}}
              <option value="{{key}}">{{label}}</option>
              {{/each}}
            </select>
            {{/if}}
          </div>
          <div class="sdrn-skills-pill-list">
            {{#each _skills}}
            <div class="sdrn-skill-tag-pill">
              <button type="button" class="sdrn-skill-tag-btn" data-action="roll-skill" data-key="{{key}}" title="Roll {{label}} ({{total}})">
                <span class="sdrn-skill-tag-name">{{label}}</span>
                <span class="sdrn-skill-tag-mod">{{total}}</span>
              </button>
              <button type="button" class="sdrn-tag-del-btn" data-action="remove-skill-prof" data-key="{{key}}" title="Remove skill proficiency">&times;</button>
            </div>
            {{else}}
            <span class="sdrn-empty-tag">None proficient</span>
            {{/each}}
          </div>
        </div>

        <!-- Resistências & Imunidades (Damage Traits) -->
        <div class="sdrn-npc-stat-group">
          <div class="sdrn-stat-group-header">
            <span class="sdrn-stat-subhead"><i class="fas fa-shield-virus"></i> RESISTANCES &amp; IMMUNITIES</span>
            {{#if _traitOptions.length}}
            <select class="sdrn-npc-quick-select" data-action="add-trait" title="Add Damage/Condition Trait">
              <option value="">+ Trait</option>
              {{#each _traitOptions}}
              <option value="{{value}}">{{label}}</option>
              {{/each}}
            </select>
            {{/if}}
          </div>
          <div class="sdrn-traits-pill-list">
            {{#each _traitItems}}
            <div class="sdrn-trait-tag-pill {{cssClass}}" title="{{typeLabel}}: {{label}}">
              <span class="sdrn-trait-type-prefix">{{type}}</span>
              <span class="sdrn-trait-name">{{label}}</span>
              <button type="button" class="sdrn-tag-del-btn" data-action="remove-trait" data-trait-type="{{type}}" data-value="{{value}}" title="Remove {{label}}">&times;</button>
            </div>
            {{else}}
            <span class="sdrn-empty-tag">&mdash;</span>
            {{/each}}
          </div>
        </div>

        <!-- Sentidos Passivos -->
        <div class="sdrn-npc-stat-group">
          <div class="sdrn-stat-group-header">
            <span class="sdrn-stat-subhead"><i class="fas fa-eye"></i> SENSES</span>
            {{#if _availableSensesList.length}}
            <select class="sdrn-npc-quick-select" data-action="add-sense" title="Add Sense">
              <option value="">+ Sense</option>
              {{#each _availableSensesList}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
            {{/if}}
          </div>
          <div class="sdrn-senses-pill-list">
            <span class="sdrn-sense-tag fixed"><i class="fas fa-low-vision"></i> PASSIVE PERCEPTION &bull; {{_passivePerception}}</span>
            {{#each _senses}}
            <div class="sdrn-sense-tag removable">
              <span>{{this}}</span>
              <button type="button" class="sdrn-tag-del-btn" data-action="remove-sense" data-value="{{this}}" title="Remove sense">&times;</button>
            </div>
            {{/each}}
          </div>
        </div>

        <!-- Idiomas -->
        <div class="sdrn-npc-stat-group">
          <div class="sdrn-stat-group-header">
            <span class="sdrn-stat-subhead"><i class="fas fa-comment-dots"></i> LANGUAGES</span>
            {{#if _availableLanguagesList.length}}
            <select class="sdrn-npc-quick-select" data-action="add-language" title="Add Language">
              <option value="">+ Lang</option>
              {{#each _availableLanguagesList}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
            {{/if}}
          </div>
          <div class="sdrn-lang-pill-list">
            {{#each _languages}}
            <div class="sdrn-lang-tag removable">
              <span>{{name}}</span>
              <button type="button" class="sdrn-tag-del-btn" data-action="remove-language" data-id="{{id}}" data-name="{{name}}" title="Remove language">&times;</button>
            </div>
            {{else}}
            <span class="sdrn-empty-tag">&mdash;</span>
            {{/each}}
          </div>
        </div>

      </aside>

      <!-- Painel Central Principal -->
      <main class="sdrn-npc-main-content">

        <!-- ABA 1: ACTIONS & FEATURES -->
        <div data-tab-content="actions" class="sdrn-tab-panel">

          <!-- Barra de Busca de Ações & Filtros -->
          <div class="sdrn-search-bar">
            <i class="fas fa-search sdrn-search-icon"></i>
            <input type="text" placeholder="Search features, actions, attacks..." class="sdrn-search-input" />
            <button type="button" class="sdrn-search-action-btn" title="Clear"><i class="fas fa-times"></i></button>
            <button type="button" class="sdrn-search-action-btn" title="Filter"><i class="fas fa-filter"></i></button>
            <button type="button" class="sdrn-search-action-btn" title="Sort"><i class="fas fa-sort-amount-down"></i></button>
          </div>

          <!-- Tabela de Características / Ações -->
          <div class="sdrn-features-table">
            <div class="sdrn-features-header">
              <span class="col-name">Features &amp; Actions</span>
              <span class="col-uses">USES</span>
              <span class="col-roll">ROLL</span>
              <span class="col-formula">FORMULA</span>
              <span class="col-actions">ACTIONS</span>
            </div>

            <div class="sdrn-features-body">
              {{#each _actions}}
              <div class="sdrn-feature-row">
                <div class="col-name">
                  <div class="sdrn-feature-icon-thumb">
                    {{#if imgUrl}}
                    <img src="{{imgUrl}}" alt="" />
                    {{else}}
                    <span class="sdrn-feature-icon-fallback">{{icon}}</span>
                    {{/if}}
                  </div>
                  <div class="sdrn-feature-titles">
                    <button type="button" class="sdrn-feature-title-btn" data-action="open-item" data-id="{{id}}" title="Open details">{{name}}</button>
                    <span class="sdrn-feature-type-sub">{{type}}</span>
                  </div>
                </div>

                <div class="col-uses">&mdash;</div>

                <div class="col-roll">
                  {{#if isWeapon}}
                  <button type="button" class="sdrn-table-action-btn atk" data-action="roll-attack" data-id="{{id}}" title="Roll Attack"><i class="fas fa-dice-d20"></i> Atk</button>
                  {{else}}
                  <span>&mdash;</span>
                  {{/if}}
                </div>

                <div class="col-formula">
                  {{#if isWeapon}}
                  <button type="button" class="sdrn-table-action-btn dmg" data-action="roll-damage" data-id="{{id}}" title="Roll Damage"><i class="fas fa-tint"></i> Dmg</button>
                  {{else if hasDamage}}
                  <button type="button" class="sdrn-table-action-btn dmg" data-action="roll-action-damage" data-id="{{id}}" title="Roll Damage"><i class="fas fa-tint"></i> Dmg</button>
                  {{else}}
                  <span>&mdash;</span>
                  {{/if}}
                </div>

                <div class="col-actions">
                  <button type="button" class="sdrn-icon-ctrl-btn" data-action="post-action-chat" data-id="{{id}}" title="Post to Chat"><i class="fas fa-comment-alt"></i></button>
                  <button type="button" class="sdrn-icon-ctrl-btn del" data-action="delete-item" data-id="{{id}}" title="Delete"><i class="fas fa-trash-alt"></i></button>
                </div>
              </div>
              {{else}}
              <div class="sdrn-empty-row">No features, actions, or attacks added to this creature yet.</div>
              {{/each}}
            </div>
          </div>

          <!-- Botões Rápidos de Adicionar Ação/Ataque -->
          <div class="sdrn-add-actions-footer">
            <button type="button" class="sdrn-quick-add-btn" data-action="create-item" data-item-type="feature"><i class="fas fa-plus"></i> Add Feature</button>
            <button type="button" class="sdrn-quick-add-btn" data-action="create-item" data-item-type="weapon"><i class="fas fa-plus"></i> Add Attack</button>
            <button type="button" class="sdrn-quick-add-btn" data-action="create-item" data-item-type="spell"><i class="fas fa-plus"></i> Add Spell</button>
          </div>

        </div>

        <!-- ABA 2: DETAILS & LORE -->
        <div data-tab-content="details" class="sdrn-tab-panel" style="display:none;">
          <div class="sdrn-card-block">
            <div class="sdrn-box-title"><i class="fas fa-feather-alt"></i> BIOGRAPHY &amp; MONSTER LORE</div>
            <textarea name="sd:details.biography" class="sdrn-dark-textarea" rows="12" placeholder="Ecology, tactics, description, lair details...">{{_biography}}</textarea>
          </div>
        </div>

        <!-- ABA 3: CONFIGURATION -->
        <div data-tab-content="config" class="sdrn-tab-panel" style="display:none;">
          <div class="sdrn-card-block">
            <div class="sdrn-box-title"><i class="fas fa-sliders-h"></i> CONFIGURATION &amp; STAT BLOCK SETTINGS</div>
            <div class="sdrn-config-fields-grid">
              <label class="sdrn-cfg-row">
                <span>HP Formula</span>
                <input type="text" name="sd:attributes.hp.formula" value="{{_hpFormula}}" placeholder="e.g. 8d8+16" />
              </label>
              <label class="sdrn-cfg-row">
                <span>Alignment</span>
                <input type="text" name="sd:details.alignment" value="{{_alignment}}" />
              </label>
              <label class="sdrn-cfg-row">
                <span>Source</span>
                <input type="text" name="sd:details.source" value="{{_source}}" placeholder="SRD 5.1" />
              </label>
              <label class="sdrn-cfg-row">
                <span>Legendary Actions</span>
                <input type="number" name="sd:details.legendaryActions" value="{{_legendaryActions}}" min="0" max="10" />
              </label>
              <label class="sdrn-cfg-row">
                <span>Legendary Resistances</span>
                <input type="number" name="sd:details.legendaryResistances" value="{{_legendaryResistances}}" min="0" max="10" />
              </label>
            </div>
          </div>
        </div>

      </main>

    </div>

  </div>

</div>
