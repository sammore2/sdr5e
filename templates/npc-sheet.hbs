<div class="{{cssClass}} container-v13 npc-sheet-v13" autocomplete="off">

    {{!-- SIDEBAR TÁTICA --}}
    <aside class="sidebar-v13" style="width: 200px;">
        {{!-- Imagem de Perfil com Selo de Defesa --}}
        <div class="profile-container-v13">
            <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-tooltip="{{actor.name}}"
                style="width: 150px; height: 150px;" />
            <div class="da-badge-v13" data-tooltip="{{localize 'THE-CODEX.Sheet.Defense'}}">
                <input type="number" name="system.attributes.da.value" class="da-val" value="{{system.attributes.da.value}}" style="width: 100%; border: none; background: transparent; color: white; text-align: center; font-size: 1.3rem; font-weight: bold; outline: none;" />
                <label>{{localize 'THE-CODEX.NPC.DAShort'}}</label>
            </div>
        </div>

        {{!-- Vitais (PV, Iniciativa, Speed) --}}
        <div class="sidebar-vitals-v13">
            <div class="hp-bar-v13">
                <div class="hp-header">
                    <i class="fas fa-heart"></i>
                    <input type="number" name="system.resources.health.value"
                        value="{{system.resources.health.value}}" />
                    <span>/</span>
                    <input type="number" name="system.resources.health.max" value="{{system.resources.health.max}}" />
                </div>
                <div class="hp-progress">
                    <div class="bar" style="width: {{pct system.resources.health.value system.resources.health.max}}%">
                    </div>
                </div>
            </div>

            <div class="secondary-vitals-v13">
                <div class="vital-item clickable" data-tooltip="{{localize 'THE-CODEX.NPC.Init'}}"
                    data-action="rollInitiative">
                    <i class="fas fa-bolt"></i>
                    <div class="val-group">
                        <span class="val">{{numberFormat system.attributes.initiative.total decimals=0
                            sign=true}}</span>
                        <label>{{localize 'THE-CODEX.NPC.Init'}}</label>
                    </div>
                </div>
                <div class="vital-item" data-tooltip="{{localize 'THE-CODEX.NPC.Speed'}}">
                    <i class="fas fa-person-running"></i>
                    <div class="val-group">
                        <span class="val">{{system.attributes.speed.value}}</span>
                        <label>{{localize 'THE-CODEX.NPC.Speed'}}</label>
                    </div>
                </div>
            </div>

            {{!-- Botões de Descanso --}}
            <div class="rest-buttons-v13" style="display: flex; gap: 5px; margin-top: 10px;">
                <button type="button" class="codex-button secondary" data-action="shortRest"
                    data-tooltip="{{localize 'THE-CODEX.Sheet.RestShort'}}">
                    <i class="fas fa-hourglass-half"></i>
                </button>
                <button type="button" class="codex-button secondary" data-action="longRest"
                    data-tooltip="{{localize 'THE-CODEX.Sheet.RestLong'}}">
                    <i class="fas fa-bed"></i>
                </button>
            </div>



            {{!-- Mini Efeitos Ativos (Paridade com PC) --}}
            <div class="active-effects-tray" style="margin-top: 10px;">
                {{#each activeEffects as |effect|}}
                <div class="mini-effect-icon {{#if effect.disabled}}disabled{{/if}}" data-action="deleteEffect"
                    data-effect-id="{{effect.id}}"
                    data-tooltip="{{effect.name}} ({{localize 'THE-CODEX.UI.ClickToRemove'}})">
                    <img src="{{effect.img}}">
                </div>
                {{/each}}
            </div>
        </div>

        {{!-- Sentidos e Idiomas --}}
        <div class="sidebar-resources-v13">
            <div class="resource-group">
                <label><i class="fas fa-eye"></i> {{localize 'THE-CODEX.NPC.Senses'}} <a data-action="openTraitSelector"
                        data-trait="senses"><i class="fas fa-plus"></i></a></label>
                <div class="pill-container">
                    {{#each system.details.senses.value as |id|}}
                    <span class="trait-pill">{{localize (lookup @root.config.visionModes id)}}
                        <i class="fas fa-times" data-action="removeSense" data-value="{{id}}"></i>
                    </span>
                    {{/each}}
                    {{#if system.details.senses.custom}}
                    <span class="trait-pill custom">{{system.details.senses.custom}}</span>
                    {{/if}}
                </div>
            </div>

            <div class="resource-group">
                <label><i class="fas fa-comment"></i> {{localize 'THE-CODEX.NPC.Languages'}} <a data-action="createItem"
                        data-type="language"><i class="fas fa-plus"></i></a></label>
                <div class="pill-container">
                    {{#each languages as |lang|}}
                    <span class="trait-pill">
                        <span class="clickable" data-action="openItem" data-item-id="{{lang.id}}">{{lang.name}}</span>
                        <i class="fas fa-times" data-action="deleteItem" data-item-id="{{lang.id}}"></i>
                    </span>
                    {{/each}}
                    {{#if system.details.languages.custom}}
                    <span class="trait-pill custom">{{system.details.languages.custom}}</span>
                    {{/if}}
                </div>
            </div>
        </div>
    </aside>

    {{!-- ÁREA PRINCIPAL --}}
    <main class="main-v13">
        <header class="npc-header-v13">
            <div class="name-row">
                <input name="name" type="text" value="{{actor.name}}"
                    placeholder="{{localize 'THE-CODEX.NPC.PlaceholderName'}}" />

                {{!-- Classes do NPC (Paridade com PC) --}}
                <div class="npc-classes-v13">
                    {{#each classes as |cls|}}
                    <div class="identity-badge clickable" data-tooltip="{{cls.uuid}}" data-item-id="{{cls.id}}"
                        data-action="openItem">
                        <img src="{{cls.img}}" class="mini-icon-v13" />
                        <span>{{cls.name}} {{cls.system.levels}}</span>
                        <i class="fas fa-times delete-btn-v13" data-action="deleteItem" data-item-id="{{cls.id}}"></i>
                    </div>
                    {{/each}}
                    <a class="add-class-btn" data-action="createItem" data-type="class"
                        data-tooltip="{{localize 'THE-CODEX.Sheet.New'}} Classe">
                        <i class="fas fa-plus"></i>
                    </a>
                </div>

                <div class="cr-badge-v13" data-tooltip="{{localize 'THE-CODEX.NPC.Challenge'}}">
                    <label>{{localize 'THE-CODEX.NPC.ChallengeAbbr'}}</label>
                    <input type="text" name="system.details.cr" value="{{system.details.cr}}" />
                </div>
            </div>

            <div class="identity-line-v13">
                <select name="system.details.size">
                    {{selectOptions config.actorSizes selected=system.details.size localize=true}}
                </select>
                <span class="xp-inline">{{system.details.xp.label}}</span>
            </div>
        </header>

        {{!-- Atributos Horizontais (Invertidos: Valor em Cima, Mod embaixo) --}}
        <div class="attributes-row-v13">
            {{#each system.abilities as |abl id|}}
            <div class="ability-box-v13" data-ability="{{id}}">
                <span class="label">{{lookup ../abilityAbbr id}}</span>
                <div class="score">
                    <input type="number" name="system.abilities.{{id}}.value" value="{{abl.value}}" />
                </div>
                <div class="mod" data-action="rollAbility" data-id="{{id}}">
                    {{numberFormat abl.modifier decimals=0 sign=true}}
                </div>
                {{!-- Botão de Save Embutido --}}
                {{#with (lookup ../system.saves id)}}
                <div class="save-indicator {{#if proficient}}proficient{{/if}}" data-action="rollSave"
                    data-id="{{../id}}"
                    data-tooltip="{{localize 'THE-CODEX.Combat.Save'}} | {{localize 'THE-CODEX.UI.ToggleProficiency'}}">
                    <i class="fas fa-shield-halved" data-id="{{../id}}"></i>
                </div>
                {{/with}}
            </div>
            {{/each}}
        </div>

        {{!-- Navegação por Abas (Ícones com Tooltips) --}}
        <nav class="sheet-tabs-v13" data-group="primary">
            {{#each tabs as |tab id|}}
            <a class="item {{#if tab.active}}active{{/if}}" data-action="changeTab" data-tab="{{id}}"
                data-tooltip="{{localize tab.label}}">
                <i class="{{tab.icon}}"></i>
            </a>
            {{/each}}
        </nav>

        {{!-- Corpo das Abas --}}
        <section class="tab-body-v13">

            <div class="tab principal {{#if tabs.principal.active}}active{{/if}}" data-group="primary"
                data-tab="principal">
                <div class="principal-grid-v13">
                    <div class="info-block-v13 papiro-bg">
                        <h3 class="block-title">
                            {{localize 'THE-CODEX.Sheet.Saves'}}
                            <a class="config-btn" data-action="openConfigDialog" data-type="saves"><i
                                    class="fas fa-plus"></i></a>
                        </h3>
                        <div class="stat-tags-v13">
                            {{#each activeSaves}}
                            <span class="tag-v13" data-action="rollSave" data-id="{{this.id}}">
                                {{this.label}} {{numberFormat this.val sign=true}}
                                <i class="fas fa-times remove-tag" data-action="removeSave" data-id="{{this.id}}"></i>
                            </span>
                            {{/each}}
                        </div>

                        <h3 class="block-title">
                            {{localize 'THE-CODEX.Sheet.SkillsLabel'}}
                            <a class="config-btn" data-action="openConfigDialog" data-type="skills"><i
                                    class="fas fa-plus"></i></a>
                        </h3>
                        <div class="stat-tags-v13">
                            {{#each activeSkills}}
                            <span class="tag-v13 {{#if (eq this.multiplier 2)}}expert{{/if}}" data-action="rollSkill"
                                data-id="{{this.id}}"
                                data-tooltip="{{localize 'THE-CODEX.UI.ToggleProficiency'}} (Right Click)">
                                {{#if (eq this.multiplier 2)}}<i class="fas fa-star"
                                    style="color: var(--codex-gold); font-size: 0.8em; margin-right: 2px;"></i>{{/if}}
                                {{this.label}} {{numberFormat this.val sign=true}}
                                <i class="fas fa-times remove-tag" data-action="removeSkill" data-id="{{this.id}}"></i>
                            </span>
                            {{/each}}
                        </div>
                    </div>

                    <div class="info-block-v13 papiro-bg">
                        <h3 class="block-title">{{localize 'THE-CODEX.Sheet.Immunities'}} <a
                                data-action="openTraitSelector" data-trait="di"><i class="fas fa-plus"></i></a></h3>
                        <div class="pill-container">
                            {{#each system.details.traits.di.value as |id|}}
                            <span class="trait-pill immunity">{{localize (lookup @root.config.damageTypes id)}}
                                <i class="fas fa-times" data-action="removeTrait" data-trait="di"
                                    data-value="{{id}}"></i>
                            </span>
                            {{/each}}
                        </div>

                        <h3 class="block-title">{{localize 'THE-CODEX.Sheet.DamageResistances'}} <a
                                data-action="openTraitSelector" data-trait="dr"><i class="fas fa-plus"></i></a></h3>
                        <div class="pill-container">
                            {{#each system.details.traits.dr.value as |id|}}
                            <span class="trait-pill resistance">{{localize (lookup @root.config.damageTypes id)}}
                                <i class="fas fa-times" data-action="removeTrait" data-trait="dr"
                                    data-value="{{id}}"></i>
                            </span>
                            {{/each}}
                        </div>

                        <h3 class="block-title">{{localize 'THE-CODEX.Sheet.ConditionImmunities'}} <a
                                data-action="openTraitSelector" data-trait="ci"><i class="fas fa-plus"></i></a></h3>
                        <div class="pill-container">
                            {{#each system.details.traits.ci.value as |id|}}
                            <span class="trait-pill condition">{{localize (lookup @root.config.conditions id)}}
                                <i class="fas fa-times" data-action="removeTrait" data-trait="ci"
                                    data-value="{{id}}"></i>
                            </span>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>

            {{!-- ABA AÇÕES --}}
            <div class="tab actions {{#if tabs.actions.active}}active{{/if}}" data-group="primary" data-tab="actions">
                <div class="items-list-v13 high-density">
                    <div class="list-header">
                        <span class="col-img"></span>
                        <span class="col-name">{{localize 'THE-CODEX.NPC.Actions'}}</span>
                        <span class="col-stat">{{localize 'THE-CODEX.Combat.Attack'}}</span>
                        <span class="col-stat">{{localize 'THE-CODEX.NPC.Speed'}}</span>
                        <span class="col-stat">{{localize 'THE-CODEX.Combat.Damage'}}</span>
                        <span class="col-ctrl"><a data-action="createItem" data-type="weapon"
                                title="{{localize 'THE-CODEX.Sheet.New'}}"><i class="fas fa-plus"></i></a></span>
                    </div>
                    {{#each actions}}
                    <div class="item-row-v13" data-item-id="{{this.id}}" draggable="true">
                        <img class="mini-icon {{#if (or (gt this.system.activation.value 0) (or this.system.damage.formula this.system.uses.max))}}rollable{{/if}}"
                            src="{{this.img}}" {{#if (or (gt this.system.activation.value 0) (or
                            this.system.damage.formula this.system.uses.max))}}data-action="rollItem" {{/if}} />
                        <div class="name-desc-group">
                            <span
                                class="name {{#if (or (gt this.system.activation.value 0) (or this.system.damage.formula this.system.uses.max))}}clickable{{/if}}"
                                {{#if (or (gt this.system.activation.value 0) (or this.system.damage.formula
                                this.system.uses.max))}}data-action="rollItem" {{/if}}
                                data-tooltip="{{this.uuid}}">{{this.name}}</span>
                            {{#if this.cleanDescription}}<span
                                class="description-hint">{{this.cleanDescription}}</span>{{/if}}
                        </div>
                        <span class="stat-val"
                            data-tooltip="{{localize 'THE-CODEX.Combat.Attack'}}">{{this.displayHit}}</span>
                        <span class="stat-val"
                            data-tooltip="{{localize 'THE-CODEX.NPC.Speed'}}">{{this.displayRange}}</span>
                        <span class="stat-val"
                            data-tooltip="{{localize 'THE-CODEX.Combat.Damage'}}">{{this.displayDmg}}</span>
                        <div class="item-controls">
                            <a data-action="openItem" data-tooltip="{{localize 'THE-CODEX.UI.Edit'}}"><i
                                    class="fas fa-edit"></i></a>
                            <a data-action="deleteItem" data-tooltip="{{localize 'THE-CODEX.UI.Delete'}}"><i
                                    class="fas fa-trash"></i></a>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>

            {{!-- ABA TRAÇOS --}}
            <div class="tab traits {{#if tabs.traits.active}}active{{/if}}" data-group="primary" data-tab="traits">
                <div class="items-list-v13 high-density">
                    <div class="list-header">
                        <span class="col-img"></span>
                        <span class="col-name">{{localize 'THE-CODEX.NPC.Traits'}}</span>
                        <span class="col-ctrl">
                            <a data-action="createItem" data-type="feature"
                                data-tooltip="{{localize 'THE-CODEX.Sheet.New'}} ({{localize 'THE-CODEX.Sheet.Feature'}})"><i
                                    class="fas fa-plus"></i></a>
                        </span>
                    </div>
                    {{#each traits}}
                    <div class="item-row-v13" data-item-id="{{this.id}}" draggable="true">
                        <img class="mini-icon" src="{{this.img}}" />
                        <span class="name" data-tooltip="{{this.uuid}}">{{this.name}}</span>
                        <div class="item-controls">
                            <a data-action="deleteItem"><i class="fas fa-trash"></i></a>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>

            {{!-- ABA INVENTÁRIO --}}
            <div class="tab inventory {{#if tabs.inventory.active}}active{{/if}}" data-group="primary"
                data-tab="inventory">
                <div class="items-list-v13 high-density">
                    <div class="list-header">
                        <span class="col-img"></span>
                        <span class="col-name">{{localize 'THE-CODEX.Sheet.Inventory'}}</span>
                        <span class="col-stat">{{localize 'THE-CODEX.Advancement.Fields.Type'}}</span>
                        <span class="col-stat">{{localize 'THE-CODEX.UI.Quantity'}}</span>
                        <span class="col-ctrl">
                            <a data-action="createItem" data-type="weapon"
                                title="{{localize 'THE-CODEX.Sheet.Weapon'}}"><i class="fas fa-sword"></i></a>
                            <a data-action="createItem" data-type="armor"
                                title="{{localize 'THE-CODEX.Sheet.Armor'}}"><i class="fas fa-shield-alt"></i></a>
                            <a data-action="createItem" data-type="item"
                                title="{{localize 'THE-CODEX.Sheet.Inventory'}}"><i class="fas fa-box"></i></a>
                        </span>
                    </div>
                    {{#each inventory as |item|}}
                    <div class="item-row-v13 {{#if item.system.equipped}}equipped{{/if}}" data-item-id="{{item.id}}"
                        draggable="true">
                        <img class="mini-icon" src="{{item.img}}" data-action="openItem" />
                        <span class="name clickable" data-action="openItem"
                            data-tooltip="{{item.uuid}}">{{item.name}}</span>
                        <span class="stat-val">{{item.type}}</span>
                        <span class="stat-val">{{item.system.quantity}}</span>
                        <div class="item-controls">
                            {{#if (or (gt item.system.activation.value 0) (or item.system.damage.formula
                            item.system.uses.max))}}
                            <a data-action="rollItem" data-tooltip="{{localize 'THE-CODEX.Combat.Roll'}}"><i
                                    class="fas fa-dice-d20"></i></a>
                            {{/if}}
                            {{#if (or (eq item.type 'weapon') (eq item.type 'armor'))}}
                            <a data-action="toggleEquip" data-tooltip="{{localize 'THE-CODEX.UI.ToggleEquip'}}">
                                <i class="fas {{#if item.system.equipped}}fa-shield-check{{else}}fa-shield{{/if}}"></i>
                            </a>
                            {{/if}}
                            <a data-action="openItem" data-tooltip="{{localize 'THE-CODEX.UI.Edit'}}"><i
                                    class="fas fa-edit"></i></a>
                            <a data-action="deleteItem" data-tooltip="{{localize 'THE-CODEX.UI.Delete'}}"><i
                                    class="fas fa-trash"></i></a>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>

            {{!-- ABA GRIMÓRIO (ORGANIZADA POR CÍRCULOS) --}}
            <div class="tab spells {{#if tabs.spells.active}}active{{/if}}" data-group="primary" data-tab="spells">
                <div class="spellcasting-config-v13">
                    <div class="form-group">
                        <label>{{localize "THE-CODEX.Sheet.SpellcastingAbility"}}</label>
                        <select name="system.details.spellcastingAbility">
                            {{selectOptions config.abilities selected=system.details.spellcastingAbility localize=true}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>CD da Magia</label>
                        <span class="spell-dc-display"
                            title="{{system.details.spellDCBreakdown}}">{{system.details.spellSaveDC}}</span>
                        <input type="number" name="system.details.spellDCBonus" value="{{system.details.spellDCBonus}}"
                            placeholder="+0" title="Bônus de CD" />
                    </div>
                </div>
                {{#each spellCircles as |group|}}
                <div class="spell-circle-v13">
                    <div class="circle-header-v13">
                        {{group.label}}
                        <a data-action="createItem" data-type="spell" data-level="{{group.level}}"
                            data-tooltip="{{localize 'THE-CODEX.Sheet.New'}} ({{localize 'THE-CODEX.Sheet.Spell'}})"><i
                                class="fas fa-plus"></i></a>
                    </div>
                    <div class="spell-tags-v13">
                        {{#each group.spells}}
                        <div class="spell-tag-v13" data-item-id="{{this.id}}" draggable="true">
                            <img class="mini-icon" src="{{this.img}}" data-action="rollItem" />
                            <span class="name clickable" data-action="rollItem"
                                data-tooltip="{{this.uuid}}">{{this.name}}</span>
                            <i class="fas fa-edit edit" data-action="openItem"
                                data-tooltip="{{localize 'THE-CODEX.UI.Edit'}}"></i>
                            <i class="fas fa-trash delete" data-action="deleteItem"
                                data-tooltip="{{localize 'THE-CODEX.UI.Delete'}}"></i>
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/each}}
            </div>

            <div class="tab biography {{#if tabs.biography.active}}active{{/if}}" data-group="primary"
                data-tab="biography">
                <div class="editor-container-v13">
                    <prose-mirror name="system.details.biography" data-document-u-u-i-d="{{actor.uuid}}"
                        value="{{system.details.biography}}" toggled="true" collaborate="true" button="true">
                        {{{enrichedBiography}}}
                    </prose-mirror>
                </div>
            </div>

        </section>
    </main>
</div>