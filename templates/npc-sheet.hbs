<div class="sdrn-root sdrn-npc-root">

  <!-- Dock Lateral de Abas (Glued to window right edge via attachSideTabs) -->
  <nav class="sdrn-side-tabs sdrn-npc-side-tabs">
    <button type="button" class="sdrn-tab-btn active" data-action="tab" data-tab="actions" title="{{_npcTabActions}}" aria-label="{{_npcTabActions}}">
      <i class="fas fa-list-ul"></i>
    </button>
    <button type="button" class="sdrn-tab-btn" data-action="tab" data-tab="spells" title="{{_npcTabSpells}}" aria-label="{{_npcTabSpells}}">
      <i class="fas fa-wand-sparkles"></i>
    </button>
    <button type="button" class="sdrn-tab-btn" data-action="tab" data-tab="inventory" title="{{_npcTabInventory}}" aria-label="{{_npcTabInventory}}">
      <i class="fas fa-briefcase"></i>
    </button>
    <button type="button" class="sdrn-tab-btn" data-action="tab" data-tab="effects" title="Active Effects &amp; Conditions" aria-label="Active Effects &amp; Conditions">
      <i class="fas fa-hat-wizard"></i>
    </button>
    <button type="button" class="sdrn-tab-btn" data-action="tab" data-tab="details" title="{{_npcTabDetails}}" aria-label="{{_npcTabDetails}}">
      <i class="fas fa-scroll"></i>
    </button>
    <button type="button" class="sdrn-tab-btn" data-action="tab" data-tab="config" title="{{_npcTabConfig}}" aria-label="{{_npcTabConfig}}">
      <i class="fas fa-cog"></i>
    </button>
  </nav>

  <div class="sdrn-body sdrn-npc-body">

    <!-- ════════════════════════════════════════════════════════════════════════
         DIV 1: PARTE DE CIMA (FIXA — NUNCA DÁ SCROLL!)
         CONTÉM QUADRANTE 1 (ESQUERDA) E QUADRANTE 2 (DIREITA)
         ════════════════════════════════════════════════════════════════════════ -->
    <div class="sdrn-top-half">

      <!-- QUADRANTE 1: RETRATO CIRCULAR HERO + HP (ESQUERDA, 215px) -->
      <div class="sdrn-quadrant-1">

        <!-- Barra superior do Q1: Cadeado no canto esquerdo + Fonte da foto em Edição -->
        <div class="sdrn-q1-top-bar">
          <button type="button" class="sdrn-mode-toggle sdrn-mode-toggle-mini" data-action="toggle-edit-mode" aria-pressed="false" title="Modo Jogo / Edição">
            <i class="fas fa-lock" aria-hidden="true"></i>
          </button>
          <div class="sdrn-portrait-source" data-edit-only role="group" aria-label="Imagem do retrato">
            <button type="button" data-action="portrait-source" data-value="art" aria-pressed="{{#if _portraitSourceIsArt}}true{{else}}false{{/if}}">Arte</button>
            <button type="button" data-action="portrait-source" data-value="token" aria-pressed="{{#if _portraitSourceIsToken}}true{{else}}false{{/if}}">Token</button>
          </div>
        </div>

        <div class="sdrn-portrait-wrapper">
          <div class="sdrn-npc-portrait-ring">
            <button type="button" class="sdrn-npc-portrait-btn" data-action="pick-portrait" title="Alterar retrato">
              {{#if _portraitUrl}}
              <img src="{{_portraitUrl}}" alt="{{name}}" class="sdrn-npc-portrait-img" />
              {{else}}
              <div class="sdrn-npc-portrait-placeholder"><i class="fas fa-dragon"></i></div>
              {{/if}}
              <span class="sdrn-portrait-edit-overlay"><i class="fas fa-camera"></i></span>
            </button>
          </div>

          <!-- D20 Badge de Iniciativa no Topo Direito -->
          <button type="button" class="sdrn-npc-d20-badge" data-action="roll-initiative" title="Rolar Iniciativa ({{_initiative}})">
            <i class="fas fa-dice-d20 sdrn-d20-icon"></i>
            <span class="sdrn-d20-val">{{_initiative}}</span>
          </button>

          <!-- Escudo de CA no Canto Inferior Esquerdo -->
          <div class="sdrn-npc-ac-shield" title="Armor Class (Base: {{_acBase}} &bull; Total: {{_ac}})">
            <svg class="sdrn-ac-shield-svg" viewBox="0 0 36 42">
              <path d="M18,1 L34,7 C34,26 24,38 18,41 C12,38 2,26 2,7 Z" fill="#14120f" stroke="#c99738" stroke-width="2.5" />
            </svg>
            <div class="sdrn-ac-shield-content">
              <span class="sdrn-ac-shield-lbl">AC</span>
              <input class="sdrn-ac-shield-num" type="number" name="sd:attributes.da.base" value="{{_acBase}}" title="Base AC" />
            </div>
          </div>
        </div>

        <!-- Módulo de HP logo abaixo do retrato (Fluxo Normal) -->
        <div class="sdrn-hp-block">
          <div class="sdrn-dark-bar sdrn-hp-bar">
            <div class="sdrn-dark-bar-fill sdrn-hp-fill" style="width:{{_health.pct}}%"></div>
            <div class="sdrn-dark-bar-text sdrn-hp-bar-text">
              <span class="sdrn-bar-lbl">HP</span>
              <input class="sdrn-bar-input sdrn-hp-cur" type="number" name="sd:resources.health.value" value="{{_health.value}}" title="Current HP" />
              <span class="sdrn-bar-sep">/</span>
              <input class="sdrn-bar-input sdrn-hp-max" type="number" name="sd:resources.health.max" value="{{_health.max}}" title="Max HP" />
            </div>
          </div>

          <!-- Controles rápidos de Curar e Dano -->
          <div class="sdrn-quick-hp">
            <input type="number" min="0" data-quick-hp data-always-on aria-label="Valor" placeholder="0" />
            <button type="button" data-action="hp-heal" title="Curar">Curar</button>
            <button type="button" data-action="hp-damage" title="Dano">Dano</button>
          </div>
        </div>
      </div>

      <!-- QUADRANTE 2: NOME, CR, XP E ATRIBUTOS (DIREITA, 1fr) -->
      <div class="sdrn-quadrant-2">
        <!-- Linha 1: Título e Top Cluster -->
        <div class="sdrn-npc-title-row">
          <input type="text" class="sdrn-npc-name-input" name="name" value="{{name}}" placeholder="Non-Player Character" />

          <div class="sdrn-npc-top-cluster">
            <div class="sdrn-rest-btns">
              <button type="button" class="sdrn-rest-btn" data-action="short-rest" title="Descanso Curto"><i class="fas fa-utensils"></i></button>
              <button type="button" class="sdrn-rest-btn" data-action="long-rest" title="Descanso Longo"><i class="fas fa-campground"></i></button>
            </div>

            <!-- XP Editável -->
            <label class="sdrn-npc-xp-badge" title="Experience Points">
              <span class="sdrn-xp-lbl">XP</span>
              <input type="number" class="sdrn-xp-input" name="sd:details.xp.value" value="{{_xpValue}}" min="0" placeholder="0" />
            </label>

            <!-- Proficiency Editável -->
            <label class="sdrn-npc-prof-badge" title="Proficiency Bonus">
              <span class="sdrn-prof-lbl">PROF</span>
              <input type="number" class="sdrn-prof-input" name="sd:attributes.prof.value" value="{{_prof}}" min="0" placeholder="2" />
            </label>

            <!-- Medalhão de Desafio (CR Editável) -->
            <div class="sdrn-npc-cr-medallion" title="Challenge Rating (CR)">
              <span class="sdrn-cr-lbl">CR</span>
              <input type="text" class="sdrn-cr-input" name="sd:details.cr" value="{{_cr}}" title="CR" placeholder="1" />
            </div>
          </div>
        </div>

        <!-- Linha 2: Metadados (Tamanho, Tipo, Alinhamento) -->
        <div class="sdrn-npc-meta-row">
          <select class="sdrn-npc-size-select" name="sd:details.size" title="Size">
            {{#each _sizeOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
          <input class="sdrn-npc-meta-field" type="text" name="sd:details.type" value="{{_type}}" placeholder="Type" title="Creature Type" />
          <input class="sdrn-npc-meta-field" type="text" name="sd:details.alignment" value="{{_alignment}}" placeholder="Alignment" title="Alignment" />
        </div>

        <!-- Linha 3: Ribbon dos 6 Atributos D&D com Salvaguardas -->
        <div class="sdrn-npc-abilities-ribbon">
          {{#each _abilities}}
          <div class="sdrn-ability-pill-card" title="{{label}}">
            <div class="sdrn-ability-pill-abbr">{{abbr}}</div>
            <button type="button" class="sdrn-ability-pill-mod" data-action="roll-ability" data-key="{{key}}" data-mode="test" title="Rolar {{label}} ({{mod}})">{{mod}}</button>
            <div class="sdrn-ability-pill-score-wrap">
              <input class="sdrn-ability-pill-score" type="number" name="sd:abilities.{{key}}.value" value="{{score}}" min="1" max="30" title="{{label}} Score" />
            </div>
            <button type="button" class="sdrn-save-shield {{#if saveProficient}}is-prof{{/if}}" data-action="toggle-save-prof" data-key="{{key}}" aria-pressed="{{#if saveProficient}}true{{else}}false{{/if}}" title="Salvaguarda de {{label}} ({{saveTotal}})">
              <span class="sdrn-save-disc" role="img"></span>
              <span class="sdrn-save-val">{{saveTotal}}</span>
              <i class="fas fa-shield-alt" aria-hidden="true"></i>
            </button>
          </div>
          {{/each}}
        </div>

        <!-- Linha 4: Cartão de Resumo da Criatura -->
        <div class="sdrn-npc-summary-card">
          <div class="sdrn-summary-badges">
            <span class="sdrn-summary-icon"><i class="fas fa-dragon"></i></span>
            <span class="sdrn-summary-text"><b>{{#if _type}}{{_type}}{{else}}Creature{{/if}}</b> {{#if _subtype}}({{_subtype}}){{/if}}</span>
          </div>
          <span class="sdrn-summary-cr-pill">CR {{_cr}}</span>
        </div>
      </div>

    </div>

    <!-- ════════════════════════════════════════════════════════════════════════
         DIV 2: PARTE DE BAIXO (ROLÁVEL)
         CONTÉM QUADRANTE 3 (ESQUERDA) E QUADRANTE 4 (DIREITA)
         ════════════════════════════════════════════════════════════════════════ -->
    <div class="sdrn-bottom-half">

      <!-- QUADRANTE 3: CHIPS COMPACTOS (ESQUERDA, 215px) -->
      <div class="sdrn-quadrant-3">

        <!-- Speed -->
        <div class="sdrn-compact-chip-row">
          <span class="sdrn-chip-label"><i class="fas fa-running"></i> SPEED</span>
          <span class="sdrn-chip-val">{{_speed}}</span>
        </div>

        <!-- Skills -->
        <div class="sdrn-compact-section">
          <div class="sdrn-compact-section-hdr">
            <span class="sdrn-stat-subhead"><i class="fas fa-graduation-cap"></i> SKILLS</span>
            {{#if _availableSkills.length}}
            <select class="sdrn-npc-quick-select" data-action="add-skill-prof" data-edit-only title="Adicionar Perícia">
              <option value="">+ Skill</option>
              {{#each _availableSkills}}
              <option value="{{key}}">{{label}}</option>
              {{/each}}
            </select>
            {{/if}}
          </div>
          <div class="sdrn-chips-wrap">
            {{#each _skills}}
            {{#if proficient}}
            <button type="button" class="sdrn-compact-chip skill" data-action="roll-skill" data-key="{{key}}" title="Rolar {{label}} ({{total}})">
              <span>{{label}}</span>
              <b>{{total}}</b>
            </button>
            {{/if}}
            {{else}}
            <span class="sdrn-empty-chip">Nenhuma perícia</span>
            {{/each}}
          </div>
        </div>

        <!-- Senses (3 Selos Passivos + Especiais) -->
        <div class="sdrn-compact-section">
          <div class="sdrn-compact-section-hdr">
            <span class="sdrn-stat-subhead"><i class="fas fa-eye"></i> SENSES</span>
            {{#if _availableSensesList.length}}
            <select class="sdrn-npc-quick-select" data-action="add-sense" data-edit-only title="Adicionar Sentido">
              <option value="">+ Sense</option>
              {{#each _availableSensesList}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
            {{/if}}
          </div>
          <div class="sdrn-passive-seals">
            <div class="sdrn-passive-seal"><span class="sdrn-passive-val">{{_passivePerception}}</span><span class="sdrn-passive-lbl">Percepção</span></div>
            <div class="sdrn-passive-seal"><span class="sdrn-passive-val">{{_passiveInvestigation}}</span><span class="sdrn-passive-lbl">Investigação</span></div>
            <div class="sdrn-passive-seal"><span class="sdrn-passive-val">{{_passiveInsight}}</span><span class="sdrn-passive-lbl">Intuição</span></div>
          </div>
          <div class="sdrn-chips-wrap">
            {{#each _senses}}
            <span class="sdrn-compact-chip sense">
              <span>{{this}}</span>
              <button type="button" class="sdrn-tag-del-btn" data-action="remove-sense" data-value="{{this}}" data-edit-only title="Remover">&times;</button>
            </span>
            {{/each}}
          </div>
        </div>

        <!-- Resistances & Immunities -->
        <div class="sdrn-compact-section">
          <div class="sdrn-compact-section-hdr">
            <span class="sdrn-stat-subhead"><i class="fas fa-shield-virus"></i> RESISTANCES</span>
            {{#if _traitOptions.length}}
            <select class="sdrn-npc-quick-select" data-action="add-trait" data-edit-only title="Adicionar Resistência/Imunidade">
              <option value="">+ Trait</option>
              {{#each _traitOptions}}
              <option value="{{value}}">{{label}}</option>
              {{/each}}
            </select>
            {{/if}}
          </div>
          <div class="sdrn-chips-wrap">
            {{#each _traitItems}}
            <span class="sdrn-compact-chip trait {{cssClass}}" title="{{typeLabel}}: {{label}}">
              <small>{{type}}</small>
              <span>{{label}}</span>
              <button type="button" class="sdrn-tag-del-btn" data-action="remove-trait" data-trait-type="{{type}}" data-value="{{value}}" data-edit-only title="Remover">&times;</button>
            </span>
            {{else}}
            <span class="sdrn-empty-chip">&mdash;</span>
            {{/each}}
          </div>
        </div>

        <!-- Gear -->
        <div class="sdrn-compact-section">
          <div class="sdrn-compact-section-hdr">
            <span class="sdrn-stat-subhead"><i class="fas fa-shield-alt"></i> GEAR</span>
          </div>
          <div class="sdrn-chips-wrap">
            {{#each _gearChips}}
            <span class="sdrn-compact-chip gear">{{this}}</span>
            {{else}}
            <span class="sdrn-empty-chip">&mdash;</span>
            {{/each}}
          </div>
        </div>

        <!-- Languages -->
        <div class="sdrn-compact-section" data-edit-only>
          <div class="sdrn-compact-section-hdr">
            <span class="sdrn-stat-subhead"><i class="fas fa-comment-dots"></i> LANGUAGES</span>
            {{#if _availableLanguagesList.length}}
            <select class="sdrn-npc-quick-select" data-action="add-language" title="Adicionar Idioma">
              <option value="">+ Lang</option>
              {{#each _availableLanguagesList}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
            {{/if}}
          </div>
          <div class="sdrn-chips-wrap">
            {{#each _languages}}
            <span class="sdrn-compact-chip lang">
              <span>{{name}}</span>
              <button type="button" class="sdrn-tag-del-btn" data-action="remove-language" data-id="{{id}}" data-name="{{name}}" title="Remover">&times;</button>
            </span>
            {{else}}
            <span class="sdrn-empty-chip">&mdash;</span>
            {{/each}}
          </div>
        </div>

      </div>

      <!-- QUADRANTE 4: CONTEÚDO PRINCIPAL (DIREITA, 1fr, SCROLLA) -->
      <div class="sdrn-quadrant-4">

        <!-- ABA 1: FEATURES & ACTIONS -->
        <div data-tab-content="actions" class="sdrn-tab-panel">

          <!-- Barra de Busca -->
          <div class="sdrn-search-bar">
            <i class="fas fa-search sdrn-search-icon"></i>
            <input type="text" placeholder="Search features, actions, attacks..." class="sdrn-search-input" data-always-on />
            <button type="button" class="sdrn-search-action-btn" title="Limpar"><i class="fas fa-times"></i></button>
            <button type="button" class="sdrn-search-action-btn" title="Filtrar"><i class="fas fa-filter"></i></button>
            <button type="button" class="sdrn-search-action-btn" title="Ordenar"><i class="fas fa-sort-amount-down"></i></button>
          </div>

          <!-- Tabela 1: Features -->
          <div class="sdrn-features-table">
            <div class="sdrn-features-header">
              <span class="col-name">Features</span>
              <span class="col-uses">USES</span>
              <span class="col-roll">ROLL</span>
              <span class="col-formula">FORMULA</span>
              <span class="col-actions">ACTIONS</span>
            </div>

            <div class="sdrn-features-body">
              {{#each _featuresList}}
              <div class="sdrn-feature-row">
                <div class="col-name">
                  <div class="sdrn-feature-icon-thumb">
                    {{#if imgUrl}}
                    <img src="{{imgUrl}}" alt="" />
                    {{else}}
                    <span class="sdrn-feature-icon-fallback">{{icon}}</span>
                    {{/if}}
                  </div>
                  <div class="sdrn-feature-titles">
                    <button type="button" class="sdrn-feature-title-btn" data-action="open-item" data-id="{{id}}" title="Abrir">{{name}}</button>
                    <span class="sdrn-feature-type-sub">{{subtitle}}</span>
                  </div>
                </div>

                <div class="col-uses">{{usesText}}</div>
                <div class="col-roll">{{rollText}}</div>
                <div class="col-formula">{{formulaText}}</div>

                <div class="col-actions">
                  <button type="button" class="sdrn-icon-ctrl-btn" data-action="post-action-chat" data-id="{{id}}" title="Chat"><i class="fas fa-comment-alt"></i></button>
                  <button type="button" class="sdrn-icon-ctrl-btn del" data-action="delete-item" data-id="{{id}}" data-edit-only title="Excluir"><i class="fas fa-trash-alt"></i></button>
                </div>
              </div>
              {{else}}
              <div class="sdrn-empty-row">Nenhuma característica adicionada ainda.</div>
              {{/each}}
            </div>
          </div>

          <!-- Tabela 2: Actions & Attacks -->
          <div class="sdrn-features-table" style="margin-top: 14px;">
            <div class="sdrn-features-header actions">
              <span class="col-name">Actions</span>
              <span class="col-uses">USES</span>
              <span class="col-roll">ROLL</span>
              <span class="col-formula">FORMULA</span>
              <span class="col-actions">ACTIONS</span>
            </div>

            <div class="sdrn-features-body">
              {{#each _attacksList}}
              <div class="sdrn-feature-row">
                <div class="col-name">
                  <div class="sdrn-feature-icon-thumb">
                    {{#if imgUrl}}
                    <img src="{{imgUrl}}" alt="" />
                    {{else}}
                    <span class="sdrn-feature-icon-fallback">{{icon}}</span>
                    {{/if}}
                  </div>
                  <div class="sdrn-feature-titles">
                    <button type="button" class="sdrn-feature-title-btn" data-action="open-item" data-id="{{id}}" title="Abrir">{{name}}</button>
                    <span class="sdrn-feature-type-sub">{{subtitle}}</span>
                  </div>
                </div>

                <div class="col-uses">{{usesText}}</div>

                <div class="col-roll">
                  <button type="button" class="sdrn-table-action-btn atk" data-action="roll-attack" data-id="{{id}}" title="Ataque">
                    <i class="fas fa-dice-d20"></i> {{rollText}}
                  </button>
                </div>

                <div class="col-formula">
                  {{#if hasDamage}}
                  <button type="button" class="sdrn-table-action-btn dmg" data-action="roll-damage" data-id="{{id}}" title="Dano">
                    <i class="fas fa-tint"></i> {{formulaText}}
                  </button>
                  {{else}}
                  <span>&mdash;</span>
                  {{/if}}
                </div>

                <div class="col-actions">
                  <button type="button" class="sdrn-icon-ctrl-btn" data-action="post-action-chat" data-id="{{id}}" title="Chat"><i class="fas fa-comment-alt"></i></button>
                  <button type="button" class="sdrn-icon-ctrl-btn del" data-action="delete-item" data-id="{{id}}" data-edit-only title="Excluir"><i class="fas fa-trash-alt"></i></button>
                </div>
              </div>
              {{else}}
              <div class="sdrn-empty-row">Nenhuma ação cadastrada.</div>
              {{/each}}
            </div>
          </div>

          <!-- Botões de Adição Rápida -->
          <div class="sdrn-add-actions-footer">
            <button type="button" class="sdrn-quick-add-btn" data-action="create-item" data-item-type="feature"><i class="fas fa-plus"></i> Add Feature</button>
            <button type="button" class="sdrn-quick-add-btn" data-action="create-item" data-item-type="weapon"><i class="fas fa-plus"></i> Add Attack</button>
            <button type="button" class="sdrn-quick-add-btn" data-action="create-item" data-item-type="spell"><i class="fas fa-plus"></i> Add Spell</button>
          </div>

        </div>

        <!-- ABA 2: SPELLS (MAGIAS) -->
        <div data-tab-content="spells" class="sdrn-tab-panel" style="display:none;">
          <div class="sdrn-features-table">
            <div class="sdrn-features-header">
              <span class="col-name">Spells</span>
              <span class="col-uses">SLOTS</span>
              <span class="col-roll">CAST</span>
              <span class="col-formula">EFFECT</span>
              <span class="col-actions">ACTIONS</span>
            </div>
            <div class="sdrn-features-body">
              {{#each _spellsList}}
              <div class="sdrn-feature-row">
                <div class="col-name">
                  <div class="sdrn-feature-icon-thumb">
                    {{#if imgUrl}}<img src="{{imgUrl}}" alt="" />{{else}}<span class="sdrn-feature-icon-fallback">✨</span>{{/if}}
                  </div>
                  <div class="sdrn-feature-titles">
                    <button type="button" class="sdrn-feature-title-btn" data-action="open-item" data-id="{{id}}">{{name}}</button>
                    <span class="sdrn-feature-type-sub">{{subtitle}}</span>
                  </div>
                </div>
                <div class="col-uses">{{usesText}}</div>
                <div class="col-roll">
                  <button type="button" class="sdrn-table-action-btn atk" data-action="post-action-chat" data-id="{{id}}"><i class="fas fa-magic"></i> Cast</button>
                </div>
                <div class="col-formula">{{formulaText}}</div>
                <div class="col-actions">
                  <button type="button" class="sdrn-icon-ctrl-btn del" data-action="delete-item" data-id="{{id}}" data-edit-only title="Excluir"><i class="fas fa-trash-alt"></i></button>
                </div>
              </div>
              {{else}}
              <div class="sdrn-empty-row">Nenhuma magia adicionada.</div>
              {{/each}}
            </div>
          </div>
          <div class="sdrn-add-actions-footer">
            <button type="button" class="sdrn-quick-add-btn" data-action="create-item" data-item-type="spell"><i class="fas fa-plus"></i> Add Spell</button>
          </div>
        </div>

        <!-- ABA 3: INVENTORY (EQUIPAMENTO) -->
        <div data-tab-content="inventory" class="sdrn-tab-panel" style="display:none;">
          <div class="sdrn-features-table">
            <div class="sdrn-features-header">
              <span class="col-name">Inventory</span>
              <span class="col-uses">QTY</span>
              <span class="col-roll">WT</span>
              <span class="col-formula">PRICE</span>
              <span class="col-actions">ACTIONS</span>
            </div>
            <div class="sdrn-features-body">
              {{#each _inventoryList}}
              <div class="sdrn-feature-row">
                <div class="col-name">
                  <div class="sdrn-feature-icon-thumb">
                    {{#if imgUrl}}<img src="{{imgUrl}}" alt="" />{{else}}<span class="sdrn-feature-icon-fallback">🎒</span>{{/if}}
                  </div>
                  <div class="sdrn-feature-titles">
                    <button type="button" class="sdrn-feature-title-btn" data-action="open-item" data-id="{{id}}">{{name}}</button>
                    <span class="sdrn-feature-type-sub">{{type}}</span>
                  </div>
                </div>
                <div class="col-uses">1</div>
                <div class="col-roll">&mdash;</div>
                <div class="col-formula">&mdash;</div>
                <div class="col-actions">
                  <button type="button" class="sdrn-icon-ctrl-btn del" data-action="delete-item" data-id="{{id}}" data-edit-only title="Excluir"><i class="fas fa-trash-alt"></i></button>
                </div>
              </div>
              {{else}}
              <div class="sdrn-empty-row">Nenhum equipamento adicionado.</div>
              {{/each}}
            </div>
          </div>
          <div class="sdrn-add-actions-footer">
            <button type="button" class="sdrn-quick-add-btn" data-action="create-item" data-item-type="item"><i class="fas fa-plus"></i> Add Item</button>
          </div>
        </div>

        <!-- ABA 4: ACTIVE EFFECTS & CONDITIONS -->
        <div data-tab-content="effects" class="sdrn-tab-panel sdrn-effects-tab-panel" style="display:none;">
          <!-- Seção 1: Condições de Status (D&D 5e Conditions Palette) -->
          <div class="sdrn-effects-section">
            <div class="sdrn-effects-section-hdr">
              <div class="sdrn-section-title">
                <i class="fas fa-shield-virus"></i>
                <span>Condições de Status (D&D 5e)</span>
              </div>
              <span class="sdrn-section-hint">Clique em qualquer condição para aplicar ou remover</span>
            </div>

            <!-- Chips de Condições Atualmente Ativas -->
            {{#if _activeConditions.length}}
            <div class="sdrn-active-conditions-strip">
              <span class="sdrn-active-strip-label">Ativas:</span>
              {{#each _activeConditions}}
              <button type="button" class="sdrn-active-condition-tag" data-action="toggle-condition" data-condition="{{id}}" title="Remover {{label}}">
                <i class="{{icon}}"></i>
                <span>{{label}}</span>
                <span class="sdrn-tag-remove">&times;</span>
              </button>
              {{/each}}
              <button type="button" class="sdrn-clear-conditions-btn" data-action="clear-conditions" title="Remover todas as condições">Limpar Todas</button>
            </div>
            {{/if}}

            <!-- Grid com Todas as Condições Disponíveis (Clique para alternar) -->
            <div class="sdrn-conditions-grid">
              {{#each _allConditions}}
              <button type="button" 
                      class="sdrn-condition-card {{#if active}}is-active{{/if}}" 
                      data-action="toggle-condition" 
                      data-condition="{{id}}" 
                      title="{{description}}">
                <div class="sdrn-cond-icon-wrap" style="color: {{color}};">
                  <i class="{{icon}}"></i>
                </div>
                <div class="sdrn-cond-info">
                  <span class="sdrn-cond-name">{{label}}</span>
                  <span class="sdrn-cond-status">{{#if active}}Ativo{{else}}Inativo{{/if}}</span>
                </div>
                {{#if active}}
                <span class="sdrn-cond-check"><i class="fas fa-check"></i></span>
                {{/if}}
              </button>
              {{/each}}
            </div>
          </div>

          <!-- Seção 2: Buffs & Efeitos Mágicos Ativos (Loom ActiveEffects) -->
          <div class="sdrn-effects-section" style="margin-top: 14px;">
            <div class="sdrn-effects-section-hdr">
              <div class="sdrn-section-title">
                <i class="fas fa-wand-magic-sparkles"></i>
                <span>Buffs &amp; Efeitos Mágicos Ativos</span>
              </div>
              <button type="button" class="sdrn-quick-add-btn" data-action="create-custom-effect" title="Criar Efeito Personalizado">
                <i class="fas fa-plus"></i> Novo Efeito
              </button>
            </div>

            <!-- Presets Rápidos de Magias Populares -->
            <div class="sdrn-buff-presets-strip">
              <span class="sdrn-presets-label"><i class="fas fa-bolt"></i> Aplicar Rápido:</span>
              {{#each _buffPresets}}
              <button type="button" class="sdrn-preset-btn" data-action="apply-buff-preset" data-preset-id="{{id}}" title="{{description}}">
                <i class="{{icon}}"></i> + {{name}}
              </button>
              {{/each}}
            </div>

            <!-- Lista de Efeitos Ativos Instalados no Ator -->
            <div class="sdrn-active-effects-list">
              {{#each _effects}}
              <div class="sdrn-effect-row {{#if disabled}}is-disabled{{/if}}">
                <div class="sdrn-effect-icon">
                  <i class="{{#if disabled}}fas fa-pause-circle{{else}}fas fa-magic{{/if}}"></i>
                </div>
                <div class="sdrn-effect-main">
                  <div class="sdrn-effect-header-line">
                    <span class="sdrn-effect-title">{{name}}</span>
                    <span class="sdrn-effect-duration-badge">{{durationLabel}}</span>
                  </div>
                  {{#if changesSummary}}
                  <div class="sdrn-effect-changes">{{changesSummary}}</div>
                  {{/if}}
                </div>
                <div class="sdrn-effect-actions">
                  <button type="button" class="sdrn-icon-ctrl-btn" data-action="toggle-effect-disabled" data-id="{{id}}" title="{{#if disabled}}Ativar Efeito{{else}}Pausar Efeito{{/if}}">
                    <i class="{{#if disabled}}fas fa-play{{else}}fas fa-pause{{/if}}"></i>
                  </button>
                  <button type="button" class="sdrn-icon-ctrl-btn del" data-action="delete-effect" data-id="{{id}}" title="Remover Efeito">
                    <i class="fas fa-trash-alt"></i>
                  </button>
                </div>
              </div>
              {{else}}
              <div class="sdrn-empty-row">Nenhum buff ou efeito mágico ativo no momento. Clique em um dos atalhos acima ou adicione um novo efeito.</div>
              {{/each}}
            </div>
          </div>
        </div>

        <!-- ABA 4: BIOGRAPHY & LORE -->
        <div data-tab-content="details" class="sdrn-tab-panel" style="display:none;">
          <div class="sdrn-card-block">
            <div class="sdrn-box-title"><i class="fas fa-feather-alt"></i> BIOGRAPHY &amp; MONSTER LORE</div>
            <textarea name="sd:details.biography" class="sdrn-dark-textarea" rows="12" placeholder="Ecology, tactics, description...">{{_biography}}</textarea>
          </div>
        </div>

        <!-- ABA 5: CONFIGURAÇÕES -->
        <div data-tab-content="config" class="sdrn-tab-panel" style="display:none;">
          <div class="sdrn-card-block">
            <div class="sdrn-box-title"><i class="fas fa-sliders-h"></i> CONFIGURATION</div>
            <div class="sdrn-config-fields-grid">
              <label class="sdrn-cfg-row">
                <span>HP Formula</span>
                <input type="text" name="sd:attributes.hp.formula" value="{{_hpFormula}}" placeholder="e.g. 8d8+16" />
              </label>
              <label class="sdrn-cfg-row sdrn-cfg-checkbox-row" title="{{_deathSaveOverrideHint}}">
                <input type="checkbox" name="sd:details.useCharacterDeathSaves" {{#if _useCharacterDeathSaves}}checked{{/if}} />
                <span>{{_deathSaveOverrideLabel}}<small>{{_deathSaveOverrideHint}}</small></span>
              </label>
              <label class="sdrn-cfg-row">
                <span>Alignment</span>
                <input type="text" name="sd:details.alignment" value="{{_alignment}}" />
              </label>
              <label class="sdrn-cfg-row">
                <span>Source</span>
                <input type="text" name="sd:details.source" value="{{_source}}" placeholder="SRD 5.1" />
              </label>
              <label class="sdrn-cfg-row">
                <span>Legendary Actions</span>
                <input type="number" name="sd:details.legendaryActions" value="{{_legendaryActions}}" min="0" max="10" />
              </label>
              <label class="sdrn-cfg-row">
                <span>Legendary Resistances</span>
                <input type="number" name="sd:details.legendaryResistances" value="{{_legendaryResistances}}" min="0" max="10" />
              </label>
            </div>
          </div>
        </div>

        <!-- Botão Flutuante (+) -->
        <button type="button" class="sdrn-fab-add" data-action="create-item" data-item-type="feature" title="Adicionar">
          <i class="fas fa-plus"></i>
        </button>

      </div>

    </div>

  </div>

</div>
