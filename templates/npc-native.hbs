<div class="sdrn-root sdrn-npc-root">
  <div class="sdrn-body">

    <header class="sdrn-header sdrn-npc-header">
      <div class="sdrn-header-top">
        <div class="sdrn-identity">
          <input type="text" class="sdrn-name-input" name="name" value="{{name}}" placeholder="Creature Name" />
          <div class="sdrn-subtitle">{{_size}} &middot; {{_alignment}}</div>
        </div>
        <div class="sdrn-npc-cr">
          <div class="sdrn-npc-cr-num">CR {{_cr}}</div>
          <div class="sdrn-npc-cr-xp">{{_xpLabel}}</div>
        </div>
      </div>
    </header>

    <div class="sdrn-npc-topline">
      <input class="sdrn-ac-circle sdrn-npc-ac" type="number" name="sd:attributes.da.base" value="{{_acBase}}" title="Base Armor Class ({{_ac}} com bônus)" />
      <div class="sdrn-npc-hp">
        <div class="sdrn-hp-bar-embed">
          <button type="button" class="sdrn-hp-btn sdrn-hp-btn-minus" data-action="hp-delta" data-delta="-1" title="Apply 1 damage">&minus;</button>
          <div class="sdrn-hp-fill" style="width:{{_health.pct}}%"></div>
          <div class="sdrn-hp-text">
            <input class="sdrn-hp-input" type="number" name="sd:resources.health.value" value="{{_health.value}}" />
            <span>/</span>
            <input class="sdrn-hp-input" type="number" name="sd:resources.health.max" value="{{_health.max}}" />
          </div>
          <button type="button" class="sdrn-hp-btn sdrn-hp-btn-plus" data-action="hp-delta" data-delta="1" title="Heal 1">&plus;</button>
        </div>
      </div>
      <div class="sdrn-mini-stat-row sdrn-npc-mini-row">
        <button type="button" class="sdrn-mini-stat sdrn-mini-stat-btn" data-action="roll-initiative" title="Roll Initiative"><div class="sdrn-mini-stat-num">{{_initiative}}</div><div class="sdrn-mini-stat-label">Init</div></button>
        <div class="sdrn-mini-stat"><div class="sdrn-mini-stat-num">{{_speed}}</div><div class="sdrn-mini-stat-label">Walk</div></div>
        <div class="sdrn-mini-stat"><div class="sdrn-mini-stat-num">{{_prof}}</div><div class="sdrn-mini-stat-label">Prof</div></div>
      </div>
    </div>

    <div class="sdrn-header-abilities">
      {{#each _abilities}}
      <div class="sdrn-mini-ability">
        <button type="button" class="sdrn-mini-mod" data-action="roll-ability" data-key="{{key}}" data-mode="test" title="Roll {{label}}">{{mod}}</button>
        <span class="sdrn-mini-abbr">{{abbr}}</span>
        <input class="sdrn-mini-score" type="number" name="sd:abilities.{{key}}.value" value="{{score}}" min="1" max="30" />
      </div>
      {{/each}}
    </div>

    <div class="sdrn-npc-stat-grid">
      <div class="sdrn-box">
        <div class="sdrn-box-title">Saving Throws</div>
        <div class="sdrn-tag-list">
          {{#each _saves}}<button type="button" class="sdrn-tag sdrn-tag-toggle active" data-action="roll-save" data-key="{{key}}">{{label}} {{total}}</button>{{else}}<span class="sdrn-empty">&mdash;</span>{{/each}}
        </div>
      </div>
      <div class="sdrn-box">
        <div class="sdrn-box-title">Skills</div>
        <div class="sdrn-tag-list">
          {{#each _skills}}<button type="button" class="sdrn-tag sdrn-tag-toggle active" data-action="roll-skill" data-key="{{key}}">{{label}} {{total}}</button>{{else}}<span class="sdrn-empty">&mdash;</span>{{/each}}
        </div>
      </div>
      <div class="sdrn-box">
        <div class="sdrn-box-title">Senses</div>
        <div class="sdrn-tag-list">
          {{#each _senses}}<span class="sdrn-tag">{{this}}</span>{{/each}}
          {{#if _sensesCustom}}<span class="sdrn-tag">{{_sensesCustom}}</span>{{/if}}
          {{#unless _senses.length}}{{#unless _sensesCustom}}<span class="sdrn-empty">&mdash;</span>{{/unless}}{{/unless}}
          <span class="sdrn-tag">passive Perception {{_passivePerception}}</span>
        </div>
      </div>
      <div class="sdrn-box">
        <div class="sdrn-box-title">Languages</div>
        <div class="sdrn-tag-list">
          {{#each _languages}}<span class="sdrn-tag">{{this}}</span>{{/each}}
          {{#if _languagesCustom}}<span class="sdrn-tag">{{_languagesCustom}}</span>{{/if}}
          {{#unless _languages.length}}{{#unless _languagesCustom}}<span class="sdrn-empty">&mdash;</span>{{/unless}}{{/unless}}
        </div>
      </div>
      <div class="sdrn-box">
        <div class="sdrn-box-title">Resistances / Immunities</div>
        <div class="sdrn-tag-list">
          {{#each _traits.dr}}<span class="sdrn-tag">{{this}} (resist)</span>{{/each}}
          {{#each _traits.di}}<span class="sdrn-tag sdrn-tag-good">{{this}} (immune)</span>{{/each}}
          {{#each _traits.dv}}<span class="sdrn-tag">{{this}} (vuln.)</span>{{/each}}
          {{#unless _traits.dr.length}}{{#unless _traits.di.length}}{{#unless _traits.dv.length}}<span class="sdrn-empty">&mdash;</span>{{/unless}}{{/unless}}{{/unless}}
        </div>
      </div>
      {{#if _legendaryActions}}
      <div class="sdrn-box">
        <div class="sdrn-box-title">Legendary</div>
        <div class="sdrn-tag-list">
          <span class="sdrn-tag">{{_legendaryActions}} Actions/turn</span>
          {{#if _legendaryResistances}}<span class="sdrn-tag">{{_legendaryResistances}} Resistances/day</span>{{/if}}
        </div>
      </div>
      {{/if}}
    </div>

    <div class="sdrn-box sdrn-npc-actions-box">
      <div class="sdrn-box-title">⚔️ Actions</div>
      {{#each _actions}}
      <div class="sdrn-item-row">
        <span class="sdrn-item-icon">{{#if imgUrl}}<img src="{{imgUrl}}" alt="" />{{else}}{{icon}}{{/if}}</span>
        <button type="button" class="sdrn-item-name sdrn-item-name-btn" data-action="open-item" data-id="{{id}}">{{name}}</button>
        <button type="button" class="sdrn-item-roll-btn" data-action="post-action-chat" data-id="{{id}}" title="Post to Chat"><i class="fas fa-comment"></i></button>
        <button type="button" class="sdrn-item-roll-btn" data-action="roll-action-damage" data-id="{{id}}" title="Roll Damage"><i class="fas fa-burst"></i> Dmg</button>
        <button type="button" class="sdrn-item-del" data-action="delete-item" data-id="{{id}}" title="Delete">&times;</button>
      </div>
      {{else}}
      <div class="sdrn-empty-row">No actions yet.</div>
      {{/each}}
      <button type="button" class="sdrn-add-btn" data-action="create-item" data-item-type="feature">+ Add Action</button>
    </div>

    <div class="sdrn-box sdrn-npc-bio-box">
      <div class="sdrn-box-title">Biography</div>
      <textarea name="sd:details.biography" rows="4" placeholder="No description yet.">{{_biography}}</textarea>
    </div>

  </div>
</div>
